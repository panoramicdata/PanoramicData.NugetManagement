<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below pin a transitive dependency without adding an unused direct
         PackageReference. Kept so Refit.HttpClientFactory stays pinned to a version whose signature
         still verifies: 10.1.6 is signed with an author certificate that has since been revoked,
         which fails signature verification during CI restore. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Main project dependencies -->
    <PackageVersion Include="Codacy.Api" Version="4.0.27" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
    <PackageVersion Include="Ollama.Api" Version="1.0.30" />
    <PackageVersion Include="PanoramicData.Blazor" Version="10.0.423" />
    <PackageVersion Include="Refit" Version="16.3.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Pinned transitively (see CentralPackageTransitivePinningEnabled above), not referenced
         directly: it reaches us through Codacy.Api. -->
    <PackageVersion Include="Refit.HttpClientFactory" Version="16.3.0" />
    <!-- Pinned transitively (see CentralPackageTransitivePinningEnabled above), not referenced
         directly: 8.0.1 has known moderate (GHSA-2fmv-rv2c-59x7) and high (GHSA-846f-f764-76mx)
         severity vulnerabilities that NuGet audit escalates to a build error. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Test project dependencies -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AwesomeAssertions.Analyzers" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Xunit.Microsoft.DependencyInjection" Version="10.1.0" />
    <!-- Web project dependencies -->
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>