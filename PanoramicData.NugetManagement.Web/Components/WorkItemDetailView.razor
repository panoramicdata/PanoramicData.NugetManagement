@using PanoramicData.NugetManagement.Web.Models
@using PanoramicData.NugetManagement.Web.Services
@implements IDisposable
@inject IJSRuntime JS

@* One work item: what it is, and everything it has said. For a model-backed fix that transcript is
   the session itself, streamed as it arrives. *@

@if (Item is null)
{
	<div class="alert alert-secondary">
		That work has finished and left the queue.
	</div>
}
else
{
	<div class="work-item-detail">
		<div class="mb-3">
			<h4><i class="@StateIcon"></i> @Item.Title</h4>
			<div class="text-muted">@(Item.RepositoryFullName ?? Item.Organization)</div>
		</div>

		<p class="work-explanation">@WorkDescription.For(Item)</p>

		<div class="mb-3 small text-muted">
			<span class="me-3"><strong>State:</strong> @Item.State</span>
			@if (Item.Progress is { Length: > 0 } progress)
			{
				<span class="me-3"><strong>Progress:</strong> @progress</span>
			}
			@if (Item.Succeeded is { } succeeded)
			{
				<span class="me-3"><strong>Outcome:</strong> @(succeeded ? "succeeded" : "failed")</span>
			}
		</div>

		@if (IsAi)
		{
			<div class="form-check form-switch mb-2">
				<input class="form-check-input" type="checkbox" id="show-thinking" checked="@_showThinking"
					   @onchange="ToggleThinking" />
				<label class="form-check-label small text-muted" for="show-thinking">
					Show the model's thinking
				</label>
			</div>

			<div class="form-check form-switch mb-2">
				<input class="form-check-input" type="checkbox" id="show-prompt" checked="@_showPrompt"
					   @onchange="TogglePrompt" />
				<label class="form-check-label small text-muted" for="show-prompt">
					Show what the model was told
				</label>
			</div>
		}

		@{
			var snap = Changes;
		}

		@if (IsAi)
		{
			<ul class="nav nav-tabs mb-2">
				<li class="nav-item"><button type="button" class="nav-link @(_tab == Tab.Log ? "active" : "")" @onclick="ShowLog">Log</button></li>
				<li class="nav-item"><button type="button" class="nav-link @(_tab == Tab.Changes ? "active" : "")" @onclick="ShowChanges">Changes (@snap.Changes.Count)</button></li>
			</ul>
		}

		@if (ChangesShowing)
		{
			if (snap.Delivery is { } delivery)
			{
				<div class="alert alert-info small py-1 mb-2">
					@delivery.Summary
					@if (delivery.PullRequestUrl is { } pullRequestUrl)
					{
						<a href="@pullRequestUrl" target="_blank" rel="noopener noreferrer">View the pull request</a>
					}
				</div>
			}
			<div class="work-changes">
				<div class="work-changes-files">
					@foreach (var change in ChangesTabModel.Listed(snap.Changes))
					{
						var path = change.Path;
						<button type="button" class="work-changes-file @(path == snap.SelectedPath ? "selected" : "")" @onclick="() => SelectFile(path)">
							<span class="badge bg-secondary">@change.Kind</span>
							@path
							@if (snap.Labels.TryGetValue(path, out var label))
							{
								<span class="text-muted small">@label</span>
							}
						</button>
					}
						@if (ChangesTabModel.NotListed(snap.Changes) is > 0 and var notListed)
					{
						<div class="text-muted small p-2">...and @notListed more not shown</div>
					}
					@if (snap.Changes.Count == 0)
					{
						<div class="text-muted small p-2">No changes in the clone yet.</div>
					}
				</div>
				<div class="work-changes-diff">
					@if (snap.Pair is { NotDiffableReason: { } reason })
					{
						<div class="alert alert-secondary">Not diffable: @reason</div>
					}
					else if (snap.Pair is { } pair)
					{
						<PDDiffPanel Original="@pair.Original" Modified="@pair.Modified" FileName="@snap.SelectedPath" Theme="vs-dark" Height="100%" />
					}
				</div>
			</div>
		}
		else if (Lines.Count == 0)
		{
			<div class="alert alert-secondary">
				Nothing said yet.
				@if (Item.State == WorkItemState.Pending)
				{
					<span>This item is waiting for its lane.</span>
				}
			</div>
		}
		else
		{
			<div class="work-transcript" @ref="_transcriptElement">
				@foreach (var line in Lines)
				{
					<div class="work-line work-line-@line.Kind.ToString().ToLowerInvariant()">@line.Text</div>
				}
			</div>
		}
	</div>
}

@code {
	/// <summary>
	/// How often the pane redraws while the item is running. A streamed turn arrives token by token,
	/// and rendering per token would put a hundred round trips a second down the circuit.
	/// </summary>
	private const int RefreshMilliseconds = 200;

	private System.Timers.Timer? _refresh;
	private bool _showThinking = true;
	private bool _showPrompt = true;
	private ElementReference _transcriptElement;
	private string _followedExtent = string.Empty;
	private Tab _tab = Tab.Log;
	private string? _selectedPath;
	private string? _shownItemId;
	private readonly ChangesTabModel _changesModel = new(new CloneChangeReader(), TimeSpan.FromSeconds(1));

	private enum Tab { Log, Changes }

	[Inject]
	private LocalRepoService LocalRepos { get; set; } = default!;

	private ChangesTabModel.Snapshot Changes => _changesModel.Current;

	private bool ChangesShowing => _tab == Tab.Changes && IsAi;

	/// <summary>The item to show, or null when it has left the queue.</summary>
	[Parameter]
	public WorkItem? Item { get; set; }

	private bool IsAi => Item is not null && WorkDescription.IsAi(Item.Descriptor.Kind);

	private IReadOnlyList<WorkLine> Lines
	{
		get
		{
			IEnumerable<WorkLine> lines = Item?.Transcript.Snapshot() ?? [];

			if (!_showThinking)
			{
				lines = lines.Where(line => line.Kind != WorkLineKind.Thinking);
			}

			if (!_showPrompt)
			{
				lines = lines.Where(line => line.Kind != WorkLineKind.Prompt);
			}

			return [.. lines];
		}
	}

	private string StateIcon => Item?.State switch
	{
		WorkItemState.Running => "fas fa-circle-notch fa-spin text-info",
		WorkItemState.Cancelling => "fas fa-rotate-left fa-spin text-warning",
		_ => "fas fa-clock text-muted"
	};

	/// <summary>
	/// The same instance is reused when another item is selected, so everything that belongs to an item
	/// (the tab, the selected file, the changes read for it, any read still under way) is dropped when
	/// the item changes.
	/// </summary>
	protected override void OnParametersSet()
	{
		if (!string.Equals(_shownItemId, Item?.Id, StringComparison.Ordinal))
		{
			_shownItemId = Item?.Id;
			_tab = Tab.Log;
			_selectedPath = null;
			_followedExtent = string.Empty;
			_changesModel.Reset();
		}
	}

	protected override void OnInitialized()
	{
		// Its own timer rather than the lane-changed event: that one debounces into a tree rebuild,
		// and a stream of tokens is not a reason to rebuild the tree.
		_refresh = new System.Timers.Timer(RefreshMilliseconds) { AutoReset = true };
		_refresh.Elapsed += async (_, _) =>
		{
			var read = RefreshChangesAsync();
			await InvokeAsync(StateHasChanged);
			await read;
		};
		_refresh.Start();
	}

	/// <summary>
	/// Keeps the newest line in view while the reader is following the transcript, and leaves the
	/// scroll position alone once they have scrolled up to read something.
	/// </summary>
	/// <param name="firstRender">Whether this is the component's first render.</param>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// Only when the transcript has actually grown. The pane redraws five times a second while an
		// item runs, and a round trip per redraw buys nothing when nothing has been said.
		//
		// Growth is the line count AND the length of the last line, because a streamed turn accumulates
		// into one line for hundreds of tokens at a time. Counting lines alone left the pane still for
		// the whole of every turn — exactly the stretch anybody watching wants to see — and moved it
		// only once the turn was over.
		if (ChangesShowing)
		{
			// No transcript in the DOM; the follow state is re-established when the Log tab returns.
			return;
		}

		var lines = Item is null ? [] : Lines;
		var extent = lines.Count == 0
			? string.Empty
			: $"{lines.Count}:{lines[^1].Text.Length}";

		if (lines.Count == 0 || extent == _followedExtent)
		{
			return;
		}

		_followedExtent = extent;

		try
		{
			await JS.InvokeVoidAsync("scrollTail.follow", _transcriptElement);
		}
		catch
		{
			// The transcript is not in the DOM: the item left the queue, or the circuit is going away.
		}
	}

	public void Dispose()
	{
		_refresh?.Stop();
		_refresh?.Dispose();
		_refresh = null;
	}

	private void ToggleThinking(ChangeEventArgs args)
		=> _showThinking = args.Value as bool? ?? true;

	private void TogglePrompt(ChangeEventArgs args)
		=> _showPrompt = args.Value as bool? ?? true;

	private void ShowLog()
	{
		_tab = Tab.Log;
		_followedExtent = string.Empty;
	}

	private void ShowChanges()
	{
		_tab = Tab.Changes;
		_ = RefreshChangesAsync(force: true);
	}

	private void SelectFile(string path)
	{
		_selectedPath = path;
		_ = RefreshChangesAsync(force: true);
	}

	/// <summary>
	/// Re-reads the clone at most once a second, and only while the Changes tab is showing. The reads run
	/// git, so they go on the thread pool, and a read already under way is never doubled up. The result
	/// is picked up by the next redraw.
	/// </summary>
	/// <param name="force">Skip the one-second spacing (a tab or file switch).</param>
	private async Task RefreshChangesAsync(bool force = false)
	{
		try
		{
			// Decided on the render thread: the timer calls this from another one, and the item can change
			// between reading it and claiming a generation. Run here, the two cannot be split, so a read
			// started for one item can only publish for that item's generation.
			ReadRequest? request = null;
			await InvokeAsync(() => { request = BeginRead(force); });
			if (request is not { } read)
			{
				return;
			}

			await Task.Run(() => _changesModel.Refresh(read.Generation, read.ClonePath, read.Selected, read.PreExisting, read.Delivered));
			if (force)
			{
				await InvokeAsync(StateHasChanged);
			}
		}
		catch (ObjectDisposedException)
		{
			// The circuit is going away.
		}
	}

	private ReadRequest? BeginRead(bool force)
	{
		if (!ChangesShowing || Item is not { RepositoryFullName: { } repo } item || !_changesModel.TryBeginRead(DateTime.UtcNow, force, out var generation))
		{
			return null;
		}

		return new ReadRequest(generation, LocalRepos.GetLocalPath(repo), _selectedPath, item.PreExistingChanges, item.Delivered);
	}

	private readonly record struct ReadRequest(int Generation, string ClonePath, string? Selected, IReadOnlyDictionary<string, string> PreExisting, DeliveredChange? Delivered);
}
