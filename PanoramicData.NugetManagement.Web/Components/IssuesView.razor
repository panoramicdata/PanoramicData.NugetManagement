@implements IDisposable
@using PanoramicData.NugetManagement.Services
@inject DashboardService Dashboard
@inject DashboardCacheService Cache
@inject RuntimeSettingsService RuntimeSettings
@inject IJSRuntime JS


<div class="issues-page @(Embedded ? "embedded" : null)">
	@if (!Embedded)
	{
	<header class="issues-header">
		<div>
			<h1><i class="fas fa-layer-group"></i> Issues by class</h1>
			<p class="muted">The dimensional flip of the dashboard: an issue class, then the repositories it affects. Fix one across every repo in a single action.</p>
		</div>
		<div class="header-actions">
			<a class="btn btn-secondary" href="/"><i class="fas fa-arrow-left"></i> Dashboard</a>
			@if (_view is { HasAutomatedRemediation: true })
			{
				<button class="btn btn-danger" @onclick="ConfirmFixEverything" title="Apply every auto-fixable rule across every affected repository">
					<i class="fas fa-bolt"></i> Fix everything
				</button>
			}
		</div>
	</header>
	}

	@if (_bumps.Count > 0)
	{
		<div class="baseline-banner">
			<i class="fas fa-arrow-trend-up"></i>
			<span>
				<strong>Standard version baseline updated</strong> from an observed repository — commit <code>action-versions.json</code> to roll this out to everyone:
				@string.Join(", ", _bumps.Select(b => $"{b.Action} {b.From}→{b.To}"))
			</span>
		</div>
	}

	@if (string.IsNullOrEmpty(Organization))
	{
		@* Distinguished from "nothing cached": showing every organisation's repositories here would make
		   them all eligible for a bulk fix, so an unscoped view shows nothing at all instead. *@
		<p class="empty">No organisation selected, so there is nothing to show. Pick one under <em>Organisations</em>.</p>
	}
	else if (_rows.Count == 0)
	{
		<p class="empty">No assessed repositories are cached for @Organization. Run an assessment on the <a href="/">Dashboard</a> first.</p>
	}
	else if (_view is null || _view.IssueClassCount == 0)
	{
		<p class="empty">🎉 No issues found across @_rows.Count assessed repositories.</p>
	}
	else
	{
		<p class="summary">@_view.IssueClassCount issue class(es) across @_rows.Count repositories.</p>

		<div class="issue-tree">
			<PDTree TItem="IssueNavItem"
					@key="_treeVersion"
					DataProvider="_treeProvider"
					KeyField="x => x.Key"
					ParentKeyField="x => x.ParentKey!"
					TextField="x => x.Text"
					IsLeaf="x => x.IsLeaf"
					IconCssClass="(item, _) => string.Empty"
					AllowSelection="false"
					ShowRoot="true"
					Sort="CompareIssueNodes"
					ExceptionHandler="OnTreeException">
				<NodeTemplate Context="node">
					@if (node.Data is { Kind: IssueNodeKind.Category, Category: not null } catItem)
					{
						var cat = catItem.Category!;
						<span class="node-row cat-row">
							<span class="sev sev-@cat.Severity">@cat.Severity</span>
							<strong>@cat.Category</strong>
							<span class="muted">@cat.IssueClasses.Count rule(s) &middot; @cat.AffectedRepositoryCount repo(s)</span>
							<span class="actions">
								@if (cat.HasAutomatedRemediation)
								{
									<button class="btn btn-sm btn-primary" @onclick="() => ConfirmApplyCategory(cat)" @onclick:stopPropagation @onmousedown:stopPropagation>Apply auto-fixes</button>
								}
								<button class="btn btn-sm btn-secondary" @onclick="() => CopyCategoryPromptAsync(cat.Category)" @onclick:stopPropagation @onmousedown:stopPropagation>Copy AI prompt</button>
							</span>
						</span>
					}
					else if (node.Data is { Kind: IssueNodeKind.Rule, Rule: not null } ruleItem)
					{
						var rule = ruleItem.Rule!;
						<span class="node-row rule-row">
							<span class="sev sev-@rule.Severity">@rule.Severity</span>
							<strong>@rule.RuleId</strong>
							<span>@rule.RuleName</span>
							<span class="muted">@rule.AffectedRepositoryCount repo(s)</span>
							<span class="actions">
								@if (rule.HasAutomatedRemediation)
								{
									<button class="btn btn-sm btn-primary" disabled="@(SelectedAffected(rule) == 0)" @onclick="() => ConfirmApplyRule(rule)" @onclick:stopPropagation @onmousedown:stopPropagation>
										Apply &amp; push to @SelectedAffected(rule) repo(s)
									</button>
								}
								else
								{
									<button class="btn btn-sm btn-secondary" @onclick="() => CopyRulePromptAsync(rule.RuleId)" @onclick:stopPropagation @onmousedown:stopPropagation>Copy combined AI prompt</button>
								}
							</span>
						</span>
					}
					else if (node.Data is { Kind: IssueNodeKind.Repository, Instance: not null } repoItem)
					{
						var inst = repoItem.Instance!;
						<span class="node-row repo-row @(IsRepoSelected(inst.RepositoryFullName) ? "" : "repo-deselected") @(_fixedInThisRun.Contains(inst.RepositoryFullName) ? "repo-fixed" : null)">
							@if (_fixedInThisRun.Contains(inst.RepositoryFullName))
							{
								<i class="fas fa-check repo-fixed-tick" title="Fixed and pushed in this run"></i>
							}
							else
							{
								<span class="repo-dot @(inst.IsAutoRemediable ? "fixable" : "manual")"></span>
							}
							<span class="repo-name">@inst.RepositoryFullName</span>
							@if (repoItem.DisambiguatingPackageId is { Length: > 0 } packageId)
							{
								<span class="repo-package" title="This repository hosts several packages; this row is for @packageId">@packageId</span>
							}
							<span class="muted repo-msg">@Truncate(inst.Result.Message, 120)</span>
							<span class="actions">
								@if (inst.IsAutoRemediable)
								{
									<button class="btn btn-xs btn-primary" @onclick="() => ConfirmApplyRepo(repoItem.RuleId!, inst.RepositoryFullName)" @onclick:stopPropagation @onmousedown:stopPropagation>Apply here</button>
								}
								else
								{
									<button class="btn btn-xs btn-secondary" @onclick="() => CopyRepoPromptAsync(repoItem.RuleId!, inst.RepositoryFullName)" @onclick:stopPropagation @onmousedown:stopPropagation>Copy prompt</button>
								}
							</span>
						</span>
					}
				</NodeTemplate>
			</PDTree>
		</div>
	}
</div>

@if (_confirm is not null)
{
	<div class="modal-overlay" @onclick="CancelConfirm">
		<div class="modal-box" @onclick:stopPropagation="true">
			<h3><i class="fas fa-exclamation-triangle"></i> @_confirm.Title</h3>
			<p>This will <strong>edit, commit and push to <code>main</code></strong> in the following @_confirm.Repos.Count repositor@(_confirm.Repos.Count == 1 ? "y" : "ies"):</p>
			<ul class="repo-list">
				@foreach (var r in _confirm.Repos)
				{
					<li>@r</li>
				}
			</ul>
			<p class="warn"><i class="fas fa-info-circle"></i> Each repo is synced and re-assessed first, then fixed, committed and pushed. The operation <strong>stops on the first failure</strong>.</p>
			<div class="modal-actions">
				<button class="btn btn-secondary" @onclick="CancelConfirm">Cancel</button>
				<button class="btn btn-danger" @onclick="RunConfirmedAsync">
					<i class="fas fa-bolt"></i> Confirm — push to @_confirm.Repos.Count repo(s)
				</button>
			</div>
		</div>
	</div>
}

<style>
	/* The shared .app-shell is height:100vh; overflow:hidden, so this page must own its scroll. */
	.issues-page { height: 100vh; overflow-y: auto; box-sizing: border-box; padding: 1rem 1.5rem 3rem; }
	/* Embedded in the dashboard shell: the panel owns the height and scrolling, and the shell
	   already supplies a title, so less chrome is needed. */
	.issues-page.embedded { height: auto; overflow-y: visible; padding: 1rem 1.25rem 2rem; }
	.issues-page > * { max-width: 1200px; margin-left: auto; margin-right: auto; }
	.issues-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
	.issues-header h1 { font-size: 1.4rem; margin: 0; }
	/* Scoped to the header: .muted is also used for counts inside tree rows. */
	.issues-header .muted { margin: 1.5rem 0 0; }
	.header-actions { display: flex; gap: .5rem; flex-shrink: 0; }
	.muted { color: var(--bs-secondary-color, #888); font-size: .85rem; }
	.summary { font-weight: 600; margin: .5rem auto 1rem; }
	.repo-package { font-size: .75rem; padding: 0 .35rem; border-radius: 3px; background: rgba(128,128,128,.18); color: var(--bs-secondary-color, #aaa); }
	.baseline-banner { display: flex; gap: .6rem; align-items: center; background: #1f3a2e; border: 1px solid #2e7d32; color: #d7f5df; padding: .6rem .8rem; border-radius: 6px; margin: .5rem auto 1rem; font-size: .9rem; }
	/* Fixed in this run: ticked and dimmed rather than removed, because the row goes on its own
	   once the re-assessment confirms the issue has gone. */
	.repo-fixed { opacity: .55; }
	.repo-fixed-tick { color: #2e7d32; width: .6rem; font-size: .7rem; }
	.empty { padding: 2rem 0; }
	.cat-node { border: 1px solid var(--bs-border-color, #333); border-radius: 6px; margin-bottom: .5rem; overflow: hidden; }
	.node-row { display: flex; align-items: center; gap: .5rem; padding: .4rem .6rem; }
	.cat-row { background: var(--bs-tertiary-bg, rgba(128,128,128,.12)); }
	/* No manual indent: PDTree indents child levels itself. Left-padding here would also push the
	   row border out to the left of its content. */
	.rule-row { border-top: 1px solid var(--bs-border-color, #2a2a2a); }
	.repo-row { border-top: 1px dashed var(--bs-border-color, #2a2a2a); font-size: .9rem; }
	.node-row .actions { margin-left: auto; display: flex; gap: .35rem; flex-shrink: 0; }
	.expander { background: none; border: none; cursor: pointer; color: inherit; width: 1.2rem; }
	.repo-name { font-family: monospace; }
	.repo-msg { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.repo-dot { width: .6rem; height: .6rem; border-radius: 50%; display: inline-block; }
	.repo-dot.fixable { background: #2e7d32; }
	.repo-dot.manual { background: #b26a00; }
	.sev { font-size: .7rem; text-transform: uppercase; padding: .1rem .4rem; border-radius: 3px; font-weight: 700; }
	.sev-Critical { background: #7f1d1d; color: #fff; }
	.sev-Error { background: #b91c1c; color: #fff; }
	.sev-Warning { background: #b45309; color: #fff; }
	.sev-Info { background: #374151; color: #fff; }
	.btn-xs { font-size: .72rem; padding: .1rem .4rem; }
	.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center; z-index: 1050; }
	.modal-box { background: var(--bs-body-bg, #1e1e1e); color: var(--bs-body-color, #eee); border: 1px solid var(--bs-border-color, #444); border-radius: 8px; padding: 1.2rem 1.4rem; max-width: 560px; width: 90%; max-height: 80vh; overflow: auto; }
	.repo-list { max-height: 240px; overflow: auto; font-family: monospace; font-size: .85rem; }
	.warn { color: #f0ad4e; font-size: .85rem; }
	.modal-actions { display: flex; justify-content: flex-end; gap: .5rem; margin-top: 1rem; }
</style>

@code {
	/// <summary>
	/// True when hosted inside the dashboard shell rather than on its own page. The shell already
	/// provides a title and breadcrumb, so the page header is omitted and the panel scrolls instead.
	/// </summary>
	[Parameter]
	public bool Embedded { get; set; }

	/// <summary>
	/// The organisation whose issues are shown. Required.
	/// </summary>
	/// <remarks>
	/// It used to be optional, with null meaning "every organisation" for the benefit of a standalone
	/// /issues page. That page has been retired, because an unscoped view of this component is a
	/// hazard: every repository is selected by default and its bulk actions — Fix everything, Apply and
	/// push to N repositories — would then act across every organisation at once, limited only by boxes
	/// the user remembered to untick. With no caller left that legitimately wants that, omitting the
	/// organisation now shows nothing rather than everything.
	/// </remarks>
	[Parameter]
	[EditorRequired]
	public string? Organization { get; set; }

	/// <summary>
	/// Narrows the view to a single category, so selecting a category in the navigation tree shows
	/// just that category's rules and their affected repositories in this panel.
	/// </summary>
	[Parameter]
	public AssessmentCategory? FocusCategory { get; set; }

	/// <summary>
	/// Narrows the view to a single rule. Combined with <see cref="FocusCategory"/> this reduces the
	/// panel to one rule, its affected repositories and its bulk actions.
	/// </summary>
	[Parameter]
	public string? FocusRuleId { get; set; }

	/// <summary>
	/// Where this component's progress and error lines go. The host owns the console — the one at the
	/// bottom of the dashboard — so output from a bulk run lands alongside every other operation's
	/// rather than in a second console of our own.
	/// </summary>
	[Parameter]
	[EditorRequired]
	public EventCallback<string> OnOutput { get; set; }

	/// <summary>
	/// Puts a bulk run on the application-wide work queue. The host owns the queue, so a run started
	/// here waits behind whatever the dashboard — or another tab — already has in flight, and gains a
	/// stop button of its own.
	/// </summary>
	[Parameter]
	[EditorRequired]
	public EventCallback<QueuedWork> OnEnqueue { get; set; }

	// What the currently-loaded view was built for, so OnParametersSet only reloads on a real change.
	private string? _loadedOrganization;
	private AssessmentCategory? _loadedFocusCategory;
	private string? _loadedFocusRuleId;
	private bool _loaded;

	private List<PackageDashboardRow> _rows = [];
	private IssueCentricView? _view;
	private IReadOnlyList<ActionVersionBump> _bumps = [];
	// PDTree owns expansion state, so no hand-rolled expanded-node tracking is needed. The version
	// is the tree's @key: bumping it rebuilds the tree when the underlying view changes.
	private readonly IssueTreeDataProvider _treeProvider = new();
	private int _treeVersion;
	private PendingConfirm? _confirm;
	/// <summary>The repositories this view covers: everything not excluded on the Repositories tree.</summary>
	private HashSet<string> _inScope = new(StringComparer.OrdinalIgnoreCase);

	/// <summary>Repositories this view has seen a fix pushed for, so rows can show progress mid-run.</summary>
	private readonly HashSet<string> _fixedInThisRun = new(StringComparer.OrdinalIgnoreCase);

	protected override void OnInitialized()
	{
		LoadView();
	}

	/// <summary>
	/// Rebuilds when the hosting shell changes which organisation, category or rule is in focus —
	/// selecting a different node in the navigation tree re-parameterises this component rather than
	/// recreating it, so OnInitialized alone would leave the old content on screen.
	/// </summary>
	protected override void OnParametersSet()
	{
		var changed = !_loaded
			|| !string.Equals(_loadedOrganization, Organization, StringComparison.OrdinalIgnoreCase)
			|| _loadedFocusCategory != FocusCategory
			|| !string.Equals(_loadedFocusRuleId, FocusRuleId, StringComparison.OrdinalIgnoreCase);

		if (changed)
		{
			LoadView();
		}
	}

	/// <summary>
	/// Called as each repository's fix lands. Writes the freshly re-assessed row back to the cache and
	/// rebuilds the view, so a rule stops listing repositories it has just been fixed in — while the
	/// run is still going, rather than after it finishes.
	/// </summary>
	private void OnRepositoryFixed(PackageDashboardRow row)
	{
		if (row.RepositoryFullName is not null)
		{
			// Ticked rather than removed: the row goes on its own once the re-assessment says the issue
			// has gone, and a tick is honest in the meantime — pushed, not yet proven by the guard.
			_fixedInThisRun.Add(row.RepositoryFullName);
		}

		Cache.UpsertRow(row);
		LoadView();
		_ = InvokeAsync(StateHasChanged);
	}


	/// <summary>
	/// Orders sibling nodes by criticality. PDTree sorts children itself, falling back to comparing
	/// node text, which would present the tree alphabetically and discard the severity ordering the
	/// view builder already applied.
	/// </summary>
	private static int CompareIssueNodes(IssueNavItem a, IssueNavItem b)
	{
		// Most severe first. AssessmentSeverity ascends Info -> Critical, so compare b to a.
		var severity = SeverityOf(b).CompareTo(SeverityOf(a));
		if (severity != 0)
		{
			return severity;
		}

		// Then the widest blast radius first, so the rule affecting the most repositories leads.
		var reach = AffectedCountOf(b).CompareTo(AffectedCountOf(a));
		return reach != 0
			? reach
			: string.Compare(a.Text, b.Text, StringComparison.OrdinalIgnoreCase);
	}

	private static AssessmentSeverity SeverityOf(IssueNavItem item) => item.Kind switch
	{
		IssueNodeKind.Category => item.Category?.Severity ?? AssessmentSeverity.Info,
		IssueNodeKind.Rule => item.Rule?.Severity ?? AssessmentSeverity.Info,
		_ => item.Instance?.Result.Severity ?? AssessmentSeverity.Info
	};

	private static int AffectedCountOf(IssueNavItem item) => item.Kind switch
	{
		IssueNodeKind.Category => item.Category?.AffectedRepositoryCount ?? 0,
		IssueNodeKind.Rule => item.Rule?.AffectedRepositoryCount ?? 0,
		// Repository nodes are all one occurrence, so they fall through to the name comparison.
		_ => 0
	};

	// PDTree swallows load-time exceptions, which shows up as a silently empty tree.
	private void OnTreeException(Exception exception)
	{
		Append($"Issue tree failed to load: {exception.GetType().Name}: {exception.Message}");
		_ = InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		// Nothing to unsubscribe from: build-guard status is per repository, so it belongs on the
		// Repositories tree rather than above every issue class (#66).
	}

	/// <summary>
	/// Reduces the view to the focused category and/or rule. With the issue hierarchy now living in
	/// the navigation sidebar, this panel shows the detail for whatever the sidebar selected — the
	/// affected repositories and the bulk actions — rather than repeating the whole hierarchy.
	/// </summary>
	private IssueCentricView? NarrowToFocus(IssueCentricView? view)
	{
		if (view is null || (FocusCategory is null && string.IsNullOrEmpty(FocusRuleId)))
		{
			return view;
		}

		var categories = view.Categories
			.Where(c => FocusCategory is null || c.Category == FocusCategory)
			.Select(c => string.IsNullOrEmpty(FocusRuleId)
				? c
				: new IssueCategoryGroup
				{
					Category = c.Category,
					IssueClasses = [.. c.IssueClasses
						.Where(i => string.Equals(i.RuleId, FocusRuleId, StringComparison.OrdinalIgnoreCase))]
				})
			.Where(c => c.IssueClasses.Count > 0)
			.ToList();

		return new IssueCentricView { Categories = categories };
	}

	private void LoadView()
	{
		_rows = Cache.GetCachedRows() ?? [];

		// Filter to the organisation, unconditionally. This deliberately has no escape hatch: it used
		// to skip filtering when no row anywhere carried an organisation, to cope with a cache written
		// before multi-organisation support — but "no organisation supplied" and "cache looks legacy"
		// both then meant every organisation's repositories became eligible for a bulk fix. A stale
		// cache is one Rediscover away; a bulk action on the wrong organisation is not undone so easily.
		// The cost is that untagged legacy rows are invisible until rediscovered, which is recoverable.
		_rows = string.IsNullOrEmpty(Organization)
			? []
			: [.. _rows.Where(r => string.Equals(r.Organization, Organization, StringComparison.OrdinalIgnoreCase))];

		// Excluded repositories leave here, which keeps them out of the issue classes, the counts on
		// the buttons and every bulk action — one decision, taken on the Repositories tree. Packages
		// whose repository is not ours leave for the same reason: there is no issue to raise against a
		// repository we do not govern, and nothing here may offer to write to one.
		_rows = [.. _rows.Where(r => r.IsGoverned && !RuntimeSettings.IsRepositoryExcluded(r.RepositoryFullName))];

		_view = NarrowToFocus(Dashboard.BuildIssueCentricView(_rows));
		_bumps = ActionVersionCatalog.Default.RecentBumps;

		_loadedOrganization = Organization;
		_loadedFocusCategory = FocusCategory;
		_loadedFocusRuleId = FocusRuleId;
		_loaded = true;

		_treeProvider.View = _view;
		_treeVersion++;

		// Everything still here is in scope: excluded repositories left when the rows were filtered,
		// so there is one notion of "included" rather than a second, transient one to re-tick each
		// session.
		_inScope = [.. _rows
			.Where(r => r.RepositoryFullName is not null)
			.Select(r => r.RepositoryFullName!)];
	}

	private List<PackageDashboardRow> SelectedRows()
		=> [.. _rows.Where(r => r.RepositoryFullName is not null && _inScope.Contains(r.RepositoryFullName))];

	/// <summary>
	/// The rows for a computed target set, in the order the run will visit them. The count the user
	/// approved and the repositories the run touches come from the same list.
	/// </summary>
	private List<PackageDashboardRow> RowsFor(IReadOnlyList<string> repositoryFullNames)
	{
		var targets = repositoryFullNames.ToHashSet(StringComparer.OrdinalIgnoreCase);
		return [.. _rows.Where(r => r.RepositoryFullName is not null && targets.Contains(r.RepositoryFullName))];
	}

	private bool IsRepoSelected(string? name) => name is not null && _inScope.Contains(name);

	private int SelectedAffected(IssueClassGroup rule)
		=> BulkApplyScope.ForRule(rule, _inScope).Count;

	private static string Truncate(string value, int max)
		=> string.IsNullOrEmpty(value) || value.Length <= max ? value : value[..max] + "…";

	// ── Confirmation set-up (bulk apply gated behind the modal) ──

	private void ConfirmApplyRule(IssueClassGroup rule)
	{
		var repos = BulkApplyScope.ForRule(rule, _inScope);
		if (repos.Count == 0)
		{
			Append($"No selected repositories are affected by {rule.RuleId}.");
			return;
		}

		_confirm = new PendingConfirm
		{
			Title = $"Apply {rule.RuleId} & push — {repos.Count} repos",
			DedupKey = $"apply-rule:{Organization}:{rule.RuleId}:{string.Join(',', repos)}",
			Repos = repos,
			Action = (log, progress, ct) => Dashboard.ApplyRuleAcrossReposAsync(RowsFor(repos), rule.RuleId, log, progress, OnRepositoryFixed, ct)
		};
	}

	private void ConfirmApplyCategory(IssueCategoryGroup cat)
	{
		var repos = BulkApplyScope.ForCategory(cat, _inScope);
		if (repos.Count == 0)
		{
			Append($"No selected repositories are affected by auto-fixable {cat.Category} rules.");
			return;
		}

		_confirm = new PendingConfirm
		{
			Title = $"Apply {cat.Category} fixes & push — {repos.Count} repos",
			DedupKey = $"apply-category:{Organization}:{cat.Category}:{string.Join(',', repos)}",
			Repos = repos,
			Action = (log, progress, ct) => Dashboard.ApplyCategoryAcrossReposAsync(RowsFor(repos), cat.Category, log, progress, OnRepositoryFixed, ct)
		};
	}

	private void ConfirmApplyRepo(string ruleId, string repoFullName)
	{
		var scoped = _rows.Where(r => string.Equals(r.RepositoryFullName, repoFullName, StringComparison.OrdinalIgnoreCase)).ToList();
		_confirm = new PendingConfirm
		{
			Title = $"Apply {ruleId} to {repoFullName}",
			DedupKey = $"apply-rule:{Organization}:{ruleId}:{repoFullName}",
			Repos = [repoFullName],
			Action = (log, progress, ct) => Dashboard.ApplyRuleAcrossReposAsync(scoped, ruleId, log, progress, OnRepositoryFixed, ct)
		};
	}

	private void ConfirmFixEverything()
	{
		IReadOnlyList<string> repos = _view is null ? [] : BulkApplyScope.ForEverything(_view, _inScope);
		if (repos.Count == 0)
		{
			Append("No selected repositories have auto-fixable issues.");
			return;
		}

		_confirm = new PendingConfirm
		{
			Title = $"Fix everything & push — {repos.Count} repos",
			DedupKey = $"fix-everything:{Organization}:{string.Join(',', repos)}",
			Repos = repos,
			Action = (log, progress, ct) => Dashboard.ApplyEverythingAcrossReposAsync(RowsFor(repos), log, progress, OnRepositoryFixed, ct)
		};
	}

	private void CancelConfirm() => _confirm = null;

	private async Task RunConfirmedAsync()
	{
		var pending = _confirm;
		_confirm = null;
		if (pending is null)
		{
			return;
		}

		// Handed to the queue rather than run here: these runs commit and push across many
		// repositories, and must not overlap anything else touching the same working trees.
		await OnEnqueue.InvokeAsync(new QueuedWork
		{
			Title = pending.Title,
			Organization = Organization,
			DedupKey = pending.DedupKey,
			Run = RunAsync
		});

		async Task RunAsync(IProgress<string> progress, CancellationToken cancellationToken)
		{
			var outcome = await pending.Action(Append, progress, cancellationToken);
			Append($"— Done: {outcome.PushedCount} pushed, {outcome.FailedCount} failed{(outcome.StoppedOnFailure ? " (stopped on failure)" : "")}.");
			LoadView();
			await InvokeAsync(StateHasChanged);
		}
	}

	// A bulk run reports from a background task, so the hop through InvokeAsync puts the callback
	// back on the renderer's context before the host touches its own state.
	private void Append(string line) => _ = InvokeAsync(() => OnOutput.InvokeAsync(line));

	// ── Combined / per-repo AI prompt copy ──

	private Task CopyRulePromptAsync(string ruleId)
		=> CopyAsync(Dashboard.GenerateCombinedRulePrompt(SelectedRows(), ruleId), $"combined prompt for {ruleId}");

	private Task CopyCategoryPromptAsync(AssessmentCategory category)
		=> CopyAsync(Dashboard.GenerateCombinedCategoryPrompt(SelectedRows(), category, onlyNonRemediable: true), $"combined prompt for {category}");

	private Task CopyRepoPromptAsync(string ruleId, string repoFullName)
	{
		var row = _rows.FirstOrDefault(r => string.Equals(r.RepositoryFullName, repoFullName, StringComparison.OrdinalIgnoreCase));
		var result = row?.Assessment?.RuleResults.FirstOrDefault(rr => !rr.Passed && string.Equals(rr.RuleId, ruleId, StringComparison.OrdinalIgnoreCase));
		var prompt = row is not null && result is not null
			? DashboardService.GenerateRuleRemediationPrompt(row, result)
			: string.Empty;
		return CopyAsync(prompt, $"prompt for {repoFullName}");
	}

	private async Task CopyAsync(string text, string label)
	{
		if (string.IsNullOrWhiteSpace(text))
		{
			Append($"⚠️ Nothing to copy for {label}.");
			return;
		}

		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
			Append($"📋 Copied {label} to clipboard ({text.Length:N0} chars).");
		}
		catch (Exception ex)
		{
			Append($"⚠️ Copy failed: {ex.Message}");
		}
	}

	private sealed class PendingConfirm
	{
		public required string Title { get; init; }

		/// <summary>Identifies a request that would repeat one already waiting in the queue.</summary>
		public required string DedupKey { get; init; }
		public required IReadOnlyList<string> Repos { get; init; }
		public required Func<Action<string>, IProgress<string>, CancellationToken, Task<BulkApplyOutcome>> Action { get; init; }
	}
}
