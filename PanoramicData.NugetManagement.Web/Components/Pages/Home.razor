		var orgKey = NavTreeDataProvider.OrgKey(organization);
		var orgNode = _navTree?.RootNode.Find(orgKey);
		if (orgNode is not null)
		{
			await _navTree!.SelectNode(orgNode);
		}
		else
		{
			_currentView = NavView.Home;
			_selectedRow = null;
			_selectedNodeKey = orgKey;
			_selectedOrganization = organization;
			_orgSelected = true;
			StateHasChanged();
		}
	}

