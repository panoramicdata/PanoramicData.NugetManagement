	// === Git safety guard methods ===

	private bool IsFixEnabled()
	{
		if (_selectedRow is null || !_selectedRow.IsClonedLocally)
		{
			return false;
		}

		// Checked here rather than at each button: Fix is offered from the toolbar, from each issue
		// category and from individual rules, and a gate on only one of them is not a gate.
		if (IsStepQueueBlocked(WorkflowStep.Fix))
		{
			return false;
		}

		if (_selectedRow.Assessment is null ||
			!_selectedRow.Assessment.RuleResults.Any(r => !r.Passed && Dashboard.IsAutoRemediable(r)))
		{
			return false;
		}

		if (_selectedRow.Assessment.RuleResults.Any(r => !r.Passed && r.RuleId == "REPO-06" && Dashboard.IsAutoRemediable(r)))
		{
			return true;
		}

		return _selectedRow.CurrentBranch == "main"
			&& _selectedRow.IsSyncedWithOrigin != false;
	}

	private string? GetFixBlockReason(bool allowBranchMigrationOffMain = false)
	{
		if (_selectedRow is null || !_selectedRow.IsClonedLocally)
		{
			return "Repository is not cloned locally";
		}

		if (_selectedRow.CurrentBranch != "main" && !allowBranchMigrationOffMain)
		{
			return $"Must be on 'main' branch (currently on '{_selectedRow.CurrentBranch ?? "unknown"}')";
		}

		if (IsBlockedByOutOfSync)
		{
			// The same wording as every other step blocked by this, rather than a second phrasing of it.
			return OutOfSyncBlockedTooltip;
		}

		return null;
	}

	private bool HasPendingMasterToMainRemediation()
		=> _selectedRow?.Assessment?.RuleResults.Any(r => !r.Passed && r.RuleId == "REPO-06" && Dashboard.IsAutoRemediable(r)) == true;

	private bool CanRunMasterToMainAutoFix()
		=> HasPendingMasterToMainRemediation()
			&& string.Equals(_selectedRow?.CurrentBranch, "master", StringComparison.OrdinalIgnoreCase);

	private string GetFixAllTooltip()
	{
		if (IsQueueBusy)
		{
			return "Will be queued behind the work already running";
		}

		if (_selectedRow is null || !_selectedRow.IsClonedLocally)
		{
			return "Clone the repository first";
		}

		if (_selectedRow.Assessment is null)
		{
			return "Assess the package first";
		}

		if (!_selectedRow.Assessment.RuleResults.Any(r => !r.Passed && Dashboard.IsAutoRemediable(r)))
		{
			return "No auto-remediable issues found";
		}

		return GetFixBlockReason(CanRunMasterToMainAutoFix()) ?? "Auto-fix remediable issues";
	}

	private string GetFixCategoryTooltip(AssessmentCategory category)
	{
		if (IsQueueBusy)
		{
			return "Will be queued behind the work already running";
		}

		var allowMasterToMainFlow = category == AssessmentCategory.RepositoryHygiene && CanRunMasterToMainAutoFix();
		return GetFixBlockReason(allowMasterToMainFlow) ?? $"Auto-fix {category}";
	}

	private string GetFixSingleTooltip()
	{
		if (IsQueueBusy)
		{
			return "Will be queued behind the work already running";
		}

		if (HasPendingMasterToMainRemediation())
		{
			return GetFixBlockReason(allowBranchMigrationOffMain: true) ?? "Auto-fix this issue";
		}

		return GetFixBlockReason() ?? "Auto-fix this issue";
	}

	// === Publish guard methods ===

	/// <summary>
	/// Whether the selected repository is known to be behind origin, which leaves Sync as the only step
	/// worth offering.
	/// </summary>
	/// <remarks>
	/// Everything else in the workflow reasons about the code in the clone: re-assessing reports on a tree
	/// that has been superseded, a build and its tests describe superseded code, and a push has just been
	/// refused for that reason. Offering them invites work whose conclusions cannot be trusted — so once
	/// the push gate establishes the clone is behind, the toolbar narrows to the one action that resolves
	/// it. Only a positive answer counts: an unknown or expired sync belief blocks nothing.
	/// </remarks>
	private bool IsBlockedByOutOfSync => _selectedRow?.IsSyncedWithOrigin == false;

	private const string OutOfSyncBlockedTooltip =
		"Origin has commits this clone does not — Sync first, or anything done here is based on code that has moved on";

	/// <summary>
	/// The tooltip for a step that needs a clone and a clone that is current, naming whichever is missing.
	/// </summary>
	private string WorkflowStepTooltip(string whenAvailable)
		=> _selectedRow?.IsClonedLocally != true
			? "Clone the repository first"
			: IsBlockedByOutOfSync
				? OutOfSyncBlockedTooltip
				: whenAvailable;

	private bool IsSyncEnabled()
	{
		if (_selectedRow is null)
		{
			return false;
		}

		if (!_selectedRow.IsClonedLocally)
		{
			return true;
		}

		// Only whether we differ from origin. It used to also enable on a dirty working tree, which had
		// it backwards: syncing is fetch, pull --rebase, push, and uncommitted changes are what make the
		// rebase refuse to run — not something syncing puts right. So a repository showing both "Dirty"
		// and "Synced" offered a button whose only likely outcome was a failed rebase.
		return !IsRecentlyConfirmedInSync(_selectedRow);
	}

	/// <summary>
	/// Whether this row was confirmed to match origin recently enough to still act on it.
	/// </summary>
	/// <remarks>
	/// The age matters because being in sync is not a durable fact — origin can move a moment after the
	/// check, and nothing tells the app when it does. Disabling Sync on the bare claim would eventually
	/// strand someone with a button they cannot press and a pull they need, so the claim expires.
	/// </remarks>
	private static bool IsRecentlyConfirmedInSync(RepositoryDashboardRow row)
		=> row.IsSyncedWithOrigin == true
			&& row.SyncStatusCheckedAtUtc is { } checkedAt
			&& DateTimeOffset.UtcNow - checkedAt < SyncStatusTrustedFor;

	/// <summary>
	/// How long a confirmed-in-sync answer is treated as still true. Long enough to cover working
	/// through the toolbar on one repository, short enough that a stale answer does not block a pull.
	/// </summary>
	private static readonly TimeSpan SyncStatusTrustedFor = TimeSpan.FromMinutes(5);

	/// <summary>
	/// Dates the sync badge, so a claim about origin is not read as being about this moment.
	/// </summary>
	private string SyncBadgeTooltip(string state)
		=> _selectedRow?.SyncStatusCheckedAtUtc is { } checkedAt
			? $"{state}, as at {checkedAt:HH:mm:ss} UTC"
			: state;

	/// <summary>
	/// The tooltip for a sync state that was true when last established but has not been rechecked since.
	/// </summary>
	private string UnconfirmedSyncBadgeTooltip
		=> $"{SyncBadgeTooltip("Was in sync with origin")} — not confirmed since. Sync to check.";

	/// <summary>
	/// What a repository publishes, for the breadcrumb: the version when there is one package, and the
	/// count when there are several, whose versions differ and cannot be shown as one.
	/// </summary>
	/// <summary>
	/// The cached row a navigation node belongs to, or null when the node is above the repository
	/// layer or its repository has since left the estate.
	/// </summary>
	/// <remarks>
	/// Every node from the repository downwards carries its repository, so one lookup serves the
	/// repository, its packages, its categories and its rules alike.
	/// </remarks>
	private RepositoryDashboardRow? RowForNavItem(NavItem item)
		=> item.RepositoryFullName is not { Length: > 0 } repositoryFullName
			? null
			: _rows.FirstOrDefault(r =>
				string.Equals(r.RepositoryFullName, repositoryFullName, StringComparison.OrdinalIgnoreCase));

	/// <summary>
	/// The selected open issue, taken from the selected row. Null if the cache has been refreshed
	/// since the node was drawn and the item has closed.
	/// </summary>
	private RepositoryIssue? SelectedRepositoryIssue
		=> _selectedIssueNumber is null
			? null
			: _selectedRow?.OpenIssues.FirstOrDefault(i => i.Number == _selectedIssueNumber);

	/// <summary>
	/// Names the packages whose nuspec could not be read, after a discovery.
	/// </summary>
	/// <remarks>
	/// A repository silently held at yesterday's mapping looks exactly like one confirmed today, and a
	/// package with no previous mapping drops out of the estate altogether. Neither is safe to leave
	/// to the log. Named rather than counted: three packages failed sends the reader to the log, while
	/// the names send them to the rediscover button for the ones that matter.
	/// </remarks>
	private void ReportUnreadNuspecs()
	{
		var unread = Cache.GetUngovernedPackages()
			.Where(package => package.Reason.StartsWith(UngovernedPackage.LookupFailedReasonPrefix, StringComparison.Ordinal))
			.Select(package => package.PackageId)
			.ToList();

		if (unread.Count == 0)
		{
			return;
		}

		_consoleVisible = true;
		AppendConsole(
			$"⚠️ Could not read the nuspec for {string.Join(", ", unread)}. "
			+ "Their repositories are unchanged from the last successful discovery; rediscover to try again.");
	}

	/// <summary>
	/// The repository's latest tag, or a placeholder when none is known.
	/// </summary>
	private static string TagOrUnknown(RepositoryDashboardRow row) => row.LatestTag ?? "(unknown)";

	/// <summary>
	/// Every package a repository publishes, comma-separated, for a tooltip.
	/// </summary>
	private static string PackageIdList(RepositoryDashboardRow row)
		=> string.Join(", ", row.Packages.Select(package => package.PackageId));

	private static string PackagesSummary(RepositoryDashboardRow row)
		=> row.Packages.Count switch
		{
			0 => string.Empty,
			1 => row.Packages[0].LatestVersion ?? string.Empty,
			var count => $"{count} packages"
		};

	/// <summary>
	/// The packages whose published version is not the repository's latest tag, as "id version".
	/// </summary>
	private static string OutOfStepSummary(RepositoryDashboardRow row)
		=> string.Join(", ", row.Packages
			.Where(package => package.MatchesTag(row.LatestTag) == false)
			.Select(package => $"{package.PackageId} {package.LatestVersion}"));

	/// <summary>
	/// The full explanation of a tag disagreement, naming every package that is out of step.
	/// </summary>
	private static string OutOfStepTooltip(RepositoryDashboardRow row)
		=> $"Latest tag {row.LatestTag ?? "(unknown)"} does not match {OutOfStepSummary(row)}";

	private string GetSyncTooltip()
	{
		if (IsQueueBusy)
		{
			return "Will be queued behind the work already running";
		}

		if (_selectedRow is null)
		{
			return "Select a repository";
		}

		if (!_selectedRow.IsClonedLocally)
		{
			return "Clone and sync repository";
		}

		if (IsRecentlyConfirmedInSync(_selectedRow))
		{
			return $"Already in sync with origin, as at {_selectedRow.SyncStatusCheckedAtUtc:HH:mm:ss} UTC";
		}

		// Sync is still the right button here, but saying what will get in the way beats letting the
		// rebase explain it.
		return _selectedRow.IsWorkingTreeClean == false
			? "Fetch, pull --rebase, push — uncommitted changes may block the rebase"
			: "Fetch, pull --rebase, push";
	}

	private bool IsPublishEnabled() => PublishGate.IsEnabled(_selectedRow, _allowPublishWithoutTests);

	private string GetPublishTooltip()
	{
		if (_isRunning)
		{
			return "Another operation is running";
		}

		if (_selectedRow is null || !_selectedRow.IsClonedLocally)
		{
			return "Clone the repository first";
		}

		if (_selectedRow.IsWorkingTreeClean == false)
		{
			return "Commit and push first — the working tree has uncommitted changes, "
				+ "so the published package would not match anything on origin";
		}

		if (IsBlockedByOutOfSync)
		{
			return OutOfSyncBlockedTooltip;
		}

		if (PublishGate.WaivesTests(_selectedRow, _allowPublishWithoutTests))
		{
			// Says so on the button that acts on it: a green Publish normally means the tests passed,
			// and a waiver nobody is reminded of is a waiver that quietly becomes the default.
			return "Publishing without tests — the test gate is waived in Application settings";
		}

		if (_selectedRow.Status != PackageStatus.TestsPassed)
		{
			return _selectedRow.Status == PackageStatus.BuildSucceeded
				? "Run tests first — or waive the test gate in Application settings"
				: "Run tests first — tests must pass before publishing";
		}

		return GetFixBlockReason() ?? "Run Publish.ps1";
	}

