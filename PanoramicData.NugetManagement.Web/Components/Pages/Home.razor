	private async Task FixSingleRuleCoreAsync(RepositoryDashboardRow row, RuleResult result, IProgress<string> progress, CancellationToken cancellationToken)
	{
		// Re-checked here rather than trusted from the click: the clone can be gone by the time the
		// queue reaches this item.
		if (row.LocalPath is null)
		{
			AppendConsole($"⏭️ {row.RepositoryFullName} is no longer cloned locally — skipping {result.RuleId}.");
			return;
		}

		_isRunning = true;
		ClearConsole();
		AppendConsole($"▶ Fixing {result.RuleId}...");
		StateHasChanged();

		try
		{
			var applied = new List<string>();
			Dashboard.ApplySingleRemediationPublic(row.LocalPath, result, applied, line =>
			{
				AppendConsole(line);
				InvokeAsync(StateHasChanged);
			});

			await Dashboard.RefreshGitStatusAsync(row);
			await PersistSelectedRowUpdateAsync();
			AppendConsole(applied.Count > 0 ? $"✅ Fixed {result.RuleId}" : $"⚠️ Could not fix {result.RuleId}");

			_isAssessing = true;
			_progressMessage = "Re-assessing...";
			StateHasChanged();
			await Dashboard.AssessLocalRepositoryAsync(row);
           await PersistSelectedRowUpdateAsync();
		}
		catch (OperationCanceledException)
		{
			// Atomic per repository: a fix that was stopped part-way is undone, so the clone is left as
			// it was found rather than carrying half a remediation into the next commit.
			await RevertPartAppliedFixAsync(row);
			throw;
		}
		catch (Exception ex)
		{
			AppendConsole($"❌ Error: {ex.Message}");
		}
		finally
		{
			_isRunning = false;
			_isAssessing = false;
			_progressMessage = string.Empty;
			StateHasChanged();
		}
	}

