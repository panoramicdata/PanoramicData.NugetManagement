	private void OnAutoRefreshTimer(object? state)
	{
		_ = InvokeAsync(async () => await RefreshAsync().ConfigureAwait(false));
	}

	/// <summary>
	/// Clears the lingering "Done" progress message after a short delay so the indicator
	/// doesn't vanish the instant a refresh completes.
	/// </summary>
	private void ScheduleDoneClear()
	{
		_doneClearTimer?.Dispose();
		_doneClearTimer = new System.Threading.Timer(
			_ => InvokeAsync(() =>
			{
				_showDone = false;
				_progressMessage = string.Empty;
				StateHasChanged();
			}),
			null,
			2500,
			Timeout.Infinite);
	}

	private string GetProgressIndicatorText()
	{
		if (!string.IsNullOrWhiteSpace(_progressMessage))
		{
			return _progressMessage;
		}

		if (_isAssessing)
		{
			return "Assessing...";
		}

		if (_isLoading)
		{
			return "Refreshing packages...";
		}

		return "Working...";
	}

	private IGitHubClient CreateGitHubClient()
	{
		var client = new GitHubClient(new ProductHeaderValue("PanoramicData.NugetManagement.Web"));
		if (_accessToken is not null)
		{
			client.Credentials = new Credentials(_accessToken);
		}

		return client;
	}

	/// <summary>
	/// Assesses the given repositories in parallel with a bounded degree of concurrency. All console
	/// and table/UI mutation is marshalled onto the renderer's synchronization context via InvokeAsync
	/// so shared state is only ever touched from one context.
	/// </summary>
	private async Task AssessInParallelAsync(
		IReadOnlyList<RepositoryDashboardRow> assessable,
		Func<RepositoryDashboardRow, Task> assessOne,
		IProgress<string>? progress = null,
		CancellationToken cancellationToken = default)
	{
		const int maxConcurrency = 10;
		using var gate = new SemaphoreSlim(maxConcurrency);
		var completed = 0;

		var tasks = assessable.Select(async row =>
		{
			await gate.WaitAsync(CancellationToken.None);
			try
			{
				// Assessment writes nothing, so a stop needs no revert: the rows not yet reached are
				// simply left as they were.
				if (cancellationToken.IsCancellationRequested)
				{
					return;
				}

				await assessOne(row);
			}
			catch (Exception ex)
			{
				await InvokeAsync(() => AppendConsole($"❌ {row.RepositoryFullName}: {ex.Message}"));
			}
			finally
			{
				gate.Release();
				row.IsReassessing = false;
				var n = Interlocked.Increment(ref completed);
				_progressMessage = $"Assessing ({n}/{assessable.Count})...";
				progress?.Report($"repo {n} of {assessable.Count}");

				// Table and progress counter only. Rebuilding the navigation tree here — which is what
				// RefreshTableAsync also does — tears down every node and re-expands them one by one,
				// so doing it per completed row meant dozens of full rebuilds: the tree flickered and
				// the scrollbar jumped as its height changed under the pointer. The tree is rebuilt
				// once when the whole run finishes instead.
				await InvokeAsync(RefreshRowsOnlyAsync);
			}
		});

		await Task.WhenAll(tasks);
		cancellationToken.ThrowIfCancellationRequested();
	}

	/// <summary>
	/// Refreshes the table and the progress counter without touching the navigation tree.
	/// Used for per-row updates during a long assessment; see the note in AssessInParallelAsync.
	/// </summary>
	private async Task RefreshRowsOnlyAsync()
	{
		if (_table is not null)
		{
			await _table.RefreshAsync().ConfigureAwait(true);
		}

		StateHasChanged();
	}

	private async Task RefreshAsync()
	{
		if (!await ConfirmApiBudgetAsync("Refreshing the package list and re-assessing", EstimateRemoteAssessmentCost(_rows)))
		{
			return;
		}

		EnqueueWork(
			"Refresh every organisation",
			null,
			"refresh:*",
			RefreshCoreAsync);
	}

	private async Task RefreshCoreAsync(IProgress<string> progress, CancellationToken cancellationToken)
	{
		_isLoading = true;
		_isDiscovering = true;
		NavDataProvider.IsLoading = true;
		_progressMessage = "Discovering packages...";
		StateHasChanged();

		try
		{
			AppendConsole("▶ Discovering packages...");
			var freshRows = await Dashboard.DiscoverPackagesAsync(cancellationToken: cancellationToken);

			ReportUnreadNuspecs();

			var existingByPackageId = _rows
				.Where(r => r.Assessment is not null)
				.ToDictionary(r => r.RepositoryFullName, StringComparer.OrdinalIgnoreCase);

			foreach (var row in freshRows)
			{
				if (existingByPackageId.TryGetValue(row.RepositoryFullName, out var existing))
				{
					row.Assessment = existing.Assessment;
					row.CategorySummaries = existing.CategorySummaries;
				}
			}

			_rows = freshRows;
			Cache.SetRows(_rows);

			var github = CreateGitHubClient();
			var assessable = _rows
				.Where(r => r.IsGoverned)
				.Where(r => r.RepositoryFullName is not null)
				.Where(r => !RuntimeSettings.IsRepositoryExcluded(r.RepositoryFullName))
				.ToList();

			// Mark them pending before the tree is rebuilt, so the new list appears already showing a
			// spinner per repository.
			foreach (var row in assessable)
			{
				row.IsReassessing = true;
			}

			// Discovery is done: the per-repository spinners take over. This is the one tree rebuild
			// mid-run; the tree then stays still until the assessment finishes.
			//
			// The rebuild happens while still dimmed, and the dim is lifted afterwards. Order matters:
			// the rebuild replaces the node elements, so clearing the flag first would render the new
			// ones already at full opacity with no previous value to animate from, and the dim would
			// snap off instead of fading.
			_progressMessage = "Assessing...";
			AppendConsole($"▶ Assessing {assessable.Count} repositories...");
			await RefreshTableAsync();

			_isDiscovering = false;
			StateHasChanged();

			await AssessInParallelAsync(assessable, async row =>
			{
				if (row.IsClonedLocally && row.LocalPath is not null)
				{
					await Dashboard.AssessLocalRepositoryAsync(row, cancellationToken, github);
					await Dashboard.RefreshGitStatusAsync(row, cancellationToken);
				}
				else
				{
					await Dashboard.AssessRepositoryAsync(row, github, cancellationToken);
				}
			}, progress, cancellationToken);

			Cache.Update(_rows);
			_lastRefreshUtc = Cache.LastRefreshUtc;
			AppendConsole($"✅ Refreshed {_rows.Count} packages, assessed {assessable.Count} repositories.");
			// Keep the final count message but append " Done" and persist it for a couple of
			// seconds instead of the indicator vanishing the instant it hits 100%.
			_progressMessage += " Done";
			_showDone = true;
			ScheduleDoneClear();
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Failed to refresh dashboard");
			AppendConsole($"❌ Refresh failed: {ex.Message}");
			_progressMessage = $"Error: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
			_isDiscovering = false;
			NavDataProvider.IsLoading = false;

			// Any rows still flagged pending (e.g. after an early exit) must be cleared, or they would
			// keep their spinner icon indefinitely.
			foreach (var row in _rows)
			{
				row.IsReassessing = false;
			}

			await ReloadTreePreservingExpansionAsync();
			StateHasChanged();
		}
	}

	private async Task RefreshTableAsync()
	{
		if (_table is not null)
		{
			await _table.RefreshAsync().ConfigureAwait(true);
		}

		await ReloadTreePreservingExpansionAsync();

		StateHasChanged();
	}

	private void OnRowClick(RepositoryDashboardRow row)
	{
