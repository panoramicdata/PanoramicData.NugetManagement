	private void NavigateToAppSettings()
	{
		// Refilled on each visit, so the page always opens showing what is stored rather than whatever was
		// half-typed and abandoned last time.
		LoadOllamaDraft();

		_currentView = NavView.AppSettings;
		_selectedRow = null;
		_selectedPackageId = null;
		_selectedCategory = null;
		_selectedRuleId = null;

		// These settings belong to no organisation, so the breadcrumb must not keep one. Arriving from
		// an organisation's own Settings page previously left it selected, giving
		// "Dashboard > panoramicsystems > Application settings" — which is precisely the impression
		// that splitting the two pages was meant to remove.
		_orgSelected = false;
