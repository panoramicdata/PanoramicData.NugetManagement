	/// <summary>
	/// Ensures <c>_selectedRow</c> points to the current object in <c>_rows</c>.
	/// After <see cref="RefreshAsync"/> replaces <c>_rows</c> with fresh objects,
	/// <c>_selectedRow</c> can become stale. This method re-resolves the reference
	/// and, when the old and new objects differ, copies any assessment data across
	/// so that in-flight mutations are not lost.
	/// </summary>
	private void EnsureSelectedRowIsCurrent()
	{
		if (_selectedRow is null)
		{
			return;
		}

		var current = _rows.FirstOrDefault(r =>
			string.Equals(r.RepositoryFullName, _selectedRow.RepositoryFullName, StringComparison.OrdinalIgnoreCase));

		if (current is null)
		{
			return;
		}

		if (!ReferenceEquals(current, _selectedRow))
		{
			// Carry forward any assessment already on the old reference
			if (_selectedRow.Assessment is not null && current.Assessment is null)
			{
				current.Assessment = _selectedRow.Assessment;
				current.CategorySummaries = _selectedRow.CategorySummaries;
				current.Status = _selectedRow.Status;
				current.StatusMessage = _selectedRow.StatusMessage;
			}

			_selectedRow = current;
		}
	}

	private async Task PersistSelectedRowUpdateAsync()
	{
		if (_selectedRow is null)
		{
			return;
		}

		await PersistRowUpdateAsync(_selectedRow);
	}

	/// <summary>
	/// Writes a row's newly assessed state back to the table and the cache. Takes the row explicitly
	/// because queued work outlives the selection that started it — by the time it runs, the user may
	/// be looking at something else.
	/// </summary>
	private async Task PersistRowUpdateAsync(RepositoryDashboardRow row)
	{
		var rowIndex = _rows.FindIndex(r => string.Equals(r.RepositoryFullName, row.RepositoryFullName, StringComparison.OrdinalIgnoreCase));
		if (rowIndex >= 0)
		{
			_rows[rowIndex] = row;
		}

		Cache.UpsertRow(row);
		_lastRefreshUtc = Cache.LastRefreshUtc;
		await RefreshTableAsync();
	}

   private bool IsStepRunning(WorkflowStep step)
		=> _activeWorkflowStep == step && (_isRunning || _isAssessing || _isLoading);

	/// <summary>
	/// The earliest workflow step queued or running for the selected repository, or null when nothing
	/// is outstanding for it. Read live from the queue rather than cached, so work started in another
	/// browser tab closes the buttons here too.
	/// </summary>
	private WorkflowStep? FirstQueuedStep
		=> _selectedRow?.RepositoryFullName is { Length: > 0 } name
			? WorkflowGate.FirstBlockedStep(Lanes.ItemsFor($"repo:{name.ToLowerInvariant()}"), name)
			: null;

	/// <summary>
	/// Whether a toolbar step is closed because it, or something before it, is queued for this
	/// repository. Everything downstream of queued work is guesswork until that work has run.
	/// </summary>
	private bool IsStepQueueBlocked(WorkflowStep step) => WorkflowGate.IsBlocked(step, FirstQueuedStep);

	/// <summary>
	/// The tooltip for a step, replaced by the reason it is greyed out when it is. A disabled button
	/// with its usual tooltip tells the user nothing about why they cannot press it.
	/// </summary>
	private string GatedTooltip(WorkflowStep step, string defaultToolTip)
	{
		if (FirstQueuedStep is not { } blocking || !WorkflowGate.IsBlocked(step, blocking))
		{
			return defaultToolTip;
		}

		var name = GetWorkflowStepDisplayName(blocking);
		return step == blocking
			? $"{name} is already queued for this repository"
			: $"Waiting for {name} to finish — it may change what this step would do";
	}

	private static string GetWorkflowStepDisplayName(WorkflowStep step) => step switch
	{
		WorkflowStep.GitSync => "Git Sync",
		WorkflowStep.Reassess => "Re-assess",
		WorkflowStep.Fix => "Fix",

		// "Fix in IDE" rather than "Fix with AI": what distinguishes this step is that it hands the
		// problem to a frontier model in an editor, and "Fix with AI" now belongs to the local model that
		// does the work here without one. The enum member keeps its name — WorkflowStep is persisted in
		// the work queue, so renaming it would strand items queued by an earlier build.
		WorkflowStep.FixWithAi => "Fix in IDE",
		WorkflowStep.Build => "Build",
		WorkflowStep.Test => "Test",
		WorkflowStep.CommitAndPush => "Commit & Push",
		WorkflowStep.Publish => "Publish",
		_ => step.ToString()
	};

	private string GetToolbarStepText(WorkflowStep step)
		=> IsStepRunning(step) ? $"{GetWorkflowStepDisplayName(step)}..." : GetWorkflowStepDisplayName(step);

	private static string GetToolbarStepIconCss(WorkflowStep step, bool isRunning) => isRunning
		? "fas fa-spinner fa-spin"
		: step switch
		{
			WorkflowStep.GitSync => "fas fa-arrows-rotate",
			WorkflowStep.Reassess => "fas fa-sync-alt",
			WorkflowStep.Fix => "fas fa-wrench",
			WorkflowStep.FixWithAi => "fas fa-magic",
			WorkflowStep.Build => "fas fa-hammer",
			WorkflowStep.Test => "fas fa-flask",
			WorkflowStep.CommitAndPush => "fas fa-cloud-upload-alt",
			WorkflowStep.Publish => "fas fa-rocket",
			_ => "fas fa-play"
		};

	private string GetToolbarStepCssClass(WorkflowStep step)
	{
		var baseClass = GetStepCssClass(step);
		return IsStepRunning(step)
			? string.IsNullOrEmpty(baseClass) ? "toolbar-step-running" : $"{baseClass} toolbar-step-running"
			: baseClass;
