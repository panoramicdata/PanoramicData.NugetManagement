		return _selectedRow.Assessment.RuleResults
			.Where(r => !r.Passed)
			.GroupBy(r => r.Category)
			.Select(g => new CategoryGroup { Category = g.Key, Failures = [.. g.OrderBy(r => SeverityColorRank(r.Severity)).ThenBy(r => r.RuleId)] })
