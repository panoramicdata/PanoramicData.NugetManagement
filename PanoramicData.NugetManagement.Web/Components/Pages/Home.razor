@page "/"
@page "/{PackageId?}"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.Extensions.Options
@using Octokit
@rendermode InteractiveServer
@inject DashboardService Dashboard
@inject DashboardCacheService Cache
@inject PackageDashboardDataProvider DataProvider
@inject NavTreeDataProvider NavDataProvider
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Home> Logger
@inject IJSRuntime JS
@inject IOptions<AppSettings> SettingsOptions
@inject RuntimeSettingsService RuntimeSettings
@inject PanoramicData.NugetManagement.Web.Remediations.RemediationRegistry Remediations
@inject IdeDetectionService IdeDetection
@inject LocalFileSystemDataProvider FileSystemDataProvider
@inject LocalRepoService LocalRepo
@inject WorkLaneService Lanes
@inject WorkFanOut FanOut
@inject WorkRunnerService Runner
@inject RegressionGuardService RegressionGuard
@inject UiConsoleLogSink LogSink
@inject GitHubTokenProvider GitHubTokens
@implements IDisposable

<PageTitle>NuGet Governance</PageTitle>

@if (!_isAuthenticated)
{
	<div class="login-page">
		<div class="login-card">
			<div class="login-icon">📦</div>
			<h1>NuGet Governance</h1>
			<p>Sign in with GitHub to assess and remediate your organization's NuGet packages.</p>
			<a href="/login" class="btn btn-primary btn-login"><i class="fas fa-key"></i> Sign in with GitHub</a>
		</div>
	</div>
}
else
{
	<div class="spa-body">
		<PDSplitter Direction="SplitDirection.Horizontal" GutterSize="4" ExpandToMin="true">

			<!-- Left: Navigation panel (logo at top, filter, tree below) -->
				<PDSplitPanel Size="1" MinSize="240" CssClass="spa-panel spa-nav-panel">
					<div class="nav-tree-container">
						@* The brand doubles as "home", the usual convention. Only the text is the link: making the
						   whole header a hit area tinted the entire cell on hover, which read as a selectable row
						   rather than a link. *@
						<div class="nav-brand-header">
							<span class="brand-icon">📦</span>
							<span class="brand-text nav-brand-link"
								  role="button"
								  tabindex="0"
								  title="Back to the home page"
								  @onclick="NavigateToDashboard"
								  @onkeydown="OnBrandKeyDown">NuGet Governance</span>
						</div>
						<div class="nav-tree-filter">
							<div class="input-group input-group-sm">
								<span class="input-group-text"><i class="fas fa-filter"></i></span>
								<input type="text"
									   class="form-control form-control-sm"
									   placeholder="Filter repos (regex)..."
									   value="@_treeFilterText"
									   @oninput="OnTreeFilterInput" />
								@if (!string.IsNullOrEmpty(_treeFilterText))
								{
									<button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ClearTreeFilter" title="Clear filter">
										<i class="fas fa-times"></i>
									</button>
								}
							</div>
							<label class="nav-tree-local-toggle" title="Show only locally-cloned repositories">
								<input type="checkbox" checked="@_localOnly" @onchange="OnLocalOnlyChanged" />
								<span>Local only</span>
							</label>
							@if (_treeFilterError is not null)
							{
								<div class="filter-error">@_treeFilterError</div>
							}
						</div>
						@* The tree fills the whole area below the filter now that work hangs off the node it
						   acts on rather than in a queue pane of its own. *@
						<div class="nav-split-area">
									<div class="nav-tree-scroll">
										<PDTree @ref="_navTree"
												TItem="NavItem"
												DataProvider="NavDataProvider"
												KeyField="x => x.Key"
												ParentKeyField="x => x.ParentKey!"
												TextField="x => x.Text"
												IsLeaf="x => x.IsLeaf"
												IconCssClass="(item, _) => string.Empty"
												ToolTip="GetNavItemTooltip"
												AllowSelection="true"
												ShowRoot="true"
												Sort="NavTreeDataProvider.CompareNavItems"
												BeforeSelectionChange="OnNavBeforeSelect"
												SelectionChange="OnNavSelectionChanged"
												NodeExpanded="OnNavNodeExpanded"
												NodeCollapsed="OnNavNodeCollapsed"
												Ready="OnNavTreeReady">
												<NodeTemplate Context="node">
													<span class="nav-node-label @(node.Data is not null && NavTreeDataProvider.IsContainerNode(node.Data) ? "nav-node-container" : null) @(IsNodeDimmedByRediscovery(node.Data) ? "rediscovering" : null) @(node.Data?.IsExcluded == true ? "nav-node-excluded" : null)" @onclick="() => OnNavNodeActivated(node)" title="@(node.Data is null ? null : GetNavItemTooltip(node.Data))">
														<i class="@GetNodeIconCss(node.Data)"></i>@node.Data?.Text
													</span>
													@if (node.Data?.GuardStateNeedingAttention is { } guardState)
													{
														<i class="fas @GuardMarkerIcon(guardState) nav-guard-marker" title="@GuardMarkerTooltip(guardState)"></i>
													}
													@* The repository node only. Every node beneath it carries the repository too,
													   but excluding one from governance is not something a package, a category
													   or a rule can do. *@
													@* Git state and build state, on the right, as badges of their own. Neither is a
													   rule failure, so neither belongs in the health glyph on the left — a red
													   glyph that could mean "fails a rule" or "does not build" means neither. *@
													@if (node.Data is not null && NavTreeDataProvider.IsRepositoryNode(node.Data))
													{
														<span class="nav-node-state">
															<i class="fas @RepositoryStateBadges.GitIcon(node.Data) nav-state-badge" title="@RepositoryStateBadges.GitTooltip(node.Data)"></i>
															<i class="fas @RepositoryStateBadges.BuildIcon(node.Data) nav-state-badge" title="@RepositoryStateBadges.BuildTooltip(node.Data)"></i>
														</span>
													}
													@if (node.Data is not null && NavTreeDataProvider.IsRepositoryNode(node.Data) && node.Data.RepositoryFullName is { Length: > 0 } repositoryFullName)
													{
														<span class="nav-org-actions">
															<button type="button" class="nav-org-action-btn" title="@(node.Data.IsExcluded ? "Bring this repository back into governance" : "Exclude this repository from governance")" @onclick="() => ToggleRepositoryExcludedAsync(repositoryFullName, node.Data.IsExcluded)" @onclick:stopPropagation @onmousedown:stopPropagation>
																<i class="fas @(node.Data.IsExcluded ? "fa-eye" : "fa-eye-slash")"></i>
															</button>
														</span>
													}
													@if (AffectedRepoCountFor(node.Data) is { } affected)
													{
														@* Without this, seven repositories and one look identical: the node is orange
														   either way, so a run that fixed six of them appears to have done nothing. *@
														<span class="nav-node-count" title="@affected affected repositor@(affected == 1 ? "y" : "ies")">@affected</span>
													}
													@if (ShouldSpinOrgNode(node.Data))
													{
														@* The only progress indicator in the tree, and it mirrors whichever button
														   started the run: a searching magnifier while discovering, the recycle
														   icon while assessing. *@
														@if (_isDiscovering)
														{
															@* 7px rather than the usual 6px: the sweep carries it 2.5px left, and the extra
															   pixel keeps it clear of the organisation name at that extreme. *@
															<i class="fas fa-magnifying-glass nav-org-searching" style="margin-left:7px;font-size:0.8rem;color:var(--text-muted);" title="@GetProgressIndicatorText()"></i>
														}
														else
														{
															<i class="fas fa-sync-alt fa-spin" style="margin-left:6px;font-size:0.8rem;color:var(--text-muted);" title="@GetProgressIndicatorText()"></i>
														}
													}
													@if (node.Data?.Key == NavTreeDataProvider.OrganisationsKey)
													{
														@* Add-only by design: removing an organisation lives at the bottom of its own
														   Settings screen, where a destructive action is harder to hit by accident. *@
														<span class="nav-org-actions">
															<button type="button" class="nav-org-action-btn" title="Add an organisation" @onclick="OpenAddOrganizationDialog" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-plus"></i></button>
															@* Application-wide settings hang off Organisations, the level they actually
															   apply to, mirroring how each organisation's cog sits on its own node. *@
															<button type="button" class="nav-org-action-btn @(_currentView == NavView.AppSettings ? "active" : "")" title="Application settings — these apply to every organisation" @onclick="NavigateToAppSettings" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-cog"></i></button>
														</span>
													}
													@if (IsOrgRootNode(node.Data))
													{
														<span class="nav-org-actions">
															@* Run-something actions first, then a gap, then the clone and settings pair. *@
															<button type="button" class="nav-org-action-btn" title="Rediscover this organisation's packages from NuGet, then assess them" @onclick="() => RediscoverOrganizationAsync(node.Data!.Organization)" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-magnifying-glass"></i></button>
															<button type="button" class="nav-org-action-btn nav-org-action-group-end" title="Re-assess every repository in this organisation, without re-reading the package list from NuGet" @onclick="() => ReassessOrganizationAsync(node.Data!.Organization)" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-sync-alt"></i></button>
															@if (_isCloningAll && _cloningOrganization == node.Data!.Organization)
															{
																<button type="button" class="nav-org-action-btn active" title="Stop cloning" @onclick="CancelCloneAll" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-stop"></i></button>
															}
															else
															{
																<button type="button" class="nav-org-action-btn" title="@GetCloneAllTooltip()" @onclick="() => OpenCloneDialogAsync(node.Data!.Organization)" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-cloud-arrow-down"></i></button>
															}
															<button type="button" class="nav-org-action-btn @(_currentView == NavView.Settings && _selectedOrganization == node.Data!.Organization ? "active" : "")" title="Organization settings" @onclick="() => NavigateToSettingsAsync(node.Data!.Organization)" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-cog"></i></button>
														</span>
													}
													@if (node.Data?.WorkItemId is { Length: > 0 } workItemId)
													{
														<span class="nav-work-item">
															@if (node.Data.WorkItemProgress is { Length: > 0 } workProgress)
															{
																<span class="nav-work-progress">@workProgress</span>
															}
															@if (node.Data.WorkItemState == WorkItemState.Running)
															{
																<button type="button" class="nav-org-action-btn" title="Stop, reverting anything half-applied" @onclick="() => Lanes.Cancel(workItemId)" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-stop"></i></button>
															}
															else if (node.Data.WorkItemState == WorkItemState.Pending)
															{
																<button type="button" class="nav-org-action-btn" title="Remove from the queue" @onclick="() => Lanes.Remove(workItemId)" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-xmark"></i></button>
															}
														</span>
													}
													else if (node.Data?.LaneKey is { Length: > 0 } laneKey && node.Data.WorkItemId is null && !node.Data.IsLeaf)
													{
														<span class="nav-org-actions">
															@* On the organisation's work node this stops every lane beneath it, which is
															   what replaces stopping a bulk action that used to be one item.
															   Only when something is under it: a repository's work node is permanent, so
															   without the leaf check every clear repository would offer a stop button
															   with nothing to stop. *@
															<button type="button" class="nav-org-action-btn" title="@(node.Data.RepositoryFullName is null ? "Stop all work in this organisation" : "Stop all work on this repository")" @onclick="() => StopLane(node.Data)" @onclick:stopPropagation @onmousedown:stopPropagation><i class="fas fa-stop"></i></button>
														</span>
													}
												</NodeTemplate>
											</PDTree>
									</div>
						</div>
						<div class="nav-footer">
							<a href="/ci-template" class="nav-footer-link">
								<i class="fas fa-file-code"></i> CI Workflow Template
							</a>
						</div>
					</div>
				</PDSplitPanel>

			<!-- Centre: Breadcrumbs + Toolbar + Content + Console -->
			<PDSplitPanel Size="3" MinSize="400" CssClass="spa-panel spa-content-panel">
				<div class="centre-column">

					<!-- Breadcrumb bar at the very top -->
					<div class="breadcrumb-bar">
						<div class="breadcrumb-trail">
							@* The root is Home: guidance, not figures. The estate overview is the Organisations
							   crumb below, since that is the node whose scope is every organisation. *@
							@if (_currentView is NavView.Home or NavView.None && !_orgSelected && _selectedRow is null)
							{
								<span class="breadcrumb-current"><i class="fas fa-house"></i><span class="breadcrumb-link-text">Home</span></span>
							}
							else
							{
								<a class="breadcrumb-link" @onclick="NavigateToDashboard" @onclick:preventDefault>
									<i class="fas fa-house"></i><span class="breadcrumb-link-text">Home</span>
								</a>
							}
							@if (_currentView == NavView.Dashboard)
							{
								<span class="breadcrumb-sep">›</span>
								<span class="breadcrumb-current">Organisations</span>
							}
							@* Org crumb — shown at org level or deeper (repo selected, or org settings) *@
							@if (_orgSelected || _selectedRow is not null || _currentView == NavView.Settings || IsIssueView || IsEstateWide)
							{
								<span class="breadcrumb-sep">›</span>
								@if (_orgSelected && _selectedRow is null && _currentView != NavView.Settings)
								{
									<span class="breadcrumb-current">@CurrentOrganization</span>
								}
								else
								{
									<a class="breadcrumb-link" @onclick="NavigateToOrgAsync" @onclick:preventDefault>
										<span class="breadcrumb-link-text">@CurrentOrganization</span>
									</a>
								}
							}
							@if (_currentView == NavView.AppSettings)
							{
								<span class="breadcrumb-sep">›</span>
								<span class="breadcrumb-current">Application settings</span>
							}
							@* The estate has no repository crumb of its own to inherit — it stands for all of
							   them — so it names itself here or the trail stops at the organisation. *@
							@if (IsEstateWide)
							{
								<span class="breadcrumb-sep">›</span>
								<span class="breadcrumb-current">Repositories</span>
							}
							@if (_selectedRow is not null)
							{
								<span class="breadcrumb-sep">›</span>
								@if (_currentView == NavView.PackageDetail)
								{
									@* Repo is the active page — show as current, not clickable *@
									<span class="breadcrumb-current breadcrumb-repo">
										<i class="@GetPackageHealthIcon(_selectedRow)"></i><span class="breadcrumb-repo-name">@_selectedRow.RepositoryName</span><span class="pkg-version">@PackagesSummary(_selectedRow)</span>
									</span>
								}
								else
								{
									@* Repo is an ancestor crumb — click to return to it *@
									<a class="breadcrumb-link breadcrumb-repo" @onclick="NavigateToSelectedPackage" @onclick:preventDefault>
										<i class="@GetPackageHealthIcon(_selectedRow)"></i><span class="breadcrumb-repo-name">@_selectedRow.RepositoryName</span><span class="pkg-version">@PackagesSummary(_selectedRow)</span>
									</a>
								}
								@if (_selectedRow.IsClonedLocally && _currentView != NavView.Settings)
								{
									<span class="breadcrumb-sep">|</span>
									@if (_selectedRow.IsWorkingTreeClean == false)
									{
										<span class="git-dirty-badge" title="Working tree has uncommitted changes">● Dirty</span>
									}
									else if (_selectedRow.IsWorkingTreeClean == true)
									{
										<span class="git-clean-badge" title="Working tree is clean">● Clean</span>
									}
									@if (_selectedRow.CurrentBranch is not null)
									{
										<span class="@(_selectedRow.CurrentBranch == "main" ? "git-clean-badge" : "git-dirty-badge")" title="Current branch">⎇ @_selectedRow.CurrentBranch</span>
									}
									@if (_selectedRow.IsSyncedWithOrigin == false)
									{
										<span class="git-dirty-badge" title="@SyncBadgeTooltip("Not in sync with origin")">⇅ Out of sync</span>
									}
									else if (IsRecentlyConfirmedInSync(_selectedRow))
									{
										<span class="git-clean-badge" title="@SyncBadgeTooltip("In sync with origin")">⇅ Synced</span>
									}
									else if (_selectedRow.IsSyncedWithOrigin == true)
									{
										@* Same fact the Sync button gates on, so the two cannot contradict each other: while
										   this shows unconfirmed, Sync is available, and vice versa. *@
										<span class="git-unknown-badge" title="@UnconfirmedSyncBadgeTooltip">⇅ Synced?</span>
									}
									@if (_selectedRow.AllPackagesMatchTag)
									{
										<span class="git-clean-badge" title="Every published package matches latest tag @_selectedRow.LatestTag">📦 @_selectedRow.LatestTag ✓</span>
									}
									else if (_selectedRow.AnyPackageOutOfStepWithTag)
									{
										@* Named, not counted: with four packages on one repository, a bare count of one
										   out of step leaves the reader to open each in turn to find which. *@
										<span class="git-dirty-badge" title="@OutOfStepTooltip(_selectedRow)">📦 tag @TagOrUnknown(_selectedRow) ≠ @OutOfStepSummary(_selectedRow)</span>
									}
								}
								@if (_selectedCategory is not null)
								{
									<span class="breadcrumb-sep">›</span>
									<span class="breadcrumb-current" title="@_selectedCategory">@_selectedCategory</span>
								}
								@if (_selectedRuleId is not null)
								{
									<span class="breadcrumb-sep">›</span>
									<span class="breadcrumb-current" title="@_selectedRuleId">@_selectedRuleId</span>
								}
                           }
							@if (_currentView == NavView.Settings)
							{
								<span class="breadcrumb-sep">›</span>
								<span class="breadcrumb-current">Settings</span>
							}
							@if (IsIssueView)
							{
								<span class="breadcrumb-sep">›</span>
								@if (_currentView == NavView.Issues)
								{
									<span class="breadcrumb-current">Issues</span>
								}
								else
								{
									@* Deeper in the issue hierarchy: Issues stays clickable so the whole
									   list is one hop away. *@
									<a class="breadcrumb-link" @onclick="NavigateToIssuesAsync" @onclick:preventDefault>
										<span class="breadcrumb-link-text">Issues</span>
									</a>
									<span class="breadcrumb-sep">›</span>
									@if (_currentView == NavView.IssueCategoryDetail)
									{
										<span class="breadcrumb-current">@_selectedCategory</span>
									}
									else
									{
										<a class="breadcrumb-link" @onclick="NavigateToIssueCategoryAsync" @onclick:preventDefault>
											<span class="breadcrumb-link-text">@_selectedCategory</span>
										</a>
										<span class="breadcrumb-sep">›</span>
										<span class="breadcrumb-current">@_selectedRuleId</span>
									}
								}
							}
						</div>
						<div class="breadcrumb-right">
							@if (_isLoading || _isAssessing || _showDone)
							{
								<span class="progress-indicator">@if (!_showDone) {<span class="spinner"></span>} @GetProgressIndicatorText()</span>
							}
							<div class="user-menu">
								<button type="button" class="btn btn-xs btn-breadcrumb" @onclick="() => _userMenuOpen = !_userMenuOpen" title="Account">
									<i class="fas fa-user"></i> @_userName <i class="fas fa-caret-down"></i>
								</button>
								@if (_userMenuOpen)
								{
									<div class="user-menu-backdrop" @onclick="() => _userMenuOpen = false"></div>
									<div class="user-menu-dropdown">
										<button type="button" class="user-menu-item" @onclick="NavigateToAppSettings">
											<i class="fas fa-cog"></i> Application settings
										</button>
										<a href="/logout" class="user-menu-item">
											<i class="fas fa-right-from-bracket"></i> Log out
										</a>
									</div>
								}
							</div>
						</div>
					</div>

					<!-- Toolbar — workflow order: Git Sync → Re-assess → Fix → Build → Test → Commit & Push → Publish -->
						<PDToolbar CssClass="main-toolbar">
							<PDToolbarButton Key="refresh"
											 Text="@(_orgSelected ? "Rediscover Org" : "Rediscover Orgs")"
											 IconCssClass="fas fa-magnifying-glass"
											 CssClass="btn-primary"
											 IsVisible="@ShowBulkRunButtons"
											 IsEnabled="true"
											 ToolTip="@(_orgSelected
												? $"Re-read {CurrentOrganization}'s package list from NuGet, then assess it. Use Re-assess Org to skip the NuGet lookup."
												: "Re-read every organisation's package list from NuGet, then assess everything. Use Re-assess Orgs to skip the NuGet lookup.")"
											 Click="OnToolbarClick" />

							<PDToolbarButton Key="git-sync"
											 Text="Sync"
											 IconCssClass="fas fa-arrows-rotate"
											 CssClass="@GetStepCssClassFull(WorkflowStep.GitSync)"
											 IsVisible="@(HasToolbarTarget && _currentView != NavView.Settings)"
											 IsEnabled="@(IsEstateWide ? IsLocalStepEnabled(WorkflowStep.GitSync) : (IsSyncEnabled() && !IsStepQueueBlocked(WorkflowStep.GitSync)))"
											 ToolTip="@GatedTooltip(WorkflowStep.GitSync, GetSyncTooltip())"
											 Click="OnToolbarClick" />

							@if (ShowWorkflowFlow)
							{
								<span class="@FlowChevronCss(WorkflowStep.GitSync)">›</span>
							}

							<PDToolbarButton Key="reassess"
											 Text="@GetReassessButtonText()"
											 IconCssClass="fas fa-sync-alt"
											 CssClass="@GetStepCssClassFull(WorkflowStep.Reassess)"
											 IsVisible="@(ShowBulkRunButtons || _currentView is NavView.Repositories or NavView.RepositoryDetail or NavView.PackageDetail or NavView.CategoryDetail or NavView.RuleDetail)"
											 IsEnabled="@(!IsBlockedByOutOfSync && !IsStepQueueBlocked(WorkflowStep.Reassess))"
											 ToolTip="@GatedTooltip(WorkflowStep.Reassess, IsBlockedByOutOfSync ? OutOfSyncBlockedTooltip : GetReassessButtonTooltip())"
											 Click="OnToolbarClick" />

							@if (ShowWorkflowFlow)
							{
								<span class="@FlowChevronCss(WorkflowStep.Reassess)">›</span>
							}

							@* The one button that fixes things, shown wherever there is something beneath the
							   selection to fix. FixScope decides what that means, so a view is added there
							   rather than to a list here — a literal list is what made this button vanish
							   before. Note: a Razor comment cannot go between a component's attributes; it
							   compiles and then throws at render as an unknown parameter name. *@
							<PDToolbarButton Key="fix"
											 Text="Fix"
											 IconCssClass="fas fa-wrench"
											 CssClass="@GetStepCssClassFull(WorkflowStep.Fix)"
											 IsVisible="@(FixScope.For(_currentView).HasAnything && HasToolbarTarget)"
											 IsEnabled="@IsFixEnabled()"
											 ToolTip="@GatedTooltip(WorkflowStep.Fix, GetFixAllTooltip())"
											 Click="OnToolbarClick" />

							@* A second fixing button, which the one-Fix-button rule would normally forbid — but the
							   two are disjoint by construction: Fix does what a deterministic remediation can do, and
							   this does only what nothing else can. AiFixCandidates is the same complement that
							   decides what gets queued, so the button is absent exactly when it would do nothing. *@
							<PDToolbarButton Key="fix-with-ai"
											 Text="Fix with AI"
											 IconCssClass="fas fa-robot"
											 IsVisible="@(_selectedRow is not null && AiFixCandidateCount() > 0)"
											 IsEnabled="@IsFixWithAiEnabled()"
											 ToolTip="@GetFixWithAiTooltip()"
											 Click="OnToolbarClick" />

							@if (ShowWorkflowFlow)
							{
								<span class="@FlowChevronCss(WorkflowStep.Fix)">›</span>
							}

							<PDToolbarButton Key="build"
											 Text="Build"
											 IconCssClass="fas fa-hammer"
											 CssClass="@GetStepCssClassFull(WorkflowStep.Build)"
											 IsVisible="@(HasToolbarTarget && _currentView != NavView.Settings)"
											 IsEnabled="@IsLocalStepEnabled(WorkflowStep.Build)"
											 ToolTip="@GatedTooltip(WorkflowStep.Build, WorkflowStepTooltip("Build the solution"))"
											 Click="OnToolbarClick" />

							@if (ShowWorkflowFlow)
							{
								<span class="@FlowChevronCss(WorkflowStep.Build)">›</span>
							}

							<PDToolbarButton Key="test"
											 Text="Test"
											 IconCssClass="fas fa-flask"
											 CssClass="@GetStepCssClassFull(WorkflowStep.Test)"
											 IsVisible="@(HasToolbarTarget && _currentView != NavView.Settings)"
											 IsEnabled="@IsLocalStepEnabled(WorkflowStep.Test)"
											 ToolTip="@GatedTooltip(WorkflowStep.Test, WorkflowStepTooltip("Run unit tests"))"
											 Click="OnToolbarClick" />

							@if (ShowWorkflowFlow)
							{
								<span class="@FlowChevronCss(WorkflowStep.Test)">›</span>
							}

							<PDToolbarButton Key="commit-and-push"
											 Text="Commit & Push"
											 IconCssClass="fas fa-cloud-upload-alt"
											 CssClass="@GetStepCssClassFull(WorkflowStep.CommitAndPush)"
											 IsVisible="@(HasToolbarTarget && _currentView != NavView.Settings)"
											 IsEnabled="@IsLocalStepEnabled(WorkflowStep.CommitAndPush)"
											 ToolTip="@GatedTooltip(WorkflowStep.CommitAndPush, WorkflowStepTooltip("Commit changes, fetch, rebase and push to origin"))"
											 Click="OnToolbarClick" />

							@if (ShowWorkflowFlow)
							{
								<span class="@FlowChevronCss(WorkflowStep.CommitAndPush)">›</span>
							}

							@* The one step with no estate-wide form. A package pushed to nuget.org cannot be
							   taken back and its version number can never be reused, so it stays a decision
							   made one repository at a time — see ToolbarScope.AllowsEstateWide. *@
							<PDToolbarButton Key="publish"
										 Text="Publish"
										 IconCssClass="fas fa-rocket"
										 CssClass="@GetPublishCssClass()"
										 IsVisible="@(_selectedRow is not null && _currentView != NavView.Settings)"
										 IsEnabled="@(IsPublishEnabled() && !IsStepQueueBlocked(WorkflowStep.Publish))"
										 ToolTip="@GatedTooltip(WorkflowStep.Publish, GetPublishTooltip())"
										 Click="OnToolbarClick" />

							<PDToolbarPlaceholder ShiftRight="true">
								@if (_selectedRow?.IsClonedLocally == true)
								{
									<span style="display:inline-flex" title="@GetOpenIdeTooltip()">
										<button class="btn toolbar-action-btn"
												@onclick="() => OpenInIde()"
												disabled="@(!IsOpenIdeEnabled())">
											<i class="fas fa-code"></i>
										</button>
									</span>
								}
								@if (_selectedRow is not null && _currentView != NavView.Settings)
								{
									<span style="display:inline-flex" title="@GetCombinedPromptTooltip()">
										<button class="btn toolbar-action-btn"
												@onclick="ResolveAllAsync"
												disabled="@(!HasFailuresToPrompt())">
											<i class="fas fa-magic"></i>
										</button>
									</span>
								}
								@if (_selectedRow is not null)
								{
									<span style="display:inline-flex" title="@(string.IsNullOrEmpty(CurrentLastPromptText) ? "No AI prompt generated yet" : "Copy the last generated AI prompt to clipboard")">
										<button class="btn toolbar-action-btn @(CurrentAiClipboardCueStep.HasValue ? "toolbar-ai-ready" : "")"
												@onclick="CopyPromptToClipboardAsync"
												disabled="@string.IsNullOrEmpty(CurrentLastPromptText)">
											<i class="fas fa-copy"></i>
										</button>
									</span>
								}
								<button class="btn toolbar-action-btn @(_consoleVisible ? "btn-console-active" : "")"
										@onclick="ToggleConsole"
										title="Toggle console panel">
									<i class="fas fa-terminal"></i>
								</button>
							</PDToolbarPlaceholder>
						</PDToolbar>

					<!-- Content + optional Console (vertical split when console visible) -->
					@if (_consoleVisible)
					{
						<div class="centre-content-area">
							<PDSplitter Direction="SplitDirection.Vertical" GutterSize="4" ExpandToMin="true">
								<PDSplitPanel Size="3" MinSize="150" CssClass="spa-panel spa-main-content">
									@RenderCurrentView()
								</PDSplitPanel>

								<PDSplitPanel Size="1" MinSize="80" CssClass="spa-panel spa-console-panel">
									@RenderConsolePanel()
								</PDSplitPanel>
							</PDSplitter>
						</div>
					}
					else
					{
						<div class="centre-content-area spa-main-content">
							@RenderCurrentView()
						</div>
					}
				</div>
			</PDSplitPanel>

		</PDSplitter>
	</div>
}

@if (_dialog is not null)
{
	@* Replaces the browser's confirm()/alert(), which some browsers suppress entirely — a suppressed
	   confirm returns false and is indistinguishable from the user declining. *@
	<div class="modal-overlay" @onclick="() => ResolveDialog(false)">
		<div class="modal-box app-dialog" @onclick:stopPropagation="true">
			<h3>
				@if (_dialog.Heading is not null)
				{
					<i class="@(_dialog.IconCssClass ?? "fas fa-circle-info")"></i><span>&nbsp;@_dialog.Heading</span>
				}
				else if (_dialog.IsConfirm)
				{
					<i class="fas fa-circle-question"></i><span>&nbsp;Confirm</span>
				}
				else
				{
					<i class="fas fa-circle-info"></i><span>&nbsp;Notice</span>
				}
			</h3>

			<p class="app-dialog-message">@_dialog.Message</p>

			<div class="modal-actions">
				@if (_dialog.IsConfirm)
				{
					<button class="btn" @onclick="() => ResolveDialog(false)">Cancel</button>
					<button class="btn btn-primary" @onclick="() => ResolveDialog(true)">Continue</button>
				}
				else
				{
					<button class="btn btn-primary" @onclick="() => ResolveDialog(true)">OK</button>
				}
			</div>
		</div>
	</div>
}

@if (_gitAccessProblem is not null)
{
	@* Shown once on load, because every local action starts with a clone: finding out at the point of
	   use means a wall of git errors instead of the one setting that resolves them. *@
	<div class="modal-overlay">
		<div class="modal-box app-dialog git-access-dialog">
			<h3><i class="fas fa-triangle-exclamation"></i><span>&nbsp;git cannot reach GitHub</span></h3>

			@if (_gitAccessProblem.Access == GitRemoteAccess.TlsTrustFailure)
			{
				<p class="app-dialog-message">
					git will not trust the certificate it is being shown for <code>github.com</code>, so it
					cannot clone, fetch or push. This machine trusts that certificate — your browser is fine
					with it — but git uses its own certificate bundle and does not.
				</p>

				@if (_gitAccessProblem.SchannelWouldFix)
				{
					<p class="app-dialog-message">
						Pointing git at the Windows certificate store fixes it. That has been tried on this
						machine just now, and it worked. Run this once, in any terminal:
					</p>

					<div class="git-access-command">
						<code>@GitSchannelCommand</code>
						<button class="btn btn-sm btn-copy @(_gitAccessCommandCopied ? "btn-copied" : null)"
								@onclick="CopyGitAccessCommandAsync"
								title="Copy the command to the clipboard">
							<i class="fas fa-copy"></i>
							<span>&nbsp;@(_gitAccessCommandCopied ? "Copied" : "Copy")</span>
						</button>
					</div>

					<p class="app-dialog-message subtle">
						It changes nothing about which certificates are trusted — only which store git reads
						them from — and it applies to all your git use, not just this app.
					</p>
				}
				else
				{
					<p class="app-dialog-message">
						The usual remedy — pointing git at the Windows certificate store — was tried just now
						and did not work either, so the certificate is not trusted by this machine at all. Your
						IT contact will have the certificate bundle to install; git can then be pointed at it
						with <code>git config --global http.sslCAInfo &lt;path&gt;</code>.
					</p>
				}
			}
			else
			{
				<p class="app-dialog-message">
					git could not reach <code>github.com</code>. Until it can, repositories cannot be cloned,
					synced or pushed — assessment still works, since that goes through the GitHub API.
				</p>
			}

			<details class="git-access-detail">
				<summary>What git reported</summary>
				<pre>@_gitAccessProblem.Detail</pre>
			</details>

			<div class="modal-actions">
				<button class="btn" @onclick="DismissGitAccessDialog">Continue anyway</button>
				<button class="btn btn-primary" @onclick="RecheckGitAccessAsync" disabled="@_isCheckingGitAccess">
					@if (_isCheckingGitAccess)
					{
						<i class="fas fa-spinner fa-spin"></i>
						<span>&nbsp;Checking...</span>
					}
					else
					{
						<span>Check again</span>
					}
				</button>
			</div>
		</div>
	</div>
}

@if (_addOrgDialogOpen)
{
	<div class="modal-overlay" @onclick="CloseAddOrganizationDialog">
		<div class="modal-box add-org-dialog" @onclick:stopPropagation="true">
			<h3><i class="fas fa-plus"></i> Add an organisation</h3>

			<p class="clone-dialog-status">
				The GitHub organisation name, as it appears in its URL — its NuGet packages are
				discovered by the same name.
			</p>

			<input type="text"
				   class="add-org-input"
				   placeholder="e.g. contoso"
				   autocomplete="off"
				   value="@_addOrgName"
				   @oninput="e => _addOrgName = e.Value?.ToString() ?? string.Empty"
				   @onkeydown="OnAddOrgKeyDown"
				   disabled="@_isAddingOrg" />

			@if (_addOrgError is not null)
			{
				<p class="clone-dialog-status error"><i class="fas fa-triangle-exclamation"></i> @_addOrgError</p>
			}

			<div class="modal-actions">
				<button class="btn" @onclick="CloseAddOrganizationDialog" disabled="@_isAddingOrg">Cancel</button>
				<button class="btn btn-primary" @onclick="ConfirmAddOrganizationAsync" disabled="@(_isAddingOrg || string.IsNullOrWhiteSpace(_addOrgName))">
					@if (_isAddingOrg)
					{
						<i class="fas fa-spinner fa-spin"></i>
						<span>&nbsp;Adding...</span>
					}
					else
					{
						<span>Add</span>
					}
				</button>
			</div>
		</div>
	</div>
}

@if (_cloneDialogOpen)
{
	<div class="modal-overlay" @onclick="CloseCloneDialog">
		<div class="modal-box clone-dialog" @onclick:stopPropagation="true">
			<h3><i class="fas fa-cloud-arrow-down"></i> Clone repositories into @_cloneDialogOrganization</h3>

			@if (_isLoadingCloneCandidates)
			{
				<p class="clone-dialog-status"><i class="fas fa-spinner fa-spin"></i> Reading the organisation's repositories from GitHub...</p>
			}
			else if (_cloneCandidatesError is not null)
			{
				<p class="clone-dialog-status error"><i class="fas fa-triangle-exclamation"></i> @_cloneCandidatesError</p>
			}
			else if (_cloneCandidates.Count == 0)
			{
				<p class="clone-dialog-status">Every repository in the organisation is already cloned locally.</p>
			}
			else
			{
				<p class="clone-dialog-status">
					Cloning into <code>@LocalRepo.GetReposRoot()</code>. Public repositories are selected;
					private and archived ones are listed but left unselected.
				</p>

				<div class="clone-dialog-controls">
					<button class="btn btn-sm" @onclick="() => SetAllVisibleSelected(true)">All</button>
					<button class="btn btn-sm" @onclick="() => SetAllVisibleSelected(false)">None</button>
					@if (UserCodeRoot is not null)
					{
						<button class="btn btn-sm"
								@onclick="SelectSeenLocally"
								disabled="@(SeenLocallyCount == 0)"
								title="@SeenLocallyTooltip">
							Seen Locally@(SeenLocallyCount == 0 ? "" : $" ({SeenLocallyCount})")
						</button>
					}
					<label class="clone-dialog-toggle">
						<input type="checkbox" checked="@_hidePrivateRepositories" @onchange="e => _hidePrivateRepositories = (bool)(e.Value ?? false)" />
						Hide private repositories
					</label>
					<span class="clone-dialog-count">@SelectedCloneCount of @_cloneCandidates.Count selected</span>
				</div>

				<ul class="clone-dialog-list">
					@foreach (var candidate in VisibleCloneCandidates)
					{
						<li class="@(candidate.Selected ? "selected" : null)">
							<label>
								<input type="checkbox" checked="@candidate.Selected" @onchange="() => ToggleCloneCandidate(candidate)" />
								<span class="clone-repo-name">@candidate.Name</span>
								@if (candidate.IsPrivate)
								{
									<span class="clone-tag private">private</span>
								}
								@if (candidate.IsArchived)
								{
									<span class="clone-tag archived">archived</span>
								}
								@if (!candidate.HasPackage)
								{
									<span class="clone-tag no-package">no package</span>
								}
							</label>
						</li>
					}
				</ul>
			}

			<div class="modal-actions">
				<button class="btn btn-secondary" @onclick="CloseCloneDialog">Cancel</button>
				<button class="btn btn-primary" disabled="@(SelectedCloneCount == 0)" @onclick="CloneSelectedRepositories">
					<i class="fas fa-cloud-arrow-down"></i> Clone @SelectedCloneCount repositor@(SelectedCloneCount == 1 ? "y" : "ies")
				</button>
			</div>
		</div>
	</div>
}

<PDFileModal @ref="_fileModal" DataProvider="FileSystemDataProvider" />

@code {
	// === Route parameter ===
	[Parameter]
	public string? PackageId { get; set; }

	// === Auth state ===
	private bool _isAuthenticated;
	private string _userName = string.Empty;
	private string? _accessToken;

	// === Navigation state ===
	private PDTree<NavItem>? _navTree;
	private NavView _currentView = NavView.Home;
	private bool _userMenuOpen;
	// True when the org (root) node is the current focus (org overview / org settings),
	// as opposed to the bare Dashboard state (nothing selected) or a repo being selected.
	private bool _orgSelected;

	/// <summary>
	/// Whether a clone run is under way — the discovery step or any repository it fanned out to
	/// actually cloning — so the org node can show a spinner and its stop button in place of the
	/// clone-picker button.
	/// </summary>
	/// <remarks>
	/// A cached snapshot rather than a live-derived property: <see cref="WorkLaneService.Lanes"/> takes
	/// a lock and deep-copies every lane and its items on each access, and this — along with
	/// <see cref="_cloningOrganization"/>, <see cref="_busyOrganization"/>, <see cref="_isDiscovering"/>
	/// and <see cref="_isLoading"/> — used to be read fresh per tree node, so a 500-node render took
	/// 500-odd full lane snapshots under a lock up to twenty runner threads are contending for. All five
	/// are now refreshed together, once, by <see cref="RefreshLaneFlagsSnapshot"/> whenever the lanes
	/// actually change, rather than once per render and certainly not once per node.
	/// </remarks>
	private bool _isCloningAll;

	// Read before a budget-consuming action so the warning can be accurate. Deliberately not surfaced
	// as a permanent counter: normal dashboard use never approaches the hourly limit, so a visible
	// count was noise. The warning below speaks up only when an action would actually eat into it.
	private int? _rateLimitRemaining;
	private int? _rateLimitLimit;
	private DateTimeOffset? _rateLimitResetUtc;
	private bool _cloneDialogOpen;
	private bool _isLoadingCloneCandidates;
	private string? _cloneCandidatesError;
	private bool _hidePrivateRepositories = true;
	private List<RepositoryCloneCandidate> _cloneCandidates = [];
	// Which organisation the clone dialog is listing.
	private string _cloneDialogOrganization = string.Empty;

	/// <summary>
	/// The organisation a clone run is currently working through, so the stop button only appears on
	/// the organisation actually cloning. Empty when no clone is running.
	/// </summary>
	private string _cloningOrganization = string.Empty;

	/// <summary>
	/// The organisation a rediscover, re-assess or refresh run is scoped to, or null when the run
	/// covers every organisation or nothing is running. Drives which organisation node shows the
	/// progress spinner.
	/// </summary>
	private string? _busyOrganization;

	/// <summary>
	/// True only while a rediscovery's package list is being re-read from NuGet — the phase in which
	/// the nodes on screen may be replaced. False once that hands off to the re-assessment fan-out,
	/// which runs as separate, per-repository lane items rather than under this same item.
	/// </summary>
	private bool _isDiscovering;
	// Add-organisation prompt state.
	private bool _addOrgDialogOpen;
	private string _addOrgName = string.Empty;
	private string? _addOrgError;
	private bool _isAddingOrg;
	// The owner/name of every repository the user already has checked out in their own code directory.
	// Read with the clone candidates, and used only to offer them as a selection.
	private HashSet<string> _seenLocally = new(StringComparer.OrdinalIgnoreCase);
	// git's access to GitHub, checked once on load. Null once resolved or dismissed.
	private GitRemoteAccessResult? _gitAccessProblem;
	private bool _isCheckingGitAccess;
	private bool _gitAccessCommandCopied;
	private static readonly string? UserCodeRoot = LocalRepoService.GetUserCodeRoot();
	private const string GitSchannelCommand = "git config --global http.sslBackend schannel";
	private string _organizationName = string.Empty;
	// The organisation the current selection belongs to. The tree can hold several, so the
	// breadcrumb, Settings and Issues must follow the selection rather than one global name.
	private string _selectedOrganization = string.Empty;
	// Which tree branches are open, persisted to localStorage so expansion survives a page reload.
	private const string ExpandedNodesStorageKey = "navTreeExpandedNodes";
	// Identifies this run of the application. Static, so it is created once per process: an F5 keeps
	// the same value and restores the open branches, while restarting the app changes it and the tree
	// opens collapsed for a genuinely fresh start.
	private static readonly string AppInstanceId = Guid.NewGuid().ToString("N");
	private readonly HashSet<string> _expandedNodeKeys = [];
	private bool _restoringExpansion;
	private bool ShowWorkflowFlow => _selectedRow is not null && _currentView != NavView.Settings;
	private string? _selectedPackageId;
	private AssessmentCategory? _selectedCategory;
	private string? _selectedRuleId;

	// The lane and item the selection names, for the two work panes. Held rather than looked up from
	// the node on render: a lane empties while its pane is open, and the pane still has to say so
	// rather than silently showing a different lane's work.
	private string? _selectedLaneKey;
	private string? _selectedWorkItemId;
	private int? _selectedIssueNumber;
	private RepositoryDashboardRow? _selectedRow;
	private string _treeFilterText = string.Empty;
	private string? _treeFilterError;
	private System.Threading.Timer? _treeFilterDebounce;
	private bool _localOnly;

	// === Dashboard state ===

	/// <summary>
	/// Whether a rediscover, re-assess or refresh run is under way somewhere in the estate. Display
	/// only, now that the lanes decide what may run: it drives the top-level spinner and the dimming
	/// of nodes being rebuilt underneath the user.
	/// </summary>
	private bool _isLoading;

	private string _progressMessage = string.Empty;
	// Keeps the progress indicator visible briefly (showing "Done") after a refresh completes.
	private bool _showDone;
	private System.Threading.Timer? _doneClearTimer;
	private List<RepositoryDashboardRow> _rows = [];
	private AssessmentCategory[] _categories = [];
	private DateTimeOffset _lastRefreshUtc = DateTimeOffset.MinValue;
	private System.Threading.Timer? _autoRefreshTimer;
	private PDTable<RepositoryDashboardRow>? _table;
	private string _searchText = string.Empty;

	// === Package detail state ===
	private bool _isAssessing;
	private bool _isRunning;

	// === Console state ===
	private bool _consoleVisible = true;
	private bool _consoleScrollPending;
	private int _consoleRenderQueued;
	private ElementReference _consoleElement;
	private string _selectedNodeKey = "root";
	// Concurrent because log lines are appended from the assessment tasks, which may reach a node the
	// renderer has not created yet.
	private readonly System.Collections.Concurrent.ConcurrentDictionary<string, NodeUiState> _nodeUiStateByKey = new();
	private WorkflowStep? _lastFailedWorkflowStep;
	private WorkflowStep? _activeWorkflowStep;

	private NodeUiState CurrentNodeUiState => GetOrCreateNodeUiState(_selectedNodeKey);
	// A snapshot, not the live buffer: log lines arrive from the parallel assessment tasks on
	// whatever thread produced them, so nothing outside NodeUiState may enumerate the list directly.
	private ConsoleLine[] CurrentConsoleLines => CurrentNodeUiState.ConsoleSnapshot();
	private string? CurrentLastPromptText { get => CurrentNodeUiState.LastPromptText; set => CurrentNodeUiState.LastPromptText = value; }
	private bool CurrentCopyFeedback { get => CurrentNodeUiState.CopyFeedback; set => CurrentNodeUiState.CopyFeedback = value; }
	private bool CurrentConsoleCopyFeedback { get => CurrentNodeUiState.ConsoleCopyFeedback; set => CurrentNodeUiState.ConsoleCopyFeedback = value; }
	private WorkflowStep? CurrentAiClipboardCueStep { get => CurrentNodeUiState.AiClipboardCueStep; set => CurrentNodeUiState.AiClipboardCueStep = value; }

	// === IDE state ===
	private string? _preferredIdeId;

	// === Workflow step completion state ===
	private readonly HashSet<WorkflowStep> _completedSteps = [];
	private readonly HashSet<WorkflowStep> _failedSteps = [];

	// === Settings state ===
	private PDFileModal? _fileModal;
	private string? _localReposRoot;
	private bool _folderSaved;
	private bool _includeInfoInAiPrompt;
	private bool _allowPublishWithoutTests;

	// === Lifecycle ===

	protected override async Task OnInitializedAsync()
	{
		var httpContext = HttpContextAccessor.HttpContext;
		if (httpContext?.User.Identity?.IsAuthenticated != true)
		{
			return;
		}

		_isAuthenticated = true;
		Lanes.Changed += OnLanesChanged;
		Runner.ItemCompleted += OnItemCompleted;
		_laneChangeDebounce.Elapsed += OnLaneChangeDebounceElapsed;
		// Work restored from a previous run may already be executing by the time this circuit opens,
		// so the flags start from a real snapshot rather than from "nothing running" until the first
		// change arrives.
		RefreshLaneFlagsSnapshot();
		RegressionGuard.StatusesChanged += OnGuardStatusesChanged;
		LogSink.LineWritten += OnLogLineWritten;
		_userName = httpContext.User.Identity.Name ?? "User";
		_organizationName = SettingsOptions.Value.NuGetOrganization;
		_accessToken = await httpContext.GetTokenAsync("access_token");

		// Handed forward to the work runner, which has no request to read a token from: without this
		// every assessment of a repository that is not cloned locally would go out anonymously.
		GitHubTokens.Publish(_accessToken);
		_categories = Enum.GetValues<AssessmentCategory>();
		_localReposRoot = RuntimeSettings.LocalReposRoot;
		_preferredIdeId = RuntimeSettings.PreferredIdeId;
		_includeInfoInAiPrompt = RuntimeSettings.IncludeInfoInAiPrompt;
		_allowPublishWithoutTests = RuntimeSettings.AllowPublishWithoutTests;

		// Load from cache immediately
		var cached = Cache.GetCachedRows();
		if (cached is not null)
		{
			_rows = cached;
			_lastRefreshUtc = Cache.LastRefreshUtc;

			// The cache records what was cloned when it was written; the disk is the authority now.
			// SetRows rather than Update: correcting a stale fact is not a refresh, and must not reset
			// the staleness clock. The rows are reconciled on every load, so the disk copy keeps up.
			if (await Dashboard.ReconcileLocalStateAsync(_rows) > 0)
			{
				Cache.SetRows(_rows);
			}
		}

		// Nothing loads automatically on open any more, so this must not claim otherwise: it used to be
		// set from Cache.IsStale because the auto-refresh timer fired immediately, and leaving it set
		// would spin the organisation node indefinitely with no run behind it. Taken from the lanes
		// rather than hardcoded false, because work restored from the last run may already be loading
		// by the time this circuit opens.
		RefreshLaneFlagsSnapshot();

		// Deliberately not awaited: it shells out to git and talks to the network, and the page has no
		// reason to wait on it. The dialog appears when the answer arrives.
		_ = CheckGitAccessAsync();


		// If a PackageId was in the URL, select it
		if (!string.IsNullOrEmpty(PackageId))
		{
			// The link names a package; what it selects is the repository that publishes it, which may
			// publish several others besides.
			_selectedRow = _rows.FirstOrDefault(r => r.Packages.Any(p =>
				string.Equals(p.PackageId, PackageId, StringComparison.OrdinalIgnoreCase)));
			if (_selectedRow is not null)
			{
				_selectedPackageId = PackageId;
				_selectedOrganization = _selectedRow.Organization;
				_selectedNodeKey = NavTreeDataProvider.PackageKey(_selectedRow.RepositoryFullName, PackageId);
				_currentView = NavView.PackageDetail;
			}
		}

		// Hourly auto-refresh. The first tick is always a full interval away; a stale cache is handled
		// once in OnAfterRenderAsync instead, so the run starts after the UI has painted rather than
		// from a zero-delay timer callback firing before anything is on screen.
		_autoRefreshTimer = new System.Threading.Timer(
			OnAutoRefreshTimer,
			null,
			DashboardCacheService.CacheDuration,
			DashboardCacheService.CacheDuration);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			try
			{
				var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "consoleVisible");
				if (stored is not null && bool.TryParse(stored, out var visible))
				{
					_consoleVisible = visible;
					StateHasChanged();
				}
			}
			catch
			{
				// localStorage may not be available
			}

			// Stale or empty cache: rediscover everything. Done here rather than in OnInitializedAsync
			// so the tree and the progress indicator are already painted — the run is then visibly
			// under way instead of the page appearing to hang before it has drawn anything.
			if (Cache.IsStale && !IsRepositoryBusy(_selectedRow?.RepositoryFullName))
			{
				await RefreshAsync();
			}
		}

		if (_consoleScrollPending && _consoleVisible)
		{
			_consoleScrollPending = false;
			try
			{
				// Follows only while the reader is at the bottom. Scrolling to the newest line
				// unconditionally took the console away from anyone reading back through it, and a run
				// that logs steadily made that happen every few hundred milliseconds.
				await JS.InvokeVoidAsync("scrollTail.follow", _consoleElement);
			}
			catch
			{
				// Element may not exist yet
			}
		}
	}

	// === Navigation ===

	private void OnNavSelectionChanged(TreeNode<NavItem> node)
	{
		if (node.Data is null || !IsSelectableNavNode(node.Data))
		{
			return;
		}

		var item = node.Data;
		_currentView = item.View;
		_selectedPackageId = item.PackageId;
		_selectedCategory = item.Category;
		_selectedRuleId = item.RuleId;
		_selectedIssueNumber = item.IssueNumber;
		_selectedLaneKey = item.LaneKey;
		_selectedWorkItemId = item.WorkItemId;
		_selectedNodeKey = item.Key;
		_orgSelected = IsOrgRootNode(item);

		// The estate stands for every repository, not for whichever one happened to be selected before
		// it. Left set, the previous repository would keep Publish — the one step with no estate-wide
		// form — visible and pointing at a repository nobody is looking at any more, and the workflow
		// step badges would go on describing that repository's progress.
		if (ToolbarScope.IsEstateWide(item.View))
		{
			_selectedRow = null;
			_completedSteps.Clear();
			_failedSteps.Clear();
			_lastFailedWorkflowStep = null;
		}

		// Every node below "Organisations" carries its organisation, so the breadcrumb and the
		// org-scoped views follow the selection instead of a single configured name.
		if (!string.IsNullOrEmpty(item.Organization))
		{
			_selectedOrganization = item.Organization;
		}

		if (item.RepositoryFullName is not null)
		{
			var newRow = RowForNavItem(item);
			if (newRow != _selectedRow)
           {
				_completedSteps.Clear();
				_failedSteps.Clear();
				_lastFailedWorkflowStep = null;
			}

			_selectedRow = newRow;

			// The branch and cleanliness on the row were read the last time the app did something to the
			// checkout, and anything done to it since — by the user, or by another tool — has left them
			// asserting a state that may no longer hold. Re-read them on selection so the badges and the
			// buttons that gate on them describe the repository rather than the app's memory of it. Not
			// awaited: it shells out to git, and the pane should not wait to render.
			if (newRow is not null)
			{
				_ = RefreshSelectedRowGitStatusAsync(newRow);
			}
		}
		else
		{
			_selectedRow = null;
			_completedSteps.Clear();
			_failedSteps.Clear();
			_lastFailedWorkflowStep = null;
		}

		StateHasChanged();
	}

	/// <summary>
	/// Re-reads the selected row's local git facts, repainting only if it is still the row on screen.
	/// </summary>
	private async Task RefreshSelectedRowGitStatusAsync(RepositoryDashboardRow row)
	{
		try
		{
			await Dashboard.RefreshLocalGitStatusAsync(row);
		}
		catch (Exception ex)
		{
			// Badges that cannot be refreshed are not worth an error: they keep their last known values.
			Logger.LogWarning(ex, "Could not refresh git status for {Repository}", row.RepositoryFullName);
			return;
		}

		// Clicking through the tree quickly can leave this arriving after the selection moved on.
		if (ReferenceEquals(_selectedRow, row))
		{
			await InvokeAsync(StateHasChanged);
		}
	}

	private void OnNavNodeActivated(TreeNode<NavItem> node)
	{
		// Organisations / Repositories are structural grouping nodes — not selectable.
		if (!IsSelectableNavNode(node.Data))
		{
			return;
		}

		// A repository being rediscovered may be about to be replaced, so it is dimmed and inert.
		// CSS blocks the pointer; this guards the keyboard and any programmatic activation. Issue
		// nodes stay selectable while they spin — their existing detail is still worth opening.
		if (IsNodeDimmedByRediscovery(node.Data))
		{
			return;
		}

		// Apply the visual selection ourselves so re-clicking a node whose highlight was
		// cleared in place (Dashboard deselect) re-highlights it — PDTree ignores re-clicks.
		_navTree?.RootNode.Walk(n => { n.IsSelected = false; return true; });
		node.IsSelected = true;
		OnNavSelectionChanged(node);
	}

	// Repositories is a pure grouping node and is not selectable. Organisations *is*: selecting it
	// shows the estate overview, which is the one view whose scope is every organisation. The
	// Repositories keys are namespaced per organisation, so these are prefix tests, not exact matches.
	private static bool IsSelectableNavNode(NavItem? item)
		=> item is not null
			&& !item.Key.StartsWith("repos:", StringComparison.Ordinal)
			&& !item.Key.StartsWith("repos-loading:", StringComparison.Ordinal);

	// True for an organisation's own node — the one that carries the clone and settings actions.
	private static bool IsOrgRootNode(NavItem? item)
		=> item is not null && item.Key.StartsWith("org:", StringComparison.Ordinal);

	// The organisation currently in context: whatever the selection implies, falling back to the
	// single configured organisation before anything has been selected.
	private string CurrentOrganization
		=> string.IsNullOrEmpty(_selectedOrganization) ? _organizationName : _selectedOrganization;

	// The three issue views share breadcrumb behaviour; they differ only in how deep they go.
	private bool IsIssueView
		=> _currentView is NavView.Issues or NavView.IssueCategoryDetail or NavView.IssueRuleDetail;

	/// <summary>
	/// Whether the Rediscover/Re-assess buttons apply here. Shown where the scope is unambiguous — the
	/// Organisations overview, meaning all of them, or a selected organisation, meaning that one — and
	/// hidden on Home, which has no scope of its own and where offering to reassess everything sat oddly
	/// beside a page of instructions.
	/// </summary>
	private bool ShowBulkRunButtons
		=> _currentView == NavView.Dashboard || (_currentView == NavView.Home && _orgSelected);

	/// <summary>
	/// Whether the selection stands for every repository beneath it rather than for a single one.
	/// </summary>
	private bool IsEstateWide => ToolbarScope.IsEstateWide(_currentView);

	/// <summary>
	/// Whether the toolbar has anything to act on at all: one selected repository, or a whole estate.
	/// </summary>
	private bool HasToolbarTarget => _selectedRow is not null || IsEstateWide;

	/// <summary>
	/// Every repository the Repositories branch covers, before the excluded and un-cloned ones are
	/// dropped. <see cref="ToolbarScope.Targets"/> does the dropping, so that the number acted on and
	/// the number skipped can both be reported.
	/// </summary>
	private List<RepositoryDashboardRow> EstateCandidates
		=> [.. _rows.Where(r =>
			string.Equals(r.Organization, CurrentOrganization, StringComparison.OrdinalIgnoreCase))];

	/// <summary>
	/// The repositories an estate-wide press of a step would act on.
	/// </summary>
	private List<RepositoryDashboardRow> EstateTargets(WorkflowStep step)
		=> ToolbarScope.Targets(EstateCandidates, step, RuntimeSettings.IsRepositoryExcluded);

	/// <summary>
	/// Whether a step that works on a local clone can run: for one repository, or for however many the
	/// estate offers.
	/// </summary>
	/// <remarks>
	/// The out-of-sync block is a property of one selected repository and is deliberately not applied
	/// estate-wide — one repository behind origin is no reason to refuse to build the other forty-six,
	/// and each item still checks its own state when it runs.
	/// </remarks>
	private bool IsLocalStepEnabled(WorkflowStep step)
		=> IsEstateWide
			? EstateTargets(step).Count > 0 && !IsStepQueueBlocked(step)
			: _selectedRow?.IsClonedLocally == true && !IsBlockedByOutOfSync && !IsStepQueueBlocked(step);

	/// <summary>
	/// Queues one item per repository the estate-wide selection covers, and says what it is doing —
	/// including how many it left out. Acting on twelve of forty-seven without saying so is how a bulk
	/// action lies about what it did.
	/// </summary>
	/// <param name="kind">The work to queue for each repository.</param>
	/// <param name="step">The workflow step it belongs to.</param>
	/// <param name="stepName">The step's label, as the button shows it.</param>
	private void QueueAcrossEstate(WorkKind kind, WorkflowStep step, string stepName)
	{
		var candidates = EstateCandidates;
		var targets = ToolbarScope.Targets(candidates, step, RuntimeSettings.IsRepositoryExcluded);

		AppendConsole(ToolbarScope.Describe(stepName, targets.Count, candidates.Count));

		foreach (var row in targets)
		{
			// The same lane key shape QueueForSelectedRepository uses, so an estate-wide press folds
			// into whatever a single-repository press already queued rather than doubling it.
			Lanes.Enqueue(
				$"{stepName} {row.RepositoryFullName}",
				WorkDescriptor.ForRepository(kind, row.Organization, row.RepositoryFullName),
				$"{kind}:{row.RepositoryFullName}:",
				step,
				_selectedNodeKey);
		}
	}

	/// <summary>
	/// A message awaiting the user's response, rendered as an in-app modal.
	/// </summary>
	private sealed record PendingDialog(
		string Message,
		bool IsConfirm,
		TaskCompletionSource<bool> Completion,
		string? Heading = null,
		string? IconCssClass = null);

	private PendingDialog? _dialog;

	/// <summary>
	/// Asks the user to confirm, resolving to their answer.
	/// </summary>
	/// <remarks>
	/// Deliberately an in-app modal rather than the browser's <c>confirm()</c>. Native dialogs are not
	/// universally available — Claude's in-app browser suppresses them outright and returns false —
	/// and a suppressed confirm is indistinguishable from the user declining. That made every guarded
	/// action silently do nothing: "Remove organisation" appeared dead, and the API budget warnings
	/// silently cancelled the very actions they were meant to let through.
	/// </remarks>
	private Task<bool> ConfirmAsync(string message)
	{
		var completion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
		_dialog = new PendingDialog(message, IsConfirm: true, completion);
		StateHasChanged();
		return completion.Task;
	}

	/// <summary>
	/// Shows the user a message with a single acknowledgement, replacing <c>alert()</c>.
	/// </summary>
	private Task NotifyAsync(string message, string? heading = null, string? iconCssClass = null)
	{
		var completion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
		_dialog = new PendingDialog(message, IsConfirm: false, completion, heading, iconCssClass);
		StateHasChanged();
		return completion.Task;
	}

	/// <summary>
	/// Closes the dialog and hands the answer back to whoever is awaiting it.
	/// </summary>
	private void ResolveDialog(bool result)
	{
		var pending = _dialog;
		_dialog = null;
		pending?.Completion.TrySetResult(result);
	}

	/// <summary>
	/// True while an operation that spans the whole row set is running. Cloning and re-assessing must
	/// not overlap: they compete for the same GitHub budget and the same rows, and a clone completing
	/// mid-assessment flips a repository from remote to local underneath the assessment that is
	/// already reading it.
	/// </summary>
	/// <summary>
	/// Whether a bulk run is under way. Display only, now that the queue decides what may start: it
	/// drives the spinners and the dimming of nodes being rebuilt underneath the user.
	/// </summary>
	private bool IsBulkOperationInFlight => _isLoading || _isAssessing || _isCloningAll;

	/// <summary>
	/// Whether this node should be dimmed and made inert because a rediscovery is replacing the
	/// repository list underneath it.
	/// </summary>
	/// <remarks>
	/// Only during the discovery phase — while the package list is being re-read from NuGet and shown
	/// — because that is when the nodes on screen may be about to be replaced. Once the new list is
	/// displayed the dimming lifts and the assessment phase shows a spinner per repository instead.
	/// A re-assessment never dims: the same repositories remain and their existing results stay valid
	/// and worth clicking into while the run proceeds.
	/// <para>
	/// Stable for the whole phase. An earlier version un-dimmed each repository as its own result
	/// arrived, which meant the tree changed on every completion; combined with the per-row tree
	/// rebuild it made the tree flicker and the scrollbar jitter.
	/// </para>
	/// </remarks>
	private bool IsNodeDimmedByRediscovery(NavItem? item)
	{
		if (item is null || !_isDiscovering)
		{
			return false;
		}

		// Only the repositories themselves dim — not the "Repositories" container above them, which
		// stays legible as a heading. Progress is carried by the indicator on the organisation node
		// and the counter in the breadcrumb bar.
		return NavTreeDataProvider.IsRepositoryNode(item);
	}

	/// <summary>
	/// True while repositories are actually being assessed: either a re-assessment, or the assessment
	/// phase of a rediscovery (which follows its discovery phase).
	/// </summary>
	private bool IsAssessmentInFlight => _isAssessing || (_isLoading && !_isDiscovering);

	/// <summary>
	/// The icon for a tree node. Package nodes resolve theirs from live row state rather than from the
	/// NavItem, so a repository's spinner is replaced by its result the moment that result arrives.
	/// </summary>
	/// <remarks>
	/// This is why per-repository progress no longer requires rebuilding the tree. PDTree holds NavItem
	/// snapshots from when a branch loaded, so the old approach re-fetched every node on each
	/// completion — which changed the DOM structure and made the tree flicker and the scrollbar jump.
	/// Re-rendering the template only swaps this one element's class attribute, which moves nothing.
	/// </remarks>
	private string GetNodeIconCss(NavItem? item)
	{
		if (item is null)
		{
			return string.Empty;
		}

		// Issue categories and rules spin for the duration of an assessment, since their contents are
		// entirely derived from the results being recomputed.
		if (IsIssueNodeAwaitingAssessment(item))
		{
			return "fas fa-spinner fa-spin text-muted";
		}

		// Repository nodes only. Everything beneath one carries its repository too, so match on the key.
		if (!NavTreeDataProvider.IsRepositoryNode(item))
		{
			return item.IconCss;
		}

		// There is deliberately no estate-wide roll-up node, so this spinner is the only sign that a
		// repository is working without expanding its Work node to look. It takes precedence over the
		// health glyph for exactly as long as the lane is running, then the result replaces it.
		if (item.IsBusy)
		{
			return "fas fa-circle-notch fa-spin";
		}

		var row = RowForNavItem(item);

		return row is null
			? item.IconCss
			: NavTreeDataProvider.BuildRepositoryIconCss(row);
	}

	/// <summary>
	/// The scope the toolbar's run buttons act on, which follows the breadcrumb: a package when one is
	/// selected, otherwise the selected organisation, otherwise every organisation.
	/// </summary>
	private string GetReassessButtonText()
		=> _selectedRow is not null ? "Re-assess"
			: _orgSelected ? "Re-assess Org"
			: "Re-assess Orgs";

	/// <summary>
	/// Where this organisation's clones are kept. Repositories owned by another account are filed under
	/// that owner rather than here, so this is where most of them are, not necessarily all.
	/// </summary>
	private string OrganizationCloneFolder
		=> Path.Combine(LocalRepo.GetReposRoot(), CurrentOrganization);

	private void OpenOrganizationCloneFolder() => OpenFolder(OrganizationCloneFolder);

	/// <summary>
	/// Opens the clone root, creating it first if it has gone.
	/// </summary>
	/// <remarks>
	/// Ensured here and not only at start-up, because this page invites you into that folder to delete
	/// things — including, plausibly, the folder itself. Guaranteeing it at start-up alone would leave the
	/// rest of the session naming a location that is not there, and this button is the one that would then
	/// fail.
	/// </remarks>
	private void OpenCloneRoot() => OpenFolder(LocalRepo.EnsureReposRootExists());

	private void OpenFolder(string folder)
	{
		var (success, message) = LocalRepo.OpenFolder(folder);

		if (!success)
		{
			// Console rather than a dialog: it is a convenience, and the path is on screen to open by hand.
			_consoleVisible = true;
			AppendConsole($"⚠️ Could not open {folder}: {message}");
		}
	}

	private string GetReassessButtonTooltip()
	{
		var scope = _selectedRow is not null
			? "Re-assess this package"
			: _orgSelected
				? $"Assess every {CurrentOrganization} repository again, without re-reading the package list from NuGet"
				: "Assess every known repository again, without re-reading the package list from NuGet";

		var lastAssessed = LastAssessedInScope();
		return lastAssessed is null ? scope : $"{scope}. Last assessed {DescribeAssessmentAge(lastAssessed.Value)}";
	}

	/// <summary>
	/// The most recent assessment within whatever the toolbar currently acts on, or null if nothing in
	/// scope has been assessed.
	/// </summary>
	/// <remarks>
	/// The most recent rather than the oldest, because for a bulk scope the question the tooltip answers
	/// is "have I only just done this?" — and the newest assessment is what makes a repeat redundant.
	/// </remarks>
	private DateTimeOffset? LastAssessedInScope()
	{
		if (_selectedRow is not null)
		{
			return _selectedRow.Assessment?.AssessedAtUtc;
		}

		var inScope = _orgSelected
			? _rows.Where(r => string.Equals(r.Organization, CurrentOrganization, StringComparison.OrdinalIgnoreCase))
			: _rows;

		return inScope
			.Select(r => r.Assessment?.AssessedAtUtc)
			.Where(at => at is not null)
			.Max();
	}

	/// <summary>
	/// Describes how long ago an assessment ran, e.g. "4 minutes ago, at 15:20 UTC".
	/// </summary>
	/// <remarks>
	/// Same shape as <see cref="DescribeRateLimitReset"/>, and UTC for the same reason: this is Blazor
	/// Server, so converting to local time would use the server's timezone rather than the viewer's. The
	/// date is included once the assessment is no longer from today, since a bare clock time on a
	/// week-old assessment reads as if it were minutes ago.
	/// </remarks>
	private static string DescribeAssessmentAge(DateTimeOffset assessedAtUtc)
	{
		var assessed = assessedAtUtc.ToUniversalTime();
		var age = DateTimeOffset.UtcNow - assessed;
		var clock = age.TotalHours < 24
			? $"at {assessed:HH:mm} UTC"
			: $"at {assessed:HH:mm} UTC on {assessed:d MMM}";

		var relative = age switch
		{
			{ TotalMinutes: < 1 } => "moments ago",
			{ TotalMinutes: < 2 } => "a minute ago",
			{ TotalHours: < 1 } => $"{(int)age.TotalMinutes} minutes ago",
			{ TotalHours: < 2 } => "an hour ago",
			{ TotalDays: < 1 } => $"{(int)age.TotalHours} hours ago",
			{ TotalDays: < 2 } => "yesterday",
			_ => $"{(int)age.TotalDays} days ago"
		};

		return $"{relative}, {clock}";
	}

	/// <summary>
	/// Whether this node is issue content whose result is currently being recomputed, and so shows a
	/// spinner in place of its usual severity glyph.
	/// </summary>
	/// <remarks>
	/// The whole issue hierarchy is derived from assessment results, so unlike repositories these do
	/// not resolve one at a time — they all spin for the run and are rebuilt together at the end.
	/// The "Issues" container node itself is excluded, so it stays legible as a heading.
	/// </remarks>
	private bool IsIssueNodeAwaitingAssessment(NavItem? item)
	{
		if (item is null || !IsAssessmentInFlight)
		{
			return false;
		}

		return item.Key.StartsWith("icat:", StringComparison.Ordinal)
			|| item.Key.StartsWith("irule:", StringComparison.Ordinal);
	}

	/// <summary>
	/// Whether an organisation node should show a spinner: either its repository list is still being
	/// discovered, or a run that affects it is in flight. Scoped to the organisation actually being
	/// worked on, so with several organisations only the relevant one spins.
	/// </summary>
	private bool ShouldSpinOrgNode(NavItem? item)
	{
		if (item is null || !IsOrgRootNode(item))
		{
			return false;
		}

		if (item.IsBusy)
		{
			return true;
		}

		if (!IsBulkOperationInFlight)
		{
			return false;
		}

		// A null busy organisation means the run covers every organisation.
		return _busyOrganization is null
			|| string.Equals(_busyOrganization, item.Organization, StringComparison.OrdinalIgnoreCase);
	}

	/// <summary>
	/// Selects the Organisations node, which shows the estate overview.
	/// </summary>
	private async Task NavigateToOrganisationsAsync()
	{
		_selectedRow = null;
		_selectedPackageId = null;
		_selectedCategory = null;
		_selectedRuleId = null;
		_orgSelected = false;
		_selectedOrganization = string.Empty;

		await SelectNavNodeAsync(NavTreeDataProvider.OrganisationsKey, NavView.Dashboard);
	}

	// Breadcrumb hops back up the issue hierarchy, selecting the tree node so the sidebar follows.
	private async Task NavigateToIssuesAsync()
		=> await SelectNavNodeAsync(NavTreeDataProvider.IssuesKey(CurrentOrganization), NavView.Issues);

	private async Task NavigateToIssueCategoryAsync()
		=> await SelectNavNodeAsync(
			$"icat:{CurrentOrganization}:{_selectedCategory}",
			NavView.IssueCategoryDetail);

	/// <summary>
	/// Selects a node by key so the sidebar highlight follows the breadcrumb. Falls back to setting
	/// the view directly when the node is not currently realised (its branch may be collapsed).
	/// </summary>
	private async Task SelectNavNodeAsync(string key, NavView fallbackView)
	{
		var node = _navTree?.RootNode.Find(key);
		if (node is not null)
		{
			await _navTree!.SelectNode(node);
			return;
		}

		_currentView = fallbackView;
		_selectedNodeKey = key;
		if (fallbackView == NavView.Issues)
		{
			_selectedCategory = null;
			_selectedRuleId = null;
		}
		else if (fallbackView == NavView.IssueCategoryDetail)
		{
			_selectedRuleId = null;
		}

		StateHasChanged();
	}

	private void OnNavBeforeSelect(TreeBeforeSelectionChangeEventArgs<NavItem> args)
	{
		if (!IsSelectableNavNode(args.NewNode?.Data))
		{
			args.Cancel = true;
		}
	}

	// Organisations is always shown expanded (its collapse toggle is hidden in CSS), and any
	// branches the user had open before a reload are re-opened.
	private async Task OnNavTreeReady()
	{
		// Suppress saving for the whole sequence: expanding nodes here fires NodeExpanded, which
		// would otherwise persist a partial set and clobber what we're about to restore.
		_restoringExpansion = true;
		try
		{
			await LoadExpandedNodesAsync();

			var org = _navTree?.RootNode.Find("organisations");
			if (org is not null && !org.IsExpanded)
			{
				await _navTree!.ToggleNodeIsExpandedAsync(org).ConfigureAwait(true);
			}

			_expandedNodeKeys.Add("organisations");

			if (_navTree is not null)
			{
				await ExpandSavedNodesAsync(_navTree.RootNode);
			}
		}
		finally
		{
			_restoringExpansion = false;
		}

		// Land on Home, unless a package was named in the URL. PDTree selects its first node once it is
		// ready, and now that Organisations is selectable that selection takes effect — so the app
		// opened straight onto the overview and Home was never seen, which defeats the point of Home
		// pointing you at the overview in the first place.
		if (string.IsNullOrEmpty(PackageId))
		{
			_navTree?.RootNode.Walk(n => { n.IsSelected = false; return true; });
			_currentView = NavView.Home;
			_selectedNodeKey = string.Empty;
			_orgSelected = false;
			_selectedOrganization = string.Empty;
		}

		StateHasChanged();
	}

	private async Task OnNavNodeExpanded(TreeNode<NavItem> node)
	{
		if (_restoringExpansion || node.Key is null)
		{
			return;
		}

		_expandedNodeKeys.Add(node.Key);
		await SaveExpandedNodesAsync();
	}

	private async Task OnNavNodeCollapsed(TreeNode<NavItem> node)
	{
		if (_restoringExpansion || node.Key is null)
		{
			return;
		}

		_expandedNodeKeys.Remove(node.Key);
		await SaveExpandedNodesAsync();
	}

	private async Task SaveExpandedNodesAsync()
	{
		try
		{
			var state = new ExpandedNodesState(AppInstanceId, [.. _expandedNodeKeys]);
			await JS.InvokeVoidAsync(
				"localStorage.setItem",
				ExpandedNodesStorageKey,
				System.Text.Json.JsonSerializer.Serialize(state));
		}
		catch
		{
			// localStorage may not be available
		}
	}

	/// <summary>
	/// The persisted expansion set, stamped with the run of the application that saved it.
	/// </summary>
	private sealed record ExpandedNodesState(string InstanceId, string[] Keys);

	/// <summary>
	/// Loads the set of previously-expanded branch keys from localStorage.
	/// </summary>
	private async Task LoadExpandedNodesAsync()
	{
		try
		{
			var stored = await JS.InvokeAsync<string?>("localStorage.getItem", ExpandedNodesStorageKey);
			if (string.IsNullOrWhiteSpace(stored))
			{
				return;
			}

			var state = System.Text.Json.JsonSerializer.Deserialize<ExpandedNodesState>(stored);

			// A fresh start of the application opens collapsed: restoring yesterday's open branches
			// makes launching the app feel like resuming a session rather than starting one. An F5
			// within the same run does restore them, because the stamp still matches.
			if (state is null || state.InstanceId != AppInstanceId)
			{
				return;
			}

			var keys = state.Keys;
			if (keys is null)
			{
				return;
			}

			_expandedNodeKeys.Clear();
			foreach (var key in keys)
			{
				_expandedNodeKeys.Add(key);
			}
		}
		catch
		{
			// localStorage unavailable or stored value unreadable — leave the tree as-is
		}
	}

	private async Task ExpandSavedNodesAsync(TreeNode<NavItem> node)
	{
		// Expand this node first so its children are present before recursing into them.
		if (node.Key is not null && !node.Isleaf && !node.IsExpanded && _expandedNodeKeys.Contains(node.Key))
		{
			await _navTree!.ToggleNodeIsExpandedAsync(node).ConfigureAwait(true);
		}

		if (node.Nodes is null)
		{
			return;
		}

		foreach (var child in node.Nodes.ToList())
		{
			await ExpandSavedNodesAsync(child).ConfigureAwait(true);
		}
	}

	/// <summary>
	/// Names a count only once the organisation's repositories have been read from GitHub. Before
	/// that, the only number available is how many package-backed repositories are missing, which is
	/// not the ceiling: the organisation has many repositories that publish no package at all.
	/// </summary>
	private string GetCloneAllTooltip()
	{
		var root = LocalRepo.GetReposRoot();
		if (_cloneCandidates.Count == 0)
		{
			return $"Choose which of the organisation's repositories to clone into {root}";
		}

		var publicCount = _cloneCandidates.Count(c => !c.IsPrivate && !c.IsArchived);
		return $"Clone into {root} — up to {publicCount} public repositories are missing locally";
	}

	/// <summary>
	/// Opens the clone dialog, listing the organisation's repositories as GitHub reports them so
	/// visibility is known. Public, non-archived repositories missing locally start selected.
	/// </summary>
	private async Task OpenCloneDialogAsync() => await OpenCloneDialogAsync(CurrentOrganization);

	private async Task OpenCloneDialogAsync(string organization)
	{
		_cloneDialogOpen = true;
		_cloneDialogOrganization = organization;
		_isLoadingCloneCandidates = true;
		_cloneCandidatesError = null;
		_cloneCandidates = [];
		await InvokeAsync(StateHasChanged);

		try
		{
			var repositories = await CreateGitHubClient().Repository.GetAllForOrg(organization);

			// Read once, with the candidates: it costs a git call per directory and cannot change while
			// the dialog is open.
			_seenLocally = await FindSeenLocallyAsync(CancellationToken.None);

			// Which repositories back a package the dashboard knows about.
			var packageRepositories = _rows
				.Where(r => r.RepositoryFullName is not null)
				.Select(r => r.RepositoryFullName!)
				.ToHashSet(StringComparer.OrdinalIgnoreCase);

			_cloneCandidates = [.. repositories
				.Where(repository => !LocalRepo.IsClonedLocally(repository.FullName))
				.Select(repository => new RepositoryCloneCandidate
				{
					Name = repository.Name,
					FullName = repository.FullName,
					CloneUrl = repository.CloneUrl,
					IsPrivate = repository.Private,
					IsArchived = repository.Archived,
					HasPackage = packageRepositories.Contains(repository.FullName),
					Selected = !repository.Private && !repository.Archived
				})
				.OrderBy(candidate => candidate.Name, StringComparer.OrdinalIgnoreCase)];
		}
		catch (Exception ex)
		{
			_cloneCandidatesError = ex.Message;
		}
		finally
		{
			_isLoadingCloneCandidates = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private void CloseCloneDialog() => _cloneDialogOpen = false;

	// ── git's access to GitHub ──

	/// <summary>
	/// Probes whether git can reach GitHub, and raises the dialog if it cannot.
	/// </summary>
	/// <remarks>
	/// Probed with a repository the app actually knows about rather than a fixed URL, so the test is of
	/// the exact thing it would do. With nothing discovered yet there is nothing to clone either, so the
	/// check is skipped rather than invented.
	/// </remarks>
	private async Task CheckGitAccessAsync()
	{
		var probeRepository = _rows.FirstOrDefault(r => r.RepositoryFullName is not null)?.RepositoryFullName;
		if (probeRepository is null)
		{
			return;
		}

		_isCheckingGitAccess = true;

		try
		{
			var result = await LocalRepo.CheckRemoteAccessAsync($"https://github.com/{probeRepository}.git");
			_gitAccessProblem = result.Access == GitRemoteAccess.Ok ? null : result;
		}
		catch (Exception ex)
		{
			// A probe that cannot run must not take the page down with it.
			Logger.LogWarning(ex, "Could not check git's access to GitHub");
		}
		finally
		{
			_isCheckingGitAccess = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private async Task RecheckGitAccessAsync()
	{
		_gitAccessCommandCopied = false;
		await CheckGitAccessAsync();

		if (_gitAccessProblem is null)
		{
			AppendConsole("✅ git can now reach GitHub.");
		}
	}

	private void DismissGitAccessDialog() => _gitAccessProblem = null;

	private async Task CopyGitAccessCommandAsync()
	{
		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", GitSchannelCommand);
			_gitAccessCommandCopied = true;
		}
		catch (Exception ex)
		{
			Logger.LogWarning(ex, "Could not copy the git command to the clipboard");
		}
	}

	private void OpenAddOrganizationDialog()
	{
		_addOrgName = string.Empty;
		_addOrgError = null;
		_addOrgDialogOpen = true;
	}

	private void CloseAddOrganizationDialog() => _addOrgDialogOpen = false;

	// Enter submits, Escape cancels — a single-field prompt should not need the mouse.
	private async Task OnAddOrgKeyDown(KeyboardEventArgs args)
	{
		if (args.Key == "Enter" && !_isAddingOrg && !string.IsNullOrWhiteSpace(_addOrgName))
		{
			await ConfirmAddOrganizationAsync();
		}
		else if (args.Key == "Escape")
		{
			CloseAddOrganizationDialog();
		}
	}

	/// <summary>
	/// Adds the organisation, then rediscovers so its packages appear. A wrong name is the likely
	/// mistake here, and it surfaces as an organisation with no packages rather than an error, so
	/// the name is checked against GitHub before being persisted.
	/// </summary>
	private async Task ConfirmAddOrganizationAsync()
	{
		var name = _addOrgName?.Trim();
		if (string.IsNullOrEmpty(name))
		{
			_addOrgError = "Enter an organisation name.";
			return;
		}

		_isAddingOrg = true;
		_addOrgError = null;
		await InvokeAsync(StateHasChanged);

		try
		{
			// Verify it exists and we can see it, so a typo fails loudly here instead of silently
			// producing an empty branch in the tree.
			try
			{
				_ = await CreateGitHubClient().Organization.Get(name);
			}
			catch (Octokit.NotFoundException)
			{
				_addOrgError = $"GitHub has no organisation '{name}', or your token cannot see it.";
				return;
			}

			if (!RuntimeSettings.AddOrganization(name))
			{
				_addOrgError = $"'{name}' is already in the list.";
				return;
			}

			_addOrgDialogOpen = false;

			// Discover only the organisation just added. Rediscovering every organisation would
			// re-read and re-assess the ones already on screen, which is wasted GitHub budget and
			// wasted time when nothing about them has changed.
			await RediscoverOrganizationAsync(name);
		}
		catch (Exception ex)
		{
			_addOrgError = ex.Message;
			Logger.LogError(ex, "Failed to add organisation {Organization}", name);
		}
		finally
		{
			_isAddingOrg = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	/// <summary>
	/// Removes the organisation currently shown in Settings. Deliberately reached only from the
	/// bottom of the Settings screen rather than a tree button, and confirmed before acting.
	/// </summary>
	private async Task RemoveCurrentOrganizationAsync()
	{
		var organization = CurrentOrganization;
		if (string.IsNullOrEmpty(organization))
		{
			return;
		}

		var confirmed = await ConfirmAsync(
			$"Remove '{organization}' from the dashboard? Its repositories stay on GitHub and any local clones are left alone.");

		if (!confirmed)
		{
			return;
		}

		if (!RuntimeSettings.RemoveOrganization(organization))
		{
			await NotifyAsync("That is the last organisation — at least one must remain.");
			return;
		}

		_selectedOrganization = string.Empty;
		NavigateToDashboard();

		// Drop the removed organisation's rows and rebuild the tree. No GitHub calls needed:
		// the remaining organisations' cached assessments are still valid.
		_rows = [.. _rows.Where(r => !string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))];
		Cache.SetRows(_rows);
		await ReloadTreePreservingExpansionAsync();
		StateHasChanged();
	}

	private List<RepositoryCloneCandidate> VisibleCloneCandidates
		=> [.. _cloneCandidates.Where(c => !_hidePrivateRepositories || !c.IsPrivate)];

	private int SelectedCloneCount => _cloneCandidates.Count(c => c.Selected);

	private void SetAllVisibleSelected(bool selected)
	{
		foreach (var candidate in VisibleCloneCandidates)
		{
			candidate.Selected = selected;
		}
	}

	private void ToggleCloneCandidate(RepositoryCloneCandidate candidate)
		=> candidate.Selected = !candidate.Selected;

	/// <summary>
	/// The listed candidates the user already has checked out somewhere in their own code directory.
	/// </summary>
	/// <remarks>
	/// Drawn from the visible candidates, like its sibling buttons: All and None have always acted on
	/// what is shown, and a count that promised more than the button selects — or a selection left behind
	/// in the hidden rows after pressing None — would be worse than respecting the filter.
	/// </remarks>
	private List<RepositoryCloneCandidate> SeenLocallyCandidates
		=> [.. VisibleCloneCandidates.Where(c => _seenLocally.Contains(c.FullName))];

	private int SeenLocallyCount => SeenLocallyCandidates.Count;

	private string SeenLocallyTooltip
		=> SeenLocallyCount == 0
			? $"None of the listed repositories are checked out in {UserCodeRoot}"
			: $"Select the {SeenLocallyCount} listed repositor{(SeenLocallyCount == 1 ? "y" : "ies")} you already have in {UserCodeRoot} — a shortcut to the ones you work on. They are still cloned fresh from GitHub";

	/// <summary>
	/// Selects exactly the repositories the user already has, replacing the current selection: the point
	/// of the button is to answer "which of these do I already have?", which adding to a selection would
	/// obscure.
	/// </summary>
	private void SelectSeenLocally()
	{
		foreach (var candidate in VisibleCloneCandidates)
		{
			candidate.Selected = _seenLocally.Contains(candidate.FullName);
		}
	}

	/// <summary>
	/// The <c>owner/name</c> of every repository already checked out in the user's code directory.
	/// </summary>
	/// <remarks>
	/// Taken from what each checkout's <c>origin</c> says it is, never from its folder name. Failure is
	/// not fatal: without it the button has nothing to offer, which costs a convenience and nothing else.
	/// </remarks>
	private async Task<HashSet<string>> FindSeenLocallyAsync(CancellationToken cancellationToken)
	{
		if (UserCodeRoot is null)
		{
			return new(StringComparer.OrdinalIgnoreCase);
		}

		try
		{
			var found = await LocalRepo.FindLocalRepositoriesAsync(cancellationToken);
			return found
				.Select(f => f.RepoIdentity)
				.ToHashSet(StringComparer.OrdinalIgnoreCase);
		}
		catch (Exception ex)
		{
			Logger.LogWarning(ex, "Could not scan {Root} for existing checkouts", UserCodeRoot);
			AppendConsole($"⚠️ Could not read {UserCodeRoot} to find which repositories you already have.");
			return new(StringComparer.OrdinalIgnoreCase);
		}
	}

	/// <summary>
	/// Stops a clone run. Cancels every lane under the organisation, not just the discovery item's own
	/// — discovery's whole job is to fan its targets out onto per-repository lanes and it completes in
	/// milliseconds, so by the time this button is visible the organisation's own lane is already empty
	/// and cancelling only that would stop nothing.
	/// </summary>
	private void CancelCloneAll()
	{
		if (_cloningOrganization.Length > 0)
		{
			AppendConsole("⏹️ Stopping after the current repository...");
			Lanes.CancelUnder(_cloningOrganization);
		}
	}

	/// <summary>
	/// Queues discovery of the selected clone candidates, which fans out into one clone per repository
	/// once it runs. See <see cref="WorkExecutors.DiscoverCloneTargetsAsync"/> for the <c>fullNames</c>
	/// contract this descriptor must match.
	/// </summary>
	private void CloneSelectedRepositories()
	{
		var targets = _cloneCandidates.Where(c => c.Selected).ToList();
		if (targets.Count == 0)
		{
			return;
		}

		var organization = _cloneDialogOrganization;
		_cloneDialogOpen = false;

		var title = $"Clone {targets.Count} repositories — {organization}";
		var queued = Lanes.Enqueue(
			title,
			WorkDescriptor.ForOrganization(
				WorkKind.DiscoverCloneTargets,
				organization,
				("fullNames", string.Join(',', targets.Select(t => t.FullName)))),
			$"clone:{organization}:{string.Join(',', targets.Select(t => t.FullName))}",
			step: null,
			_selectedNodeKey);

		AppendConsole(DescribeQueued(queued, title));
	}

	/// <summary>
	/// GitHub REST calls one repository assessment costs: one to read the repository and one for its
	/// file tree. File contents come from raw.githubusercontent.com, which is a CDN and does not draw
	/// on the API quota, and locally-cloned repositories are assessed from disk and cost nothing.
	/// </summary>
	private const int ApiCallsPerRemoteAssessment = 2;

	/// <summary>
	/// Reads the current rate limit. Asking for the limit does not itself consume quota.
	/// </summary>
	private async Task RefreshRateLimitAsync()
	{
		try
		{
			var limits = await CreateGitHubClient().RateLimit.GetRateLimits();
			_rateLimitRemaining = limits.Resources.Core.Remaining;
			_rateLimitLimit = limits.Resources.Core.Limit;
			_rateLimitResetUtc = limits.Resources.Core.Reset;
		}
		catch
		{
			// Leave it unknown rather than guess; the indicator hides itself.
			_rateLimitRemaining = null;
		}
	}

	private int EstimateRemoteAssessmentCost(IEnumerable<RepositoryDashboardRow> rows)
		=> rows.Count(r => r.RepositoryFullName is not null && !r.IsClonedLocally) * ApiCallsPerRemoteAssessment;

	/// <summary>
	/// Describes when the API budget resets, e.g. "in about 47 minutes, at 15:20 UTC".
	/// </summary>
	/// <remarks>
	/// Leads with the relative time because that is what answers "should I just wait?", and states the
	/// clock time explicitly as UTC. It is deliberately not converted to local time: this is Blazor
	/// Server, so a conversion would use the *server's* timezone, which is only the viewer's by
	/// coincidence when running locally — hosted in UTC, every user would see UTC labelled as local.
	/// </remarks>
	private string DescribeRateLimitReset()
	{
		if (_rateLimitResetUtc is null)
		{
			return "shortly";
		}

		var resetUtc = _rateLimitResetUtc.Value.ToUniversalTime();
		var minutes = (int)Math.Ceiling((resetUtc - DateTimeOffset.UtcNow).TotalMinutes);
		var clock = $"at {resetUtc:HH:mm} UTC";

		return minutes switch
		{
			<= 0 => $"any moment now, {clock}",
			1 => $"in about a minute, {clock}",
			_ => $"in about {minutes} minutes, {clock}"
		};
	}

	/// <summary>
	/// Warns before an action that will consume a meaningful share of the remaining GitHub API
	/// budget, so running out is a choice rather than a surprise. Stays quiet when there is plenty of
	/// headroom, and never blocks when the budget is unknown.
	/// </summary>
	private async Task<bool> ConfirmApiBudgetAsync(string action, int estimatedCalls)
	{
		if (estimatedCalls <= 0)
		{
			return true;
		}

		await RefreshRateLimitAsync();
		if (_rateLimitRemaining is null)
		{
			return true;
		}

		var remaining = _rateLimitRemaining.Value;
		if (estimatedCalls >= remaining)
		{
			return await ConfirmAsync(
				$"{action} needs about {estimatedCalls} GitHub API calls but only {remaining} remain, so it will not finish. The budget resets {DescribeRateLimitReset()}. Continue anyway?");
		}

		// Only speak up when this would eat a quarter or more of what is left.
		if (estimatedCalls * 4 < remaining)
		{
			return true;
		}

		return await ConfirmAsync(
			$"{action} will use about {estimatedCalls} of your {remaining} remaining GitHub API calls this hour. Continue?");
	}

