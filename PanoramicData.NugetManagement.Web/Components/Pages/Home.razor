	private NodeUiState GetOrCreateNodeUiState(string nodeKey)
	{
		if (!_nodeUiStateByKey.TryGetValue(nodeKey, out var state))
		{
			state = new NodeUiState();
			_nodeUiStateByKey[nodeKey] = state;
