		=> _nodeUiStateByKey.GetOrAdd(nodeKey, static _ => new NodeUiState());

	/// <summary>
	/// Routes IssuesView's output into the console at the bottom of the screen, opening it if it is
	/// hidden: a bulk run pushes to several repositories, and its progress is the one thing the user
	/// needs to see while it happens.
	/// </summary>
	private void AppendIssuesOutput(string line)
	{
		_consoleVisible = true;
		AppendConsole(line);
	}

	// === Work queue ===

	/// <summary>Whether anything is running or waiting, so a click now queues rather than starts.</summary>
	private bool IsQueueBusy => WorkQueue.Items.Count > 0;

	/// <summary>
	/// Throws away whatever a stopped fix had written into a clone, and says how much went. Not
	/// cancellable: this is the cleanup, and abandoning it half-way is the state it exists to prevent.
	/// </summary>
	private async Task RevertPartAppliedFixAsync(RepositoryDashboardRow row)
	{
		if (row.RepositoryFullName is null)
		{
			return;
		}

		var (success, discarded) = await LocalRepo.DiscardLocalChangesAsync(row.RepositoryFullName, CancellationToken.None);
		AppendConsole(success
			? discarded.Count == 0
				? "↩️ Stopped before anything was written."
				: $"↩️ Reverted {discarded.Count} change(s) written before the stop."
			: "⚠️ Could not revert the part-applied changes — check the clone by hand.");

		await Dashboard.RefreshGitStatusAsync(row, CancellationToken.None);
	}

	private static string QueueItemIcon(WorkItem item) => item.State switch
	{
		WorkItemState.Running => "fa-circle-notch fa-spin",
		WorkItemState.Cancelling => "fa-rotate-left fa-spin",
		_ => "fa-clock"
	};

	/// <summary>
	/// Puts an operation on the application-wide queue and starts the pump. Nothing runs immediately:
	/// if something else is in flight — in this tab or another — the item waits its turn in the panel
	/// under the navigation tree.
	/// </summary>
	private void EnqueueWork(
		string title,
		string? organization,
		string dedupKey,
		Func<IProgress<string>, CancellationToken, Task> run,
		WorkflowStep? step = null,
		string? repositoryFullName = null)
	{
		var item = WorkQueue.Enqueue(title, organization, dedupKey, this, run, step, repositoryFullName);
		if (item is null)
		{
			// Folded into an identical pending item. Said out loud, because a button that appears to do
			// nothing is worse than one that queues a second pass. The console it was folded into keeps
			// its own node — the fold produced no new work to report.
			AppendConsole($"↩️ {title} is already queued.");
			return;
		}

		// Recorded now rather than read when the item runs: the queue may not reach it for minutes, by
		// which time the selection has moved and the run's output would land in an unrelated console.
		_consoleNodeKeyByWorkItemId[item.Id] = _selectedNodeKey;

		AppendConsole(WorkQueue.Running is null ? $"▶️ {title}" : $"⏳ Queued: {title}");
		_ = PumpQueueAsync();
	}

	/// <summary>
	/// Runs whatever this circuit owns at the head of the queue, one item at a time, until the head is
	/// something it cannot run. Re-entrant by design: a call while an item is executing claims nothing
	/// and returns, which is what makes the queue single-flight.
	/// </summary>
	private async Task PumpQueueAsync()
	{
		while (WorkQueue.TryDequeueForExecution(this, out var item))
		{
			Exception? error = null;

			// Stamped on this method's asynchronous flow, which the item's own work and everything it
			// logs runs inside. That — not the current selection — is what decides where its output
			// appears, so a run started on one node stays there however far the user navigates. Set
			// inside this async method, so it cannot escape into the caller that fired the pump.
			UiConsoleScope.NodeKey = _consoleNodeKeyByWorkItemId.TryGetValue(item.Id, out var nodeKey)
				? nodeKey
				: _selectedNodeKey;

			try
			{
				var progress = new Progress<string>(line => WorkQueue.ReportProgress(item, line));
				await item.Run(progress, WorkQueue.Token(item.Id) ?? CancellationToken.None);
			}
			catch (OperationCanceledException ex)
			{
				error = ex;
				AppendConsole($"⏹️ Stopped: {item.Title}");
			}
			catch (Exception ex)
			{
				error = ex;
				AppendConsole($"⛔ {item.Title}: {ex.Message}");
			}
			finally
			{
				WorkQueue.Complete(item, error);
				_consoleNodeKeyByWorkItemId.TryRemove(item.Id, out _);
			}

			await SafeStateHasChangedAsync();
		}
	}

	/// <summary>
	/// Queues work a child component asked for. Its output goes to the console like everything else,
	/// so a queued bulk run reads the same as one started from the toolbar.
	/// </summary>
	private void EnqueueRequestedWork(QueuedWork work)
		=> EnqueueWork(work.Title, work.Organization, work.DedupKey, async (progress, cancellationToken) =>
		{
			try
			{
				await work.Run(progress, cancellationToken);
			}
			finally
			{
				// The rows the run re-assessed are the ones the tree counts, so it has to be rebuilt or
				// it keeps reporting failures the run has just fixed. Once at the end rather than per
				// repository: rebuilding tears down every node and re-expands them, which flickers.
				_rows = Cache.GetCachedRows() ?? _rows;
				await ReloadTreePreservingExpansionAsync();
			}
		}, work.Step, work.RepositoryFullName);

	private void OnWorkQueueChanged() => _ = SafeStateHasChangedAsync();

	/// <summary>
	/// The number of repositories an issue-hierarchy node covers, or null for nodes where a count
	/// would mean nothing — an organisation, a package, the container nodes.
	/// </summary>
	private static int? AffectedRepoCountFor(NavItem? item)
		=> item?.AffectedRepoCount > 0
			&& item.View is NavView.IssueCategoryDetail or NavView.IssueRuleDetail
				? item.AffectedRepoCount
				: null;

	/// <summary>
	/// Excludes a repository from governance, or brings it back. Persisted immediately, because it is
	/// a decision about the estate rather than a filter for this session — an excluded repository is
	/// not assessed, not listed under any issue class, and not reachable by a bulk action.
	/// </summary>
	private async Task ToggleRepositoryExcludedAsync(string repositoryFullName, bool currentlyExcluded)
	{
		RuntimeSettings.SetRepositoryExcluded(repositoryFullName, !currentlyExcluded);
		AppendConsole(currentlyExcluded
			? $"👁️ {repositoryFullName} is governed again."
			: $"🚫 {repositoryFullName} is excluded from governance.");

		await ReloadTreePreservingExpansionAsync();
	}

	// === Build guard ===

	/// <summary>What the guard last told us about each repository, so only changes are narrated.</summary>
	private readonly Dictionary<string, GuardState> _reportedGuardStates = new(StringComparer.OrdinalIgnoreCase);

	/// <summary>
	/// Narrates guard activity to the console as it happens, and rebuilds the tree when a repository
	/// has been reverted.
	/// </summary>
	/// <remarks>
	/// The guard is an event stream — queued, building, verified — and events belong in the console.
	/// A revert is the exception: it means work the user did has been taken away, which must still be
	/// visible after the console has scrolled, so that one state also marks the repository's node.
	/// </remarks>
	private void OnGuardStatusesChanged() => _ = InvokeAsync(async () =>
	{
		try
		{
			var reverted = false;

			foreach (var status in RegressionGuard.Statuses)
			{
				if (_reportedGuardStates.TryGetValue(status.RepositoryFullName, out var reported)
					&& reported == status.State)
				{
					continue;
				}

				_reportedGuardStates[status.RepositoryFullName] = status.State;
				reverted |= status.State == GuardState.RegressionReverted;

				var line = status.State switch
				{
					GuardState.Verified => $"🛡️ {status.RepositoryFullName}: build verified after our change.",
					GuardState.RegressionReverted => $"↩️ {status.RepositoryFullName}: our change broke the build and has been reverted.",
					GuardState.BuildFailingNotOurs => $"⚠️ {status.RepositoryFullName}: build was already failing before our change.",
					GuardState.Error => $"⚠️ {status.RepositoryFullName}: the guard could not verify the build — {status.Message}",
					_ => null
				};

				if (line is not null)
				{
					AppendConsole(line);
				}
			}

			// Only a revert changes what the tree shows, and rebuilding it is not free.
			if (reverted)
			{
				await ReloadTreePreservingExpansionAsync();
			}
			else
			{
				await SafeStateHasChangedAsync();
			}
		}
		catch (ObjectDisposedException)
		{
			// The circuit has gone; nothing left to render.
		}
	});

	/// <summary>
	/// The icon for a guard state worth showing. Only states needing someone reach here — a verified
	/// repository shows nothing, because a wall of green is what hides the rows that matter.
	/// </summary>
	private static string GuardMarkerIcon(GuardState state) => state switch
	{
		GuardState.RegressionReverted => "fa-rotate-left",
		GuardState.BuildFailingNotOurs => "fa-triangle-exclamation",
		_ => "fa-circle-exclamation"
	};

	private static string GuardMarkerTooltip(GuardState state) => state switch
	{
		GuardState.RegressionReverted => "Our change broke the build and was reverted",
		GuardState.BuildFailingNotOurs => "This repository's build was already failing",
		_ => "The build guard could not verify this repository"
	};

	/// <summary>
	/// Re-renders, tolerating the circuit having gone away. Queued work outlives its component for as
	/// long as it takes to unwind, and must not fail while doing so.
	/// </summary>
	private async Task SafeStateHasChangedAsync()
	{
		try
		{
			await InvokeAsync(StateHasChanged);
		}
		catch (ObjectDisposedException)
		{
			// The circuit has gone; there is nothing left to render.
		}
	}

	/// <summary>
	/// Says something in the console. Logged rather than written straight into the buffer, so the same
	/// words reach stdout as well and there is exactly one path into the console:
	/// <see cref="OnLogLineWritten"/>, which is what actually appends it. The line is passed as an
	/// argument rather than as the template so that braces in a path or a message are not read as
	/// structured-logging placeholders.
	/// </summary>
	private void AppendConsole(string line) => Logger.LogInformation("{ConsoleLine}", line);

	/// <summary>
	/// Empties a console. Most callers are runs clearing the console before they start writing to it,
	/// so it targets the run's own node for the same reason its output does — clearing whatever the
	/// user has since clicked on would wipe an unrelated record. The toolbar's bin button is not in a
	/// run, and so clears what is on screen.
	/// </summary>
	private void ClearConsole()
	{
		var state = GetOrCreateNodeUiState(UiConsoleScope.NodeKey ?? _selectedNodeKey);
		state.ClearConsoleLines();
		state.LastPromptText = null;
		state.CopyFeedback = false;
		state.ConsoleCopyFeedback = false;
	}

	/// <summary>
	/// Appends one log line to the console it belongs to. Called from whichever thread logged it —
	/// which during an assessment is one of ten parallel workers — so the buffer guards itself and the
	/// re-render is only requested here, never performed.
	/// </summary>
	/// <param name="entry">The line, and the console it was scoped to when it was written.</param>
	private void OnLogLineWritten(UiConsoleLogEntry entry)
	{
		// Warnings and errors that were logged rather than narrated arrive without the marker the
		// console colours by, so they get one. Lines that already carry it are left alone.
		var text = entry.Level >= LogLevel.Error && !entry.Message.StartsWith('❌')
			? $"❌ {entry.Message}"
			: entry.Level == LogLevel.Warning && !entry.Message.StartsWith('⚠')
				? $"⚠️ {entry.Message}"
				: entry.Message;

		// An unscoped line was not produced by queued work — a click handler, or a background service —
		// so it belongs to whatever the user is looking at.
		GetOrCreateNodeUiState(entry.NodeKey ?? _selectedNodeKey)
			.AppendConsoleLine(new ConsoleLine(text, GetConsoleLineClass(text)));

		RequestConsoleRender();
	}

	/// <summary>
	/// Asks for a re-render, at most ten times a second. A refresh logs several hundred lines in a
	/// burst, and rendering each one on arrival would spend more of the circuit on the console than on
	/// the work it is reporting.
	/// </summary>
	private void RequestConsoleRender()
	{
		_consoleScrollPending = true;

		if (Interlocked.Exchange(ref _consoleRenderQueued, 1) == 1)
		{
			return;
		}

		_ = Task.Run(async () =>
		{
			await Task.Delay(100);

			// Cleared before rendering, so a line that arrives while this render is in flight queues
			// the next one rather than being held until something else happens to redraw.
			Interlocked.Exchange(ref _consoleRenderQueued, 0);
			await SafeStateHasChangedAsync();
		});
	}

	private async Task CopyConsoleToClipboardAsync()
	{
		if (CurrentConsoleLines.Length == 0)
		{
			return;
		}

		try
		{
			var text = string.Join(Environment.NewLine, CurrentConsoleLines.Select(l => l.Text));
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
			CurrentConsoleCopyFeedback = true;
			StateHasChanged();
			await Task.Delay(2000);
			CurrentConsoleCopyFeedback = false;
			StateHasChanged();
		}
		catch
		{
			AppendConsole("⚠️ Failed to copy to clipboard.");
		}
	}

	private async Task CopyPromptToClipboardAsync()
	{
		if (string.IsNullOrEmpty(CurrentLastPromptText))
		{
			return;
		}

		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentLastPromptText);
			CurrentCopyFeedback = true;
			StateHasChanged();
			await Task.Delay(2000);
			CurrentCopyFeedback = false;
			StateHasChanged();
		}
		catch
		{
			AppendConsole("⚠️ Failed to copy to clipboard.");
		}
	}

	private async Task AutoCopyAiPromptAsync(string prompt, WorkflowStep sourceStep, string reason)
	{
		if (string.IsNullOrWhiteSpace(prompt))
		{
			AppendConsole($"ℹ️ Could not generate an AI prompt for {reason}.");
			return;
		}

		CurrentLastPromptText = prompt;
		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentLastPromptText);
		}
		catch
		{
			AppendConsole("⚠️ Failed to auto-copy AI prompt to clipboard.");
		}
		AppendConsole($"✨ AI prompt for {reason} copied to clipboard. Open IDE and paste into Copilot Chat.");
		_ = TriggerAiClipboardCueAsync(sourceStep);
	}

	private async Task TriggerAiClipboardCueAsync(WorkflowStep sourceStep)
	{
		CurrentAiClipboardCueStep = sourceStep;
		StateHasChanged();

		await Task.Delay(2300);
		if (CurrentAiClipboardCueStep == sourceStep)
		{
			CurrentAiClipboardCueStep = null;
			StateHasChanged();
		}
	}

	// === Utility methods ===

	private static string GetLocalStateSuffix(RepositoryDashboardRow row)
	{
		if (!row.IsClonedLocally)
		{
			return "\n• Not cloned locally";
		}

		var sync = row.IsSyncedWithOrigin switch
		{
			true => "in sync with origin",
			false => "out of sync with origin",
			_ => "sync state unknown"
		};

		var dirty = row.IsWorkingTreeClean == false ? "; uncommitted changes" : string.Empty;
		return $"\n• Local clone, {sync}{dirty}";
	}

	/// <summary>
	/// Explains a branch node's rolled-up colour, so a grey heading above red and green children reads
	/// as "something below has not been assessed" rather than as a rendering glitch.
	/// </summary>
	private static string GetRolledUpHealthSuffix(NavItem item) => item.HealthStatus switch
	{
		PackageHealthStatus.Unknown => "\n• grey = worst below is unknown: something here has not been assessed",
		PackageHealthStatus.Pending => "\n• grey = assessment in progress below",
		PackageHealthStatus.Error => "\n• red = worst below is an error",
		PackageHealthStatus.Warning => "\n• amber = worst below is a warning",
		PackageHealthStatus.Info => "\n• blue = informational findings below",
		PackageHealthStatus.Success => "\n• green = everything below is compliant",
		_ => string.Empty
	};

	private string GetNavItemTooltip(NavItem item)
	{
		switch (item.View)
		{
			case NavView.Home:
				// Only what is governed is counted: the rest are accounted for in their own branch, and
				// counting them here would say the estate holds packages that nothing assesses.
				var governedRows = _rows.Where(r => r.IsGoverned).ToList();
				var assessed = governedRows.Count(r => r.Assessment is not null);
				return $"Dashboard — {governedRows.Count} repositories ({assessed} assessed, {item.IssueCount} issues)"
					+ GetRolledUpHealthSuffix(item);

			case NavView.RepositoryDetail:
			case NavView.PackageDetail:
				var row = RowForNavItem(item);
				if (row is null)
				{
					return item.RepositoryFullName ?? item.Text;
				}

				if (row.Assessment is null)
				{
					return row.Status switch
					{
						PackageStatus.Assessing => $"{row.RepositoryFullName}\n• assessing…{GetLocalStateSuffix(row)}",
						PackageStatus.Error => $"{row.RepositoryFullName}\n• not assessable: {row.StatusMessage}{GetLocalStateSuffix(row)}",
						_ => $"{row.RepositoryFullName}\n• not yet assessed{GetLocalStateSuffix(row)}"
					};
				}

				if (row.TotalFailures == 0)
				{
					return $"{row.RepositoryFullName}\n• all rules pass ✓ (green = compliant){GetLocalStateSuffix(row)}";
				}

				if (row.TotalErrors > 0)
				{
					return $"{row.RepositoryFullName}\n• {row.TotalErrors} error(s), {row.TotalWarnings} warning(s) (red = errors found){GetLocalStateSuffix(row)}";
				}

				return row.TotalWarnings > 0
					? $"{row.RepositoryFullName}\n• {row.TotalWarnings} warning(s) (amber = warnings only){GetLocalStateSuffix(row)}"
					: $"{row.RepositoryFullName}\n• informational only (blue = info){GetLocalStateSuffix(row)}";

			case NavView.CategoryDetail:
				if (item.IssueCount == 0)
				{
					return $"{item.Text} — all rules pass";
				}

				if (item.HasErrors)
				{
					return $"{item.Text} — {item.IssueCount} issue(s) including errors";
				}

				return item.HasWarnings
					? $"{item.Text} — {item.IssueCount} warning(s)"
					: $"{item.Text} — {item.IssueCount} informational";

			case NavView.RuleDetail:
				if (item.HasErrors)
				{
					return $"{item.Text} — error";
				}

				return item.HasWarnings
					? $"{item.Text} — warning"
					: $"{item.Text} — informational";

			default:
				return item.Text + GetRolledUpHealthSuffix(item);
		}
	}

	private static string GetPackageHealthIcon(RepositoryDashboardRow row)
	{
		return row.HealthStatus switch
		{
			PackageHealthStatus.Pending => "fas fa-spinner fa-spin text-muted",
			PackageHealthStatus.Success => "fas fa-cube text-success",
			PackageHealthStatus.Error => "fas fa-cube text-danger",
			PackageHealthStatus.Warning => "fas fa-cube text-warning",
			_ => "fas fa-cube text-info"
		};
	}

	private bool HasAutoRemediableFailures(AssessmentCategory category)
		=> _selectedRow?.Assessment?.RuleResults.Any(r => !r.Passed && r.Category == category && Dashboard.IsAutoRemediable(r)) == true;

	private List<CategoryGroup> GetGroupedFailures()
	{
		if (_selectedRow?.Assessment is null)
		{
			return [];
		}

		return _selectedRow.Assessment.RuleResults
			.Where(r => !r.Passed)
			.GroupBy(r => r.Category)
			.Select(g => new CategoryGroup { Category = g.Key, Failures = [.. g.OrderBy(r => SeverityColorRank(r.Severity)).ThenBy(r => r.RuleId)] })
			.OrderBy(GroupColorRank)
			.ThenBy(g => g.Category.ToString())
			.ToList();
	}

	private static string GetGroupBadgeClass(CategoryGroup group)
		=> group.Failures.Any(f => f.Severity is AssessmentSeverity.Critical or AssessmentSeverity.Error) ? "badge-fail"
		 : group.Failures.Any(f => f.Severity == AssessmentSeverity.Warning) ? "badge-warn"
		 : "badge-info";

	private static string GetSeverityBadgeClass(RuleResult result) => result.Severity switch
	{
		AssessmentSeverity.Critical or AssessmentSeverity.Error => "badge-fail",
		AssessmentSeverity.Warning => "badge-warn",
		_ => "badge-info"
	};

	// Colour rank for ordering the fix list: red (0) → amber (1) → blue (2), matching the badge colours above.
	// The ranking lives in DashboardService so the on-screen grouping and the AI prompt cannot drift apart.
	private static int SeverityColorRank(AssessmentSeverity severity) => DashboardService.SeverityRank(severity);

	private static int GroupColorRank(CategoryGroup group) => DashboardService.CategoryRank(group.Failures);

	private static string GetConsoleLineClass(string line)
		=> line.StartsWith("✅") ? "console-line console-success"
		 : line.StartsWith("❌") ? "console-line console-error"
		 : line.StartsWith("▶") ? "console-line console-action"
		 : line.StartsWith("──") ? "console-line console-divider"
		 : "console-line";

	private static string FormatDataValue(object? value)
		=> value is string s && s.Length > 200 ? s[..200] + "…" : value?.ToString() ?? "(null)";

	// === Settings methods ===

	private async Task BrowseForFolder()
	{
		if (_fileModal is null)
		{
			return;
		}

		var result = await _fileModal.ShowOpenAndWaitResultAsync(folderSelect: true).ConfigureAwait(true);
		if (string.IsNullOrEmpty(result))
		{
			return;
		}

		var chosen = LocalFileSystemDataProvider.VirtualToRealPath(result);

		// Choosing the folder the app would have picked anyway clears the override instead of pinning the
		// same path, so the setting keeps saying "automatic" and follows the app if it ever moves. This is
		// what replaces a reset button.
		var isDefault = string.Equals(
			Path.TrimEndingDirectorySeparator(chosen),
			Path.TrimEndingDirectorySeparator(LocalRepoService.GetDefaultReposRoot()),
			StringComparison.OrdinalIgnoreCase);

		await ChangeCloneRootAsync(isDefault ? null : chosen);
	}

	/// <summary>
	/// Points the app at a different clone root, taking the existing clones with it.
	/// </summary>
	/// <remarks>
	/// The clones move rather than being left where they were, because this root belongs to the app alone:
	/// anything stranded in the old one is used by nobody and would simply be fetched again into the new
	/// one. The setting is changed first so the destination is resolved by the same code that will read it
	/// afterwards, and reverted if the move turns out to be impossible.
	/// </remarks>
	private async Task ChangeCloneRootAsync(string? newRoot)
	{
		var previousSetting = _localReposRoot;
		var previousRoot = LocalRepo.GetReposRoot();

		_localReposRoot = newRoot;
		RuntimeSettings.SetLocalReposRoot(newRoot);

		// Created now rather than at the first clone, so the root is never a path that does not exist.
		var destinationRoot = LocalRepo.EnsureReposRootExists();

		if (string.Equals(previousRoot, destinationRoot, StringComparison.OrdinalIgnoreCase))
		{
			ConfirmSettingSaved();
			return;
		}

		var clones = LocalRepoService.EnumerateClones(previousRoot);
		if (clones.Count > 0)
		{
			var confirmed = await ConfirmAsync(
				$"Move {clones.Count} cloned repositor{(clones.Count == 1 ? "y" : "ies")} from {previousRoot} to {destinationRoot}?");

			if (!confirmed)
			{
				// Put the setting back: half-changing it would leave the app looking somewhere empty.
				_localReposRoot = previousSetting;
				RuntimeSettings.SetLocalReposRoot(previousSetting);
				StateHasChanged();
				return;
			}

			_consoleVisible = true;
			AppendConsole($"▶️ Moving {clones.Count} clone(s) to {destinationRoot}...");
			await InvokeAsync(StateHasChanged);

			var (moved, failures) = LocalRepo.MoveClones(previousRoot, destinationRoot, line =>
			{
				AppendConsole(line);
				InvokeAsync(StateHasChanged);
			});

			AppendConsole($"✅ Moved {moved} of {clones.Count} clone(s).");

			if (failures.Count > 0)
			{
				foreach (var failure in failures)
				{
					AppendConsole($"❌ {failure}");
				}

				await NotifyAsync(
					$"{moved} of {clones.Count} clones moved to {destinationRoot}.\n\n"
					+ $"{failures.Count} could not be moved and are still in {previousRoot}. The app will re-clone those when it needs them, so that folder can be deleted once you have checked it.",
					"Some clones stayed behind",
					"fas fa-triangle-exclamation");
			}
		}

		// Every row's LocalPath was built from the old root.
		await Dashboard.ReconcileLocalStateAsync(_rows);
		Cache.SetRows(_rows);
		await ReloadTreePreservingExpansionAsync();
		ConfirmSettingSaved();
	}

	/// <summary>
	/// Flashes the "✓ Saved" acknowledgement beside the setting.
	/// </summary>
	private void ConfirmSettingSaved()
	{
		_folderSaved = true;
		StateHasChanged();
		_ = Task.Delay(2000).ContinueWith(_ => { _folderSaved = false; InvokeAsync(StateHasChanged); });
	}

	private void OnPreferredIdeChanged(ChangeEventArgs e)
	{
		var value = e.Value?.ToString();
		_preferredIdeId = string.IsNullOrEmpty(value) ? null : value;
		RuntimeSettings.SetPreferredIdeId(_preferredIdeId);
		StateHasChanged();
	}

	// === IDE methods ===

	private InstalledIde? GetPreferredIde()
	{
		var ides = IdeDetection.DetectedIdes;
		if (ides.Count == 0)
		{
			return null;
		}

		if (_preferredIdeId is not null)
		{
			var preferred = ides.FirstOrDefault(i => i.Id == _preferredIdeId);
			if (preferred is not null)
			{
				return preferred;
			}
		}

		// Use auto-default priority when user hasn't chosen
		var defaultId = IdeDetection.GetDefaultIdeId();
		return defaultId is not null
			? ides.FirstOrDefault(i => i.Id == defaultId) ?? ides[0]
			: ides[0];
	}

	private string GetPreferredIdeIcon()
		=> GetPreferredIde()?.IconCss ?? "fas fa-external-link-alt";

	private void OpenInIde()
	{
		if (_selectedRow is null)
		{
			AppendConsole("❌ No package selected.");
			StateHasChanged();
			return;
		}

		if (_selectedRow.LocalPath is null)
		{
			AppendConsole("❌ Repository path not set. Run Git Sync/Clone first.");
			StateHasChanged();
			return;
		}

		if (!Directory.Exists(_selectedRow.LocalPath))
		{
			AppendConsole($"❌ Repository folder not found: {_selectedRow.LocalPath}");
			StateHasChanged();
			return;
		}

		var ide = GetPreferredIde();
		if (ide is null)
		{
			AppendConsole("❌ No supported IDE detected. Install Visual Studio, VS Code, or JetBrains Rider.");
			StateHasChanged();
			return;
		}

		try
		{
			var launch = IdeDetection.OpenInIde(ide, _selectedRow.LocalPath);

			if (!launch.Started)
			{
				AppendConsole($"❌ Failed to launch {ide.DisplayName}: {launch.DiagnosticMessage}");
				StateHasChanged();
				return;
			}

			AppendConsole($"✅ Opened {_selectedRow.RepositoryFullName} in {ide.DisplayName}");
			AppendConsole($"ℹ️ IDE launch: id={launch.IdeId}, exe={launch.ExecutablePath}");
			AppendConsole($"ℹ️ IDE target: {launch.TargetPath}");
			AppendConsole($"ℹ️ IDE PID: {launch.ProcessId?.ToString() ?? "(unknown)"}");

			if (launch.IsLaunchedProcessForeground.HasValue)
			{
				if (launch.IsLaunchedProcessForeground.Value)
				{
					AppendConsole($"✅ Foreground check passed: PID {launch.ProcessId} is the foreground window process.");
				}
				else
				{
					AppendConsole($"⚠️ Foreground check failed: foreground PID is {launch.ForegroundProcessId}, launched PID is {launch.ProcessId}.");
				}
			}

			if (!string.IsNullOrWhiteSpace(launch.DiagnosticMessage))
			{
				AppendConsole($"ℹ️ IDE diagnostic: {launch.DiagnosticMessage}");
			}

			if (launch.ExitedQuickly)
			{
				AppendConsole($"ℹ️ IDE exit code: {launch.ExitCode?.ToString() ?? "(unknown)"}");
				if (!string.IsNullOrWhiteSpace(launch.ErrorOutput))
				{
					AppendConsole($"ℹ️ IDE error output: {launch.ErrorOutput}");
				}
			}
		}
		catch (Exception ex)
		{
			AppendConsole($"❌ Failed to open IDE: {ex.Message}");
		}

		StateHasChanged();
	}

	private async Task FixWithAiAsync()
	{
		if (_selectedRow is null)
		{
			return;
		}

		_isRunning = true;
		_activeWorkflowStep = WorkflowStep.FixWithAi;

		// Open the IDE
		OpenInIde();

		try
		{
			if (_lastFailedWorkflowStep is WorkflowStep.Build or WorkflowStep.Test)
			{
				await ResolveWorkflowFailureAsync(_lastFailedWorkflowStep.Value);
			}
			else
			{
				await ResolveAllAsync();
			}

			_completedSteps.Add(WorkflowStep.FixWithAi);
		}
		finally
		{
			_activeWorkflowStep = null;
			_isRunning = false;
			StateHasChanged();
		}
	}

	private bool IsFixWithAiEnabled()
	{
		if (_selectedRow is null || _isRunning)
		{
			return false;
		}

		if (_selectedRow.Assessment is null && _lastFailedWorkflowStep is not WorkflowStep.Build and not WorkflowStep.Test)
		{
			return false;
		}

		if (!_selectedRow.IsClonedLocally || _selectedRow.LocalPath is null)
		{
			return false;
		}

		var hasWorkflowFailure = _lastFailedWorkflowStep is WorkflowStep.Build or WorkflowStep.Test;
     var ruleResults = _selectedRow.Assessment?.RuleResults;
		var hasFailures = ruleResults?.Any(r => !r.Passed) == true;

		if (hasWorkflowFailure)
		{
			return true;
		}

		if (!hasFailures)
		{
			return false;
		}

		// Enabled when there are non-auto-remediable failures,
		// OR when Fix has already been run but failures still remain
		// (indicating auto-fix couldn't resolve them)
     var hasManualOnly = ruleResults?.Any(r => !r.Passed && !Dashboard.IsAutoRemediable(r)) == true;

		return hasManualOnly || IsStepDone(WorkflowStep.Fix);
	}

	private bool IsOpenIdeEnabled()
	{
		if (_selectedRow is null || _isRunning)
		{
			return false;
		}

		if (_selectedRow.LocalPath is null)
		{
			return false;
		}

		return Directory.Exists(_selectedRow.LocalPath);
	}

	private string GetOpenIdeTooltip()
	{
		if (_selectedRow is null)
		{
			return "Select a package first";
		}

		if (_isRunning)
		{
			return "Another operation is running";
		}

		if (_selectedRow.LocalPath is null)
		{
			return "Run Git Sync to clone the repository first";
		}

		if (!Directory.Exists(_selectedRow.LocalPath))
		{
			return "Repository folder is missing locally";
		}

		return "Open selected repository in IDE";
	}

	private bool IsGitSyncEnabled()
		=> !_isRunning && _selectedRow?.IsWorkingTreeClean != false;

	private string GetGitSyncTooltip()
	{
		if (_selectedRow?.IsWorkingTreeClean == false)
		{
			return "Working tree has uncommitted changes — commit or stash changes first";
		}

		return "Clone if needed, then fetch, pull --rebase, push";
	}

	private string GetFixWithAiTooltip()
	{
		if (_selectedRow is null)
		{
			return "Select a package first";
		}

		if (_lastFailedWorkflowStep == WorkflowStep.Build)
		{
			return "Copy AI prompt for the latest build failure";
		}

		if (_lastFailedWorkflowStep == WorkflowStep.Test)
		{
			return "Copy AI prompt for the latest test failure";
		}

		if (_selectedRow.Assessment is null)
		{
			return "Assess the package first";
		}

		if (!_selectedRow.IsClonedLocally)
		{
			return "Clone the repository first";
		}

		var remainingCount = _selectedRow.Assessment.RuleResults
			.Count(r => !r.Passed);

		if (remainingCount == 0)
		{
			return "No issues remaining";
		}

		var manualCount = _selectedRow.Assessment.RuleResults
			.Count(r => !r.Passed && !Dashboard.IsAutoRemediable(r));

		if (manualCount == 0 && !IsStepDone(WorkflowStep.Fix))
		{
			return "Run Fix first — all remaining issues may be auto-fixable";
		}

		return $"Copy AI prompt for {remainingCount} remaining issue{(remainingCount == 1 ? "" : "s")}";
	}

	private async Task CommitAndPushAsync()
	{
		if (_selectedRow is null)
		{
			return;
		}

		EnsureSelectedRowIsCurrent();

		var capturedRow = _selectedRow;
		EnqueueWork(
			$"Commit & push {_selectedRow.RepositoryFullName}",
			_selectedRow.Organization,
			$"commit-push:{_selectedRow.RepositoryFullName}",
			(progress, cancellationToken) => CommitAndPushCoreAsync(capturedRow, progress, cancellationToken),
			WorkflowStep.CommitAndPush,
			_selectedRow.RepositoryFullName);
	}

	private async Task CommitAndPushCoreAsync(RepositoryDashboardRow row, IProgress<string> progress, CancellationToken cancellationToken)
	{
		_isRunning = true;
		ClearConsole();
		AppendConsole("▶ Committing and pushing...");
		StateHasChanged();

		try
		{
			var commitMessage = $"NuGet governance remediation for {row.RepositoryFullName}";
			var push = await Dashboard.CommitAndPushAsync(row, commitMessage, line =>
			{
				AppendConsole(line);
				InvokeAsync(StateHasChanged);
			});

			if (push.Success)
			{
				_completedSteps.Add(WorkflowStep.CommitAndPush);
				AppendConsole("✅ Changes committed and pushed");
				await PersistSelectedRowUpdateAsync();

				if (row.CurrentBranch is not null)
				{
					AppendConsole($"ℹ️ Branch: {row.CurrentBranch} | Clean: {row.IsWorkingTreeClean} | Synced: {row.IsSyncedWithOrigin}");
				}
			}
			else
			{
				AppendConsole("❌ Commit and push failed");
				await PersistSelectedRowUpdateAsync();

				// A guard's refusal is the conclusion of the whole fix attempt, so it is put in front of
				// the user rather than left in the console — which may be collapsed, and is easy to miss
				// scrolling past even when it is not. A plain git failure is not raised this way: git has
				// already explained itself in the output, and there is nothing to decide.
				if (push.WasRefused)
				{
					_isRunning = false;
					await NotifyAsync(push.RefusalReason!, "Nothing was pushed", "fas fa-triangle-exclamation");
				}
			}
		}
		catch (Exception ex)
		{
			AppendConsole($"❌ Error: {ex.Message}");
		}
		finally
		{
			_isRunning = false;
			StateHasChanged();
		}
	}

	public void Dispose()
	{
		// This circuit executes its own queued work, so it cannot leave any behind: pending items are
		// dropped and a running one is cancelled, which reverts whatever it had half-applied. The
		// running task itself outlives the component long enough to unwind and report completion.
		WorkQueue.Changed -= OnWorkQueueChanged;
		RegressionGuard.StatusesChanged -= OnGuardStatusesChanged;
		LogSink.LineWritten -= OnLogLineWritten;
		WorkQueue.RemoveOwnedBy(this);
		_autoRefreshTimer?.Dispose();
		_treeFilterDebounce?.Dispose();
		_doneClearTimer?.Dispose();
	}

	// === Workflow step indicators ===

	private bool IsStepDone(WorkflowStep step)
	{
		// Explicit tracking for steps that don't map to PackageStatus
		if (_completedSteps.Contains(step))
		{
			return true;
		}

		// PackageStatus-based tracking for workflow steps
		return _selectedRow?.Status switch
		{
			PackageStatus.GitSynced => step == WorkflowStep.GitSync,
			PackageStatus.Assessed => step is WorkflowStep.GitSync or WorkflowStep.Reassess,
			PackageStatus.Remediated => step is WorkflowStep.GitSync or WorkflowStep.Reassess or WorkflowStep.Fix,
			PackageStatus.BuildFailed => step is WorkflowStep.GitSync or WorkflowStep.Reassess or WorkflowStep.Fix,
			PackageStatus.BuildSucceeded => step is WorkflowStep.GitSync or WorkflowStep.Reassess or WorkflowStep.Fix or WorkflowStep.Build,
			PackageStatus.TestsFailed => step is WorkflowStep.GitSync or WorkflowStep.Reassess or WorkflowStep.Fix or WorkflowStep.Build,
			PackageStatus.TestsPassed => step is WorkflowStep.GitSync or WorkflowStep.Reassess or WorkflowStep.Fix or WorkflowStep.Build or WorkflowStep.Test,
			PackageStatus.Published => step is WorkflowStep.GitSync or WorkflowStep.Reassess or WorkflowStep.Fix or WorkflowStep.Build or WorkflowStep.Test or WorkflowStep.Publish,
			_ => false
		};
	}

	private bool IsPublishDone() => _selectedRow?.Status == PackageStatus.Published;

	private bool IsStepFailed(WorkflowStep step)
	{
		if (_failedSteps.Contains(step))
		{
			return true;
		}

		return _selectedRow?.Status switch
		{
			PackageStatus.BuildFailed => step == WorkflowStep.Build,
			PackageStatus.TestsFailed => step == WorkflowStep.Test,
			_ => false
		};
	}

	/// <summary>
	/// The CSS for a workflow-step toolbar button: the shared button scheme plus any state modifier.
	/// </summary>
	/// <remarks>
	/// btn-primary is the base in every state so these buttons match Rediscover rather than falling
	/// back to the toolbar's default dark-blue-with-white-outline look, which made the workflow steps
	/// appear to be a different kind of control. The step-state classes still show through: each marks
	/// itself with !important on the properties it cares about (border and text colour), so done,
	/// failed and next-up remain distinguishable on top of the shared scheme.
	/// </remarks>
	/// <summary>
	/// The class for the caret that follows <paramref name="precedingStep"/>. It turns orange once that
	/// step is done, so the run of orange carets shows how far through the flow you are and the point
	/// where they stop is where you are up to.
	/// </summary>
	/// <remarks>
	/// The next step's amber button outline is a 2px border that is genuinely hard to pick out; the
	/// carets are far more legible, so they carry the "where am I" signal and the outline stays as a
	/// secondary cue on the next button.
	/// </remarks>
	private string FlowChevronCss(WorkflowStep precedingStep)
		=> IsStepDone(precedingStep) ? "flow-chevron flow-chevron-passed" : "flow-chevron";

	private string GetStepCssClass(WorkflowStep step)
	{
		if (IsStepFailed(step))
		{
			return "btn-primary toolbar-step-failed";
		}

		return IsStepDone(step) ? "btn-primary toolbar-step-done" : "btn-primary";
	}

	private string GetStepCssClassFull(WorkflowStep step)
	{
		var baseCss = GetStepCssClass(step);
		if (CurrentAiClipboardCueStep == step)
		{
			baseCss = string.IsNullOrWhiteSpace(baseCss) ? "toolbar-ai-ready" : $"{baseCss} toolbar-ai-ready";
		}

		if (!IsStepDone(step) && !IsStepFailed(step) && !IsStepRunning(step) && GetNextPendingStep() == step)
		{
			baseCss = string.IsNullOrWhiteSpace(baseCss) ? "toolbar-step-next" : $"{baseCss} toolbar-step-next";
		}

		return baseCss;
	}

	private WorkflowStep? GetNextPendingStep()
	{
		if (_selectedRow is null)
		{
			return null;
		}

		WorkflowStep[] order = [
			WorkflowStep.GitSync,
			WorkflowStep.Reassess,
			WorkflowStep.Fix,
			WorkflowStep.Build,
			WorkflowStep.Test,
			WorkflowStep.CommitAndPush,
			WorkflowStep.Publish
		];

		foreach (var s in order)
		{
			if (IsStepFailed(s))
			{
				return null;
			}

			if (!IsStepDone(s))
			{
				return s;
			}
		}

		return null;
	}

	private string GetPublishCssClass()
	{
		if (!IsPublishEnabled())
		{
			// Not publishable yet — render neutral (like Build/Test) so green means "ready to publish".
			return GetStepCssClassFull(WorkflowStep.Publish);
		}

		var css = "btn-success";
		if (IsPublishDone())
		{
			css += " toolbar-step-done";
		}

		return css;
	}

