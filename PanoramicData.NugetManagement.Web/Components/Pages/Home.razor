	/// <summary>
	/// The Ollama settings as edited on the settings page, before Save.
	/// </summary>
	/// <remarks>
	/// A copy rather than the live settings object: typing a partial URL should not disable the Fix with
	/// AI button on every keystroke, and abandoning the page should change nothing.
	/// </remarks>
	private OllamaOptions _ollamaDraft = new();

	/// <summary>What the last Save or Test said, shown beside the buttons.</summary>
	private string? _ollamaStatus;

	private bool _isTestingOllama;

	/// <summary>
	/// Fills the draft from what is stored, so the page opens showing the current configuration.
	/// </summary>
	private void LoadOllamaDraft()
	{
		var stored = RuntimeSettings.Ollama;

		_ollamaDraft = new OllamaOptions
		{
			BaseUrl = stored.BaseUrl,
			ApiKey = stored.ApiKey,
			Model = stored.Model,
			ContextWindow = stored.ContextWindow,
			RequestTimeoutMs = stored.RequestTimeoutMs,
			MaxConcurrency = stored.MaxConcurrency,
			MaxTurnsPerAttempt = stored.MaxTurnsPerAttempt,
			MaxAttemptsPerRule = stored.MaxAttemptsPerRule
		};

		_ollamaStatus = null;
	}

	private void SaveOllamaSettings()
	{
		RuntimeSettings.SetOllama(_ollamaDraft);

		// Read back rather than echoing the draft: the setter clamps, so this is the only honest way to
		// show what was actually stored.
		LoadOllamaDraft();

		_ollamaStatus = RuntimeSettings.Ollama.IsConfigured
			? "Saved."
			: "Saved, but incomplete — a base URL and a model are both needed before Fix with AI appears.";
	}

	/// <summary>
	/// Asks the configured server for its model list, which proves the address, the key and the model
	/// name in one call and without generating anything.
	/// </summary>
	private async Task TestOllamaConnection()
	{
		if (!_ollamaDraft.IsConfigured)
		{
			_ollamaStatus = "Set a base URL and a model first.";
			return;
		}

		_isTestingOllama = true;
		_ollamaStatus = null;

		try
		{
			using var client = new Ollama.Api.OllamaClient(new Ollama.Api.OllamaClientOptions
			{
				Uri = new Uri(_ollamaDraft.BaseUrl!),
				ApiKey = _ollamaDraft.ApiKey,
				Timeout = TimeSpan.FromSeconds(30)
			});

			var tags = await client.Models.GetTagsAsync(CancellationToken.None);
			var names = tags.Models?.Select(m => m.Name).ToList() ?? [];

			_ollamaStatus = names.Any(name =>
				string.Equals(name, _ollamaDraft.Model, StringComparison.OrdinalIgnoreCase))
				? $"Connected. {_ollamaDraft.Model} is available."
				: $"Connected, but {_ollamaDraft.Model} is not pulled on that server. Available: "
					+ $"{(names.Count == 0 ? "none" : string.Join(", ", names.Take(10)))}.";
		}
		catch (Exception ex)
		{
			// Shown rather than logged: whoever is filling this form is the person who can fix a wrong
			// address, and sending them to the console for the reason would be unkind.
			_ollamaStatus = $"Could not connect: {ex.Message}";
		}
		finally
		{
			_isTestingOllama = false;
		}
	}

	/// <summary>
	/// How many of the selected repository's failing rules the local model could attempt.
	/// </summary>
	private int AiFixCandidateCount()
		=> _selectedRow is null ? 0 : AiFixCandidates.For(_selectedRow, Remediations).Count;

	/// <summary>
	/// Whether fixing locally is possible right now.
	/// </summary>
	/// <remarks>
	/// Requires a configured server as well as candidates: offering it without one queues items that can
	/// only fail, which reads as the feature being broken rather than unconfigured.
	/// </remarks>
	private bool IsFixWithAiEnabled()
		=> AiFixCandidateCount() > 0
			&& RuntimeSettings.Ollama.IsConfigured
			&& !IsStepQueueBlocked(WorkflowStep.Fix);

	/// <summary>
	/// What pressing it will do, said before it is pressed.
	/// </summary>
	private string GetFixWithAiTooltip()
	{
		var count = AiFixCandidateCount();
		var ollama = RuntimeSettings.Ollama;

		return !ollama.IsConfigured
			? "No local model is configured — set one under Settings, Ollama Config."
			: $"Ask {ollama.Model} to fix {count} rule(s) that have no automatic remediation. "
				+ "One queued item each; the changes are left in the working tree for you to review.";
	}

	/// <summary>
	/// Queues one local-model fix per rule that no deterministic remediation covers.
	/// </summary>
	/// <remarks>
	/// Distinct from <c>FixWithAiAsync</c>, which hands the same problems to a frontier model in an IDE.
	/// This one runs on the configured Ollama server instead, which costs nothing and needs no IDE — and
	/// is far weaker, which is why every fix is checked against the rule that asked for it.
	/// </remarks>
	private Task FixWithAiAsync()
	{
		if (_selectedRow is null)
		{
			return Task.CompletedTask;
		}

		EnsureSelectedRowIsCurrent();

		var candidates = AiFixCandidates.For(_selectedRow, Remediations);

		if (candidates.Count == 0)
		{
			AppendConsole("Nothing here needs the model: every failing rule has an automatic remediation.");
			return Task.CompletedTask;
		}

		var queued = FanOut.EnqueueAiFix(
			_selectedRow.Organization,
			_selectedRow.RepositoryFullName,
			candidates,
			_selectedNodeKey);

		AppendConsole($"⏳ Queued {queued} local-model fix(es) for {_selectedRow.RepositoryName}: "
			+ $"{string.Join(", ", candidates)}.");

		return Task.CompletedTask;
	}

	private async Task ReassessAllReposAsync() => await ReassessOrganizationAsync(null);

	/// <summary>
	/// Re-reads one organisation's package list from NuGet and assesses it, leaving every other
	/// organisation's rows untouched. This is the org-node counterpart of the dashboard's
	/// "Rediscover Orgs", which does the same for all of them.
	/// </summary>
	private async Task RediscoverOrganizationAsync(string organization)
	{
		var existingForOrg = _rows
			.Where(r => string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))
			.ToList();

		if (!await ConfirmApiBudgetAsync(
			$"Rediscovering and assessing {organization}",
			EstimateRemoteAssessmentCost(existingForOrg)))
		{
			return;
		}

		var title = $"Rediscover {organization}";
		var queued = Lanes.Enqueue(
			title,
			WorkDescriptor.ForOrganization(WorkKind.RediscoverOrganization, organization),
			$"rediscover:{organization}",
			step: null,
			_selectedNodeKey);

		AppendConsole(DescribeQueued(queued, title));
	}

	/// <summary>
	/// Re-assesses every repository, or only one organisation's when <paramref name="organization"/>
	/// is supplied. Scoping matters because assessing every organisation multiplies the GitHub API
	/// cost for no benefit when only one of them is being worked on.
	/// </summary>
	private async Task ReassessOrganizationAsync(string? organization)
	{
		var assessable = _rows
			.Where(r => r.IsGoverned)
			.Where(r => r.RepositoryFullName is not null)
			.Where(r => !RuntimeSettings.IsRepositoryExcluded(r.RepositoryFullName))
			.Where(r => organization is null
				|| string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))
			.ToList();

		if (assessable.Count == 0)
		{
			AppendConsole("Nothing to re-assess.");
			return;
		}

		var scope = organization is null ? "repositories" : $"{organization} repositories";
		if (!await ConfirmApiBudgetAsync($"Re-assessing {assessable.Count} {scope}", EstimateRemoteAssessmentCost(assessable)))
		{
			return;
		}

		// Confirmation happens on the click; the run itself goes on the lane, because a dialog
		// appearing when the item finally starts would block the lane on an answer nobody is
		// waiting to give.
		var title = $"Re-assess {organization ?? "every organisation"} — {assessable.Count} repos";
		var queued = Lanes.Enqueue(
			title,
			WorkDescriptor.ForOrganization(WorkKind.DiscoverReassessTargets, organization),
			$"reassess:{organization ?? "*"}",
			step: null,
			_selectedNodeKey);

		AppendConsole(DescribeQueued(queued, title));
	}

	private async Task ReassessCategoryAsync(AssessmentCategory category)
	{
		if (_selectedRow is null)
		{
			return;
		}

		EnsureSelectedRowIsCurrent();

		_isAssessing = true;
		_progressMessage = $"Assessing {category}...";
		StateHasChanged();

		try
		{
			// Hoisted out of the else: the local path wants a client too, to read the repository's
			// inbox. Constructing one is local and free, so both branches can simply have one.
			var github = CreateGitHubClient();

			if (_selectedRow.IsClonedLocally && _selectedRow.LocalPath is not null)
			{
				await Dashboard.AssessLocalRepositoryAsync(_selectedRow, CancellationToken.None, github);
				await Dashboard.RefreshGitStatusAsync(_selectedRow);
				await AppendDirtyWorkingTreePreviewAsync();
			}
			else
			{
				await Dashboard.AssessRepositoryAsync(_selectedRow, github);
			}

           await PersistSelectedRowUpdateAsync();
			AppendConsole($"✅ Re-assessed {category} for {_selectedRow.RepositoryFullName}");
		}
		catch (Exception ex)
		{
			AppendConsole($"❌ Error: {ex.Message}");
		}
		finally
		{
			_isAssessing = false;
			_progressMessage = string.Empty;
			StateHasChanged();
		}
	}

	/// <summary>
	/// Fixes everything beneath the selected node.
	/// </summary>
	/// <remarks>
	/// The one button that fixes things. What that means depends on what is selected — see
	/// <see cref="FixScope"/> — and both halves can apply at once: on a repository, the remediations are
	/// queued first and the Dependabot triage behind them, on the same lane. That order matters, because
	/// a remediation that moves a version is what turns a still-valid pull request into one triage can
	/// close.
	/// </remarks>
	private async Task FixAllAsync()
	{
		if (IsEstateWide)
		{
			// Remediations first and triage behind them, per repository, for the reason the remarks
			// above give: a fix that moves a version is what turns a still-valid pull request into one
			// triage can close. Two passes rather than one interleaved loop so every repository's fix
			// is queued before any of its triage, matching the single-repository order exactly.
			QueueAcrossEstate(WorkKind.FixAll, WorkflowStep.Fix, "Fix");
			QueueAcrossEstate(WorkKind.TriageDependabot, WorkflowStep.Fix, "Triage Dependabot");
			return;
		}

		if (_selectedRow is null)
		{
			return;
		}

		EnsureSelectedRowIsCurrent();

		var scope = FixScope.For(_currentView);

		if (scope.ApplyRemediations && CanApplyRemediations())
		{
			var blockReason = GetFixBlockReason(CanRunMasterToMainAutoFix());

			if (blockReason is not null)
			{
				AppendConsole($"❌ Cannot fix: {blockReason}");
				StateHasChanged();
				return;
			}

			QueueForSelectedRepository(WorkKind.FixAll, $"Fix {_selectedRow.RepositoryFullName}", WorkflowStep.Fix);
		}

		if (scope.TriageDependabot && CanTriageDependabot())
		{
			QueueForSelectedRepository(
				WorkKind.TriageDependabot,
				$"Triage Dependabot for {_selectedRow.RepositoryName}");
		}
	}

	private async Task FixCategoryAsync(AssessmentCategory category)
	{
		if (_selectedRow is null || !_selectedRow.IsClonedLocally)
		{
			return;
		}

		EnsureSelectedRowIsCurrent();

		var allowMasterToMainFlow = category == AssessmentCategory.RepositoryHygiene && CanRunMasterToMainAutoFix();
		var blockReason = GetFixBlockReason(allowMasterToMainFlow);
		if (blockReason is not null)
		{
			AppendConsole($"❌ Cannot fix: {blockReason}");
			StateHasChanged();
			return;
		}

		QueueForSelectedRepository(
			WorkKind.FixCategory,
			$"Fix {category} — {_selectedRow.RepositoryFullName}",
			step: null,
			("category", category.ToString()));
	}

	private async Task FixSingleRuleAsync(RuleResult result)
	{
		if (_selectedRow is null || !_selectedRow.IsClonedLocally || _selectedRow.LocalPath is null || result.Advisory is null)
		{
			return;
		}

		EnsureSelectedRowIsCurrent();

		if (!Dashboard.IsAutoRemediable(result))
		{
			return;
		}

		var blockReason = GetFixBlockReason(result.RuleId == "REPO-06");
		if (blockReason is not null)
		{
			AppendConsole($"❌ Cannot fix: {blockReason}");
			StateHasChanged();
			return;
		}

		QueueForSelectedRepository(
			WorkKind.FixRule,
			$"Fix {result.RuleId} — {_selectedRow.RepositoryFullName}",
			step: null,
			("ruleId", result.RuleId));
	}

	// === Build / Test / Git Sync / Publish ===

	private Task BuildAsync()
	{
		if (IsEstateWide)
