	private void OnTreeFilterInput(ChangeEventArgs e)
	{
		_treeFilterText = e.Value?.ToString() ?? string.Empty;
		_treeFilterError = null;

		// Debounce: wait 300ms after the user stops typing before applying the filter
		_treeFilterDebounce?.Dispose();
		_treeFilterDebounce = new System.Threading.Timer(
			_ => InvokeAsync(ApplyTreeFilter),
			null,
			300,
			Timeout.Infinite);
	}

	private async Task ApplyTreeFilter()
	{
		if (string.IsNullOrWhiteSpace(_treeFilterText))
		{
			NavDataProvider.FilterRegex = null;
			_treeFilterError = null;
		}
		else
		{
			try
			{
				NavDataProvider.FilterRegex = new System.Text.RegularExpressions.Regex(
					_treeFilterText,
					System.Text.RegularExpressions.RegexOptions.IgnoreCase,
					TimeSpan.FromMilliseconds(200));
				_treeFilterError = null;
			}
			catch (System.Text.RegularExpressions.RegexParseException)
			{
				_treeFilterError = "Invalid regex";
				return;
			}
		}

		await RefreshTreeStructureAsync();

		StateHasChanged();
	}

	private async Task ClearTreeFilter()
	{
		_treeFilterText = string.Empty;
		_treeFilterError = null;
		NavDataProvider.FilterRegex = null;

		await RefreshTreeStructureAsync();

		StateHasChanged();
	}

	private async Task OnLocalOnlyChanged(ChangeEventArgs e)
	{
		_localOnly = e.Value is true;
		NavDataProvider.LocalOnly = _localOnly;

		await RefreshTreeStructureAsync();

		StateHasChanged();
	}

	/// <summary>
	/// Reloads the tree's top-level node children so filter changes (regex / local-only) are
	/// actually applied. PDTree.RefreshAsync only refreshes the selected node's path and never
	/// reloads the organisation node's children, so on its own it does not prune filtered-out
	/// packages. RefreshNodeAsync clears and re-fetches a node's children from the data provider,
	/// which applies the current filter.
	/// </summary>
	private async Task RefreshTreeStructureAsync()
	{
		if (_navTree is null)
		{
			return;
		}

		var topNodes = _navTree.RootNode.Nodes?.ToList();
		if (topNodes is null)
		{
			return;
		}

		foreach (var node in topNodes)
		{
			await _navTree.RefreshNodeAsync(node).ConfigureAwait(true);
		}

		// Packages now sit three levels down (Organisations > org > Repositories > repo) and are
		// collapsed after a refresh. Expand that path so the (possibly filtered) repository list
		// is visible rather than hidden under collapsed ancestors. With several organisations the
		// path has to be expanded for each of them, not just one hard-coded "root".
		var pathKeys = new List<string> { NavTreeDataProvider.OrganisationsKey };
		foreach (var organization in RuntimeSettings.Organizations)
		{
			pathKeys.Add(NavTreeDataProvider.OrgKey(organization));
			pathKeys.Add(NavTreeDataProvider.ReposKey(organization));
		}

		foreach (var key in pathKeys)
		{
			var pathNode = _navTree.RootNode.Find(key);
			if (pathNode is not null && !pathNode.IsExpanded)
			{
				await _navTree.ToggleNodeIsExpandedAsync(pathNode).ConfigureAwait(true);
			}
		}
	}

	/// <summary>
	/// Rebuilds the tree's nodes from the (now-current) data provider while preserving which
	/// branches the user had expanded — used after a data load so the repo list fills in without
	/// collapsing the view. PDTree.RefreshAsync only refreshes the selected path, so it can't do this.
	/// </summary>
	private async Task ReloadTreePreservingExpansionAsync()
	{
		if (_navTree is null)
		{
			return;
		}

		// Remember which branches are open so the rebuild doesn't collapse the user's view.
		var expandedKeys = new HashSet<string>();
		_navTree.RootNode.Walk(n => { if (n.IsExpanded && n.Key is not null) { expandedKeys.Add(n.Key); } return true; });

		var topNodes = _navTree.RootNode.Nodes?.ToList();
		if (topNodes is null)
		{
			return;
		}

		foreach (var node in topNodes)
		{
			await _navTree.RefreshNodeAsync(node).ConfigureAwait(true);
		}

		// Organisations is always expanded; restore everything else that was open before.
		expandedKeys.Add("organisations");
		foreach (var key in expandedKeys)
		{
			var n = _navTree.RootNode.Find(key);
			if (n is not null && !n.IsExpanded && !(n.Data?.IsLeaf ?? true))
			{
				await _navTree.ToggleNodeIsExpandedAsync(n).ConfigureAwait(true);
			}
		}
	}

	// === Toolbar ===

	private async Task OnToolbarClick(KeyedEventArgs<MouseEventArgs> args)
	{
		switch (args.Key)
		{
			case "refresh":
				// Scope follows the breadcrumb: the selected organisation, or all of them.
				if (_orgSelected)
				{
					await RediscoverOrganizationAsync(CurrentOrganization);
				}
				else
				{
					await RefreshAsync();
				}

				break;
			case "fix":
				await FixAllAsync();
				break;
			case "fix-with-ai":
				await FixWithAiAsync();
				break;
			case "open-ide":
				OpenInIde();
				break;
			case "copy-ai-prompt":
				await CopyPromptToClipboardAsync();
				break;
			case "reassess":
						// Same scoping as the label: package, then organisation, then everything.
						if (_selectedRow is not null)
						{
							await ReassessAllAsync();
						}
						else if (_orgSelected)
						{
							await ReassessOrganizationAsync(CurrentOrganization);
						}
						else
						{
							await ReassessAllReposAsync();
						}

						break;
				case "build":
				await BuildAsync();
				break;
			case "test":
				await RunTestsAsync();
				break;
			case "git-sync":
					await GitSyncAsync();
					break;
			case "commit-and-push":
				await CommitAndPushAsync();
				break;
			case "publish":
				await RunPublishAsync();
				break;
		}
	}

	// === Home overview ===

	/// <summary>
	/// One organisation's headline counts for the overview table.
	/// </summary>
	private sealed record OrgOverview(
		string Organization,
		int Repos,
		int Cloned,
		int ClonedClean,
		int Assessed,
		int Clean,
		int Warnings,
		int Errors,
		int NoRepo,
		int Unassessed);

	private List<OrgOverview> BuildOrgOverviews()
	{
		var organizations = RuntimeSettings.Organizations;
		var fallback = organizations.Count > 0 ? organizations[0] : _organizationName;

		var result = new List<OrgOverview>();
		foreach (var organization in organizations)
		{
			// Same attribution as the navigation tree: rows cached before multi-organisation support
			// carry no organisation and belong to the first one.
			var rows = _rows
				.Where(r => string.IsNullOrEmpty(r.Organization)
					? string.Equals(organization, fallback, StringComparison.OrdinalIgnoreCase)
					: string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))
				.ToList();

			result.Add(new OrgOverview(
				Organization: organization,
				Repos: rows.Count,
				Cloned: rows.Count(r => r.IsClonedLocally),
				ClonedClean: rows.Count(r => r.IsClonedLocally && r.HealthStatus == PackageHealthStatus.Success),
				Assessed: rows.Count(r => r.Assessment is not null),
				Clean: rows.Count(r => r.HealthStatus == PackageHealthStatus.Success),
				Warnings: rows.Count(r => r.HealthStatus == PackageHealthStatus.Warning),
				Errors: rows.Count(r => r.HealthStatus == PackageHealthStatus.Error),

				// Two distinct reasons for having no assessment, previously conflated under one
				// "not assessed" heading which implied we had simply skipped them:
				//   - no repository at all in the package's NuGet metadata, so there is nothing to
				//     identify and assessment is never attempted;
				//   - a repository is known but the assessment has not run, or errored.
				NoRepo: rows.Count(r => r.RepositoryFullName is null),
				Unassessed: rows.Count(r => r.RepositoryFullName is not null && r.Assessment is null)));
		}

		return result;
	}

	// The issue-centric view is rebuilt from every rule result, so it is memoised against the data it
	// was built from rather than recomputed on each render — the home view re-renders on every progress
	// tick during a run.
	private List<IssueClassGroup>? _topIssueClasses;
	private (int Rows, DateTimeOffset Refreshed) _topIssueClassesBuiltFrom;

	private List<IssueClassGroup> TopIssueClasses(int take)
	{
		var stamp = (_rows.Count, Cache.LastRefreshUtc);
		if (_topIssueClasses is not null && _topIssueClassesBuiltFrom == stamp)
		{
			return _topIssueClasses;
		}

		_topIssueClasses =
		[
			.. Dashboard.BuildIssueCentricView([.. _rows.Where(r => r.IsGoverned)]).AllIssueClasses
				.OrderByDescending(i => i.AffectedRepositoryCount)
				.ThenBy(i => i.RuleId, StringComparer.OrdinalIgnoreCase)
				.Take(take)
		];

		_topIssueClassesBuiltFrom = stamp;
		return _topIssueClasses;
	}

	/// <summary>
	/// Opens one of the overview's biggest issue classes in the sidebar's issue hierarchy.
	/// </summary>
	private async Task NavigateToTopIssueAsync(IssueClassGroup issueClass)
	{
		// An issue class can span organisations, so take the organisation of the first affected
		// repository rather than assuming the currently selected one.
		var firstRepository = issueClass.Instances.FirstOrDefault()?.RepositoryFullName;
		var organization = _rows
			.FirstOrDefault(r => string.Equals(r.RepositoryFullName, firstRepository, StringComparison.OrdinalIgnoreCase))
			?.Organization;

		if (string.IsNullOrEmpty(organization))
		{
			organization = CurrentOrganization;
		}

		_selectedOrganization = organization;
		_selectedCategory = issueClass.Category;
		_selectedRuleId = issueClass.RuleId;
		_orgSelected = false;

		await SelectNavNodeAsync(
			$"irule:{organization}:{issueClass.Category}:{issueClass.RuleId}",
			NavView.IssueRuleDetail);
	}

	// === Render Fragments ===

	/// <summary>
	/// The estate overview, shown when Organisations is selected — the one node whose scope is every
	/// organisation. Leads with locally-cloned repositories because that is the definition of done: only
	/// a local clone can be auto-fixed, built, tested or published, so the all-repositories figure is
	/// shown alongside as context rather than as the target.
	/// </summary>
	private RenderFragment RenderDashboardView() => __builder =>
	{
		var overviews = BuildOrgOverviews();
		var totalRepos = overviews.Sum(o => o.Repos);
		var cloned = overviews.Sum(o => o.Cloned);
		var clonedClean = overviews.Sum(o => o.ClonedClean);
		var clean = overviews.Sum(o => o.Clean);
		var assessed = overviews.Sum(o => o.Assessed);
		var clonedPercent = cloned == 0 ? 0 : (int)Math.Round(clonedClean * 100.0 / cloned);
		var topIssues = TopIssueClasses(6);

		<div class="home-view">
			<h2 class="home-title">Organisations</h2>

			@if (totalRepos == 0)
			{
				<p class="home-empty">
					No packages discovered yet. Use <em>Rediscover Orgs</em>, or add an organisation with the
					<i class="fas fa-plus"></i> beside <em>Organisations</em>.
				</p>
			}
			else
			{
				<section class="home-section">
					<h3 class="home-section-title">Progress</h3>
					<div class="home-progress-heading">
						<strong>@clonedClean of @cloned</strong> locally-cloned repositories are clean
						<span class="home-progress-percent">@clonedPercent%</span>
					</div>
					<div class="home-progress-track">
						<div class="home-progress-fill" style="width: @clonedPercent%"></div>
					</div>
					<p class="home-progress-note">
						Only cloned repositories can be fixed, built, tested or published, so this is the number
						that matters. Across everything: <strong>@clean of @totalRepos</strong> clean,
						@assessed assessed.
					</p>
				</section>

				<section class="home-section">
					<h3 class="home-section-title">By organisation</h3>
					<table class="home-table">
						<thead>
							<tr>
								<th>Organisation</th>
								<th class="home-num">Repos</th>
								<th class="home-num">Cloned</th>
								<th class="home-num">Clean</th>
								<th class="home-num">Warnings</th>
								<th class="home-num">Errors</th>
								<th class="home-num" title="The package's NuGet metadata has no GitHub project URL, so there is no repository to identify or assess.">No repo</th>
								<th class="home-num" title="A repository is known, but it has not been assessed yet — or the assessment errored.">Not assessed</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var o in overviews)
							{
								<tr>
									<td>
										<a href="#" class="home-link" @onclick="() => NavigateToOrgAsync(o.Organization)" @onclick:preventDefault>@o.Organization</a>
									</td>
									<td class="home-num">@o.Repos</td>
									<td class="home-num">@o.Cloned</td>
									<td class="home-num @(o.Clean > 0 ? "text-success" : null)">@o.Clean</td>
									<td class="home-num @(o.Warnings > 0 ? "text-warning" : null)">@o.Warnings</td>
									<td class="home-num @(o.Errors > 0 ? "text-danger" : null)">@o.Errors</td>
									<td class="home-num">@o.NoRepo</td>
									<td class="home-num @(o.Unassessed > 0 ? "text-warning" : null)">@o.Unassessed</td>
								</tr>
							}
						</tbody>
					</table>
				</section>

				@if (topIssues.Count > 0)
				{
					<section class="home-section">
						<h3 class="home-section-title">Biggest issue classes</h3>
						<p class="home-section-note">
							The rules affecting the most repositories — fixing one of these moves the most at once.
						</p>
						<ul class="home-issue-list">
							@foreach (var issueClass in topIssues)
							{
								<li>
									<a href="#" class="home-link" @onclick="() => NavigateToTopIssueAsync(issueClass)" @onclick:preventDefault>
										<span class="home-issue-id">@issueClass.RuleId</span>
										<span class="home-issue-name">@issueClass.RuleName</span>
									</a>
									<span class="home-issue-count">@issueClass.AffectedRepositoryCount repos</span>
								</li>
							}
						</ul>
					</section>
				}

				@* The tree lists these same repositories but cannot sort or search them, which is what this
				   adds. Full width, since a table needs more room than the prose above it. *@
				<section class="home-section home-section-wide">
					<h3 class="home-section-title">All repositories</h3>
					@RenderRepositoryTable()
				</section>
			}
		</div>
	};

	/// <summary>
	/// Home: what you can do here. Deliberately guidance rather than figures — the aggregate view is
	/// the Organisations node's, reached by selecting it.
	/// </summary>
	private RenderFragment RenderGettingStarted() => __builder =>
	{
		<div class="spa-placeholder">
			<i class="fas fa-hand-point-left fa-2x"></i>
			<p>Select an item from the navigation tree</p>

			@* Without this the overview is effectively hidden: selecting a container node is not an
			   obvious thing to try, and nothing else hints that Organisations has a view of its own. *@
			<p class="getting-started-lead">
				Start with
				<a href="#" class="home-link" @onclick="NavigateToOrganisationsAsync" @onclick:preventDefault>Organisations</a>
				— it shows how the whole estate is doing: progress toward every locally-cloned repository
				being clean, a breakdown per organisation, and the rules affecting the most repositories.
			</p>

			<ol class="getting-started">
				<li>
					<strong>Add an organisation</strong> with the <i class="fas fa-plus"></i> beside
					<em>Organisations</em>, as needed. Its packages are discovered from NuGet and each
					repository assessed.
				</li>
				<li>
					@* Bold lead-in phrase, then the UI term in accent — matching the other steps. It was
					   nested inside the strong, making it the only bold-and-blue term of the four. *@
					<strong>Pick a repository</strong> from <em>Repositories</em> under an organisation.
					Its icon shows how it fares: green is clean, amber has warnings, red has errors.
				</li>
				<li>
					<strong>Clone the ones you want to work on</strong> with the
					<i class="fas fa-cloud-arrow-down"></i> on an organisation. Clones go to
					<code>@LocalRepo.GetReposRoot()</code> — the app's own folder, kept apart from
					wherever you keep your own checkouts, so nothing it does can disturb them.
					<em>Seen Locally</em> picks out the ones you already work on.
				</li>
				<li>
					<strong>Work along the toolbar</strong> left to right — Sync, Re-assess, Fix, Build,
					Test, Commit &amp; Push, Publish.
				</li>
				<li>
					<strong>Or fix one problem everywhere at once.</strong> <em>Issues</em> groups the
					same failures by rule instead of by repository, so a single action can apply a fix
					across every repository it affects.
				</li>
			</ol>

			<p class="getting-started-note">
				Auto-fix, build, test and publish need a clone, so a repository that has none can only be
				assessed. Clones are always fetched fresh from GitHub, including for repositories you
				already have elsewhere — a copy would start out however far behind that one had drifted.
			</p>
		</div>
	};

	private RenderFragment RenderCurrentView() => __builder =>
	{
		switch (_currentView)
		{
			case NavView.Home:
			case NavView.None:
				@RenderGettingStarted()
				break;
			case NavView.Dashboard:
				@* Selecting Organisations shows the estate overview, since that node's scope is all of
				   them. Home keeps the guidance it always had. *@
				@RenderDashboardView()
				break;
			case NavView.RepositoryDetail:
			case NavView.PackageDetail:
				@* Both show the same thing — the rules a repository is failing. The rules evaluate a
				   repository, not a package, so a repository node and the package node beneath it have
				   the same findings to show. Without the RepositoryDetail case the switch fell to its
				   default and showed the getting-started placeholder, so selecting a repository looked
				   like selecting nothing at all. *@
				@RenderPackageDetailView()
				break;
			case NavView.CategoryDetail:
				@RenderCategoryDetailView()
				break;
			case NavView.RuleDetail:
				@RenderRuleDetailView()
				break;
			case NavView.Settings:
				@RenderSettingsView()
				break;
			case NavView.AppSettings:
				@RenderAppSettingsView()
				break;
			case NavView.Issues:
				@* Embedded so it drops its own page header. Organization is required: without it the
				   component shows nothing rather than every organisation's repositories. *@
				<IssuesView Embedded="true" Organization="@CurrentOrganization" OnOutput="AppendIssuesOutput" OnEnqueue="EnqueueRequestedWork" />
				break;
			case NavView.IssueCategoryDetail:
				@* The hierarchy itself now lives in the sidebar; this panel shows the selected
				   category's rules with their affected repositories and bulk actions. *@
				<IssuesView Embedded="true" Organization="@CurrentOrganization" FocusCategory="_selectedCategory" OnOutput="AppendIssuesOutput" OnEnqueue="EnqueueRequestedWork" />
				break;
			case NavView.IssueRuleDetail:
				<IssuesView Embedded="true" Organization="@CurrentOrganization" FocusCategory="_selectedCategory" FocusRuleId="@_selectedRuleId" OnOutput="AppendIssuesOutput" OnEnqueue="EnqueueRequestedWork" />
				break;
			case NavView.RepositoryIssueDetail:
				@* Its own component rather than another render method here: this file is already
				   enormous, and IssuesView sets the precedent for a self-contained panel. *@
				<RepositoryIssueView Issue="@SelectedRepositoryIssue" RepositoryFullName="@_selectedRow?.RepositoryFullName" />
				break;
			default:
				@RenderGettingStarted()
				break;
		}
	};

	private RenderFragment RenderConsolePanel() => __builder =>
	{
		<div class="console-panel-header">
			<span><i class="fas fa-terminal"></i> Console</span>
			<div class="console-panel-actions">
				@if (CurrentConsoleLines.Length > 0)
				{
					<button class="btn btn-sm btn-copy @(CurrentConsoleCopyFeedback ? "btn-copied" : "")" @onclick="CopyConsoleToClipboardAsync" title="Copy console output to clipboard">
						@if (CurrentConsoleCopyFeedback)
						{
							<i class="fas fa-check"></i> <span>Copied!</span>
						}
						else
						{
							<i class="fas fa-copy"></i> <span>Copy</span>
						}
					</button>
				}
				@if (!string.IsNullOrEmpty(CurrentLastPromptText))
				{
					<button class="btn btn-sm btn-copy @(CurrentCopyFeedback ? "btn-copied" : "")" @onclick="CopyPromptToClipboardAsync" title="Copy AI prompt to clipboard">
							@if (CurrentCopyFeedback)
							{
								<i class="fas fa-check"></i> <span>Copied!</span>
							}
							else
							{
								<i class="fas fa-copy"></i> <span>Copy Prompt</span>
							}
						</button>
				}
				@if (CurrentConsoleLines.Length > 0)
				{
					<button class="btn btn-sm btn-icon" @onclick="ClearConsole" title="Clear console"><i class="fas fa-trash"></i></button>
				}
			</div>
		</div>
		<div class="detail-console-output" @ref="_consoleElement">
			@if (CurrentConsoleLines.Length == 0)
			{
				<span class="console-placeholder">Actions and output will appear here...</span>
