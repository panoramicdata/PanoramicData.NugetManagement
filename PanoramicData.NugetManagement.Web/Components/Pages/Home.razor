	private async Task FixAllCoreAsync(RepositoryDashboardRow row, IProgress<string> progress, CancellationToken cancellationToken)
	{
		_isRunning = true;
		ClearConsole();
		AppendConsole("▶ Applying all auto-remediations...");
		StateHasChanged();

		try
		{
			var applied = await Dashboard.ApplyRemediationsAsync(row, line =>
			{
				AppendConsole(line);
				InvokeAsync(StateHasChanged);
			});

			await Dashboard.RefreshGitStatusAsync(row);
			await PersistSelectedRowUpdateAsync();
			AppendConsole($"✅ Applied {applied.Count} remediation(s)");

			// Re-assess
			_isAssessing = true;
			_progressMessage = "Re-assessing...";
			StateHasChanged();
			await Dashboard.AssessLocalRepositoryAsync(row);
           await PersistSelectedRowUpdateAsync();

			// Report remaining issues that have no auto-fix
			var remaining = row.Assessment?.RuleResults
				.Where(r => !r.Passed && !Dashboard.IsAutoRemediable(r))
				.ToList() ?? [];
			if (remaining.Count > 0)
			{
				foreach (var r in remaining)
				{
					AppendConsole($"⚠️ [{r.RuleId}] {r.RuleName} — no auto-fix available");
				}

				AppendConsole($"ℹ️ {remaining.Count} issue(s) require manual fix. Preparing AI prompt for clipboard...");
				var prompt = DashboardService.GenerateRemediationPromptForFailures(row, remaining, includeInfo: false);
				OpenInIde();
				await AutoCopyAiPromptAsync(prompt, WorkflowStep.Fix, "remaining remediation options");
			}
			else if (row.TotalFailures == 0)
			{
				AppendConsole("🎉 No remaining issues — all rules pass.");
			}
		}
		catch (OperationCanceledException)
		{
			// Atomic per repository: a fix that was stopped part-way is undone, so the clone is left as
			// it was found rather than carrying half a remediation into the next commit.
			await RevertPartAppliedFixAsync(row);
			throw;
		}
		catch (Exception ex)
		{
			AppendConsole($"❌ Error: {ex.Message}");
		}
		finally
		{
			_isRunning = false;
			_isAssessing = false;
			_progressMessage = string.Empty;
			StateHasChanged();
		}
	}

