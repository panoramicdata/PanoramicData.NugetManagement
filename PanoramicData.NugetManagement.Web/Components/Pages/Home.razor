	// === Work lanes ===

	/// <summary>
	/// Whether this repository has work outstanding, so a click now queues rather than starts. Its own
	/// work only: work on another repository never closes this one's buttons.
	/// </summary>
	private bool IsRepositoryBusy(string? repositoryFullName)
		=> repositoryFullName is { Length: > 0 } name
			&& Lanes.ItemsFor($"repo:{name.ToLowerInvariant()}").Count > 0;

	/// <summary>
	/// Throws away whatever a stopped fix had written into a clone, and says how much went. Not
	/// cancellable: this is the cleanup, and abandoning it half-way is the state it exists to prevent.
	/// </summary>
	private async Task RevertPartAppliedFixAsync(RepositoryDashboardRow row)
	{
		if (row.RepositoryFullName is null)
		{
			return;
		}

		var (success, discarded) = await LocalRepo.DiscardLocalChangesAsync(row.RepositoryFullName, CancellationToken.None);
		AppendConsole(success
			? discarded.Count == 0
				? "↩️ Stopped before anything was written."
				: $"↩️ Reverted {discarded.Count} change(s) written before the stop."
			: "⚠️ Could not revert the part-applied changes — check the clone by hand.");

		await Dashboard.RefreshGitStatusAsync(row, CancellationToken.None);
	}

	/// <summary>
	/// Queues one piece of work against the selected repository's lane.
	/// </summary>
	/// <param name="kind">Which work this is.</param>
	/// <param name="title">What the user sees in the tree and console.</param>
	/// <param name="step">The workflow step this queues, or null when it is not one.</param>
	/// <param name="parameters">The few extras the kind needs, such as <c>category</c> or <c>ruleId</c>.</param>
	private void QueueForSelectedRepository(WorkKind kind, string title, WorkflowStep? step = null, params (string Name, string Value)[] parameters)
	{
		if (_selectedRow?.RepositoryFullName is not { Length: > 0 } repositoryFullName)
		{
			return;
		}

		var queued = Lanes.Enqueue(
			title,
			WorkDescriptor.ForRepository(kind, _selectedRow.Organization, repositoryFullName, parameters),
			$"{kind}:{repositoryFullName}:{string.Join(',', parameters.Select(p => p.Value))}",
			step,
			// Recorded now rather than read when the item runs: the lane may not reach it for minutes,
			// by which time the selection has moved and the output would land in an unrelated console.
			_selectedNodeKey);

		AppendConsole(DescribeQueued(queued, title));
	}

	/// <summary>
	/// What to say in the console for a just-enqueued item: folded into an existing one, alone in its
	/// lane and so about to start, or genuinely waiting behind something else in the same lane.
	/// </summary>
	/// <remarks>
	/// With one lane per repository, starting immediately is now the common case — a repository with
	/// nothing else outstanding runs the moment it is queued, unlike the single application-wide queue
	/// this replaced, where "queued" was true of nearly everything. Saying "Queued" regardless would
	/// describe every click as a wait even when there was none.
	/// </remarks>
	/// <param name="item">The item <see cref="WorkLaneService.Enqueue"/> returned, or null if it folded.</param>
	/// <param name="title">The title it was queued under.</param>
	private string DescribeQueued(WorkItem? item, string title)
	{
		if (item is null)
		{
			return $"↩️ {title} is already queued.";
		}

		return Lanes.ItemsFor(item.LaneKey).Count == 1
			? $"▶️ {title}"
			: $"⏳ Queued: {title}";
	}

	/// <summary>
	/// Stops a work node's lane — or, on an organisation's work node, every lane beneath it.
	/// </summary>
	private void StopLane(NavItem node)
	{
		if (node.RepositoryFullName is { Length: > 0 })
		{
			Lanes.CancelLane(node.LaneKey!);
			return;
		}

		Lanes.CancelUnder(node.Organization);
	}

	/// <summary>
	/// Queues one rule of a bulk action fanned out across its repositories, or — when
	/// <see cref="BulkRuleRequest.RuleId"/> is null — the trailing commit-and-push a multi-rule sweep
	/// sends once every rule has been fanned out. That case is queued here rather than through
	/// <see cref="WorkFanOut"/>, since it fixes nothing and <see cref="WorkFanOut.EnqueueRule"/> pairs
	/// its push with a specific rule's fix.
	/// </summary>
	private void EnqueueBulkRule(BulkRuleRequest request)
	{
		if (request.RuleId is null)
		{
			var pushed = 0;
			foreach (var repositoryFullName in request.RepositoryFullNames)
			{
				// Never folded: this is the one push a whole sweep's fixes land behind, so a repeat
				// request finding one already pending must still queue its own — a fold here would
				// silently drop the push for whichever rule enqueued second.
				var item = Lanes.Enqueue(
					$"Commit & push {repositoryFullName}",
					WorkDescriptor.ForRepository(WorkKind.CommitAndPush, request.Organization, repositoryFullName),
					$"commit-push:{repositoryFullName}",
					WorkflowStep.CommitAndPush,
					_selectedNodeKey,
					foldDuplicates: false);

				if (item is not null)
				{
					pushed++;
				}
			}

			AppendConsole($"⏳ Queued {request.Title} across {pushed} repositor{(pushed == 1 ? "y" : "ies")}.");
			return;
		}

		// A synthesised Dependabot finding has no remediation to apply — its fix is a triage pass. The
		// dependency the node is about does not narrow the work: triage judges a repository's whole
		// inbox at once, so one item per repository is both correct and the smallest thing that can run.
		if (DependabotIssueSynthesizer.IsSynthetic(request.RuleId))
		{
			var triaged = FanOut.EnqueueTriageDependabot(
				request.Organization,
				[.. request.RepositoryFullNames
					.Select(name => _rows.FirstOrDefault(r =>
						string.Equals(r.RepositoryFullName, name, StringComparison.OrdinalIgnoreCase)))
					.Where(row => row is not null)
					.Select(row => row!)],
				_selectedNodeKey);

			AppendConsole($"⏳ Queued Dependabot triage across {triaged} repositor{(triaged == 1 ? "y" : "ies")}.");
			return;
		}

		var queued = FanOut.EnqueueRule(
			request.Organization, request.RuleId, request.RepositoryFullNames, request.Push, _selectedNodeKey);

		AppendConsole($"⏳ Queued {request.Title} across {queued} repositor{(queued == 1 ? "y" : "ies")}.");
	}

	/// <summary>
	/// Debounces <see cref="WorkLaneService.Changed"/>. Twenty lanes reporting progress would otherwise
	/// rebuild the tree far faster than anyone can read it, so a burst of changes collapses into one
	/// reload 250 ms after the last of them.
	/// </summary>
	private readonly System.Timers.Timer _laneChangeDebounce = new(250) { AutoReset = false };

	/// <summary>
	/// Whether this circuit has been disposed. Read by handlers that the lane service may still call
	/// after <see cref="Dispose"/> has run, because an event raise captures its subscribers first.
	/// </summary>
	private volatile bool _disposed;

	/// <summary>
	/// <see cref="Environment.TickCount64"/> when the current burst of lane changes started, or zero
	/// when no burst is in flight. Backs the maximum delay described on <see cref="OnLanesChanged"/>.
	/// </summary>
	/// <remarks>
	/// A plain <c>long</c> read and written with <c>Interlocked</c> rather than a nullable timestamp:
	/// it is written by up to twenty runner threads raising <c>Changed</c> and cleared by the timer's
	/// own thread, and a torn read of a multi-word value would produce a burst age from nowhere.
	/// </remarks>
	private long _laneChangeBurstStartedTicks;

	/// <summary>
	/// The longest the tree may go without rebuilding while lane changes keep arriving.
	/// </summary>
	/// <remarks>
	/// A pure trailing debounce is not enough on its own. <c>dotnet build</c> streams output
	/// continuously, and every line raises <c>Changed</c> through <c>ReportProgress</c>, so with even
	/// one build running the 250 ms window never closes — for the whole 30-120 seconds of the build
	/// the tree would never rebuild, newly queued items would not appear, finished ones would not
	/// disappear, and the lane flags would stay stale. With twenty lanes there is essentially always
	/// such a burst. So the burst is capped: it collapses changes as before, but never withholds a
	/// rebuild for longer than this.
	/// </remarks>
	private const long LaneChangeMaxDelayMilliseconds = 2000;

	/// <summary>
	/// Restarts the debounce timer whenever a lane changes, unless the current burst has already been
	/// running for <see cref="LaneChangeMaxDelayMilliseconds"/>, in which case the pending rebuild is
	/// left to fire. Called from any thread — including, thanks to the invocation list being captured
	/// before it is walked, after this component has been disposed.
	/// </summary>
	private void OnLanesChanged()
	{
		// A raise already in flight when Dispose() ran still reaches this handler: the event captures
		// its subscribers before calling them, so unsubscribing does not recall a call already made.
		// Touching the timer after Dispose() disposed it throws ObjectDisposedException, which — raised
		// from the runner's claim loop — would fault the hosted service and stop the web application.
		if (_disposed)
		{
			return;
		}

		try
		{
			var now = Environment.TickCount64;
			var startedTicks = Interlocked.CompareExchange(ref _laneChangeBurstStartedTicks, now, 0);
			if (startedTicks != 0 && now - startedTicks >= LaneChangeMaxDelayMilliseconds)
			{
				// Left alone deliberately: the timer is already counting down towards a rebuild this
				// burst has waited long enough for, and restarting it would push that rebuild out again.
				return;
			}

			_laneChangeDebounce.Stop();
			_laneChangeDebounce.Start();
		}
		catch (ObjectDisposedException)
		{
			// Disposal raced the raise. Nothing left to render into, and nothing to report.
		}
	}

	/// <summary>
	/// Reloads the tree once the debounce timer elapses. Runs on the timer's own thread, so the reload
	/// and re-render are hopped back onto the circuit via <c>InvokeAsync</c>.
	/// </summary>
	private void OnLaneChangeDebounceElapsed(object? sender, System.Timers.ElapsedEventArgs e)
	{
		// The burst ends here, so the next change starts a fresh maximum-delay window. Cleared before
		// the reload rather than after it: changes arriving while the reload runs belong to the next
		// burst, not to the one this rebuild is already satisfying.
		Interlocked.Exchange(ref _laneChangeBurstStartedTicks, 0);

		_ = InvokeAsync(async () =>
		{
			RefreshLaneFlagsSnapshot();

			// Progress re-renders; it does not rebuild. The node template reads live state for the things
			// that change while work runs — a repository's spinner, its health glyph, the lane's busy
			// flags — and re-rendering swaps those attributes without moving a single element. Rebuilding
			// instead replaced the DOM under every loaded branch, every 250 ms, for as long as anything
			// was running: the flicker, and the scrollbar jumping out from under whoever was reading.
			//
			// What the template cannot change is which nodes exist. Queueing an item and finishing one do
			// change that — the work nodes list the queue, and a finished run leaves different
			// assessments, counts and findings behind — so the rebuild follows the composition of the
			// queue rather than the arrival of a progress report.
			if (_treeReloads.ObserveAndShouldReload(OutstandingWorkItemIds()))
			{
				await ReloadTreePreservingExpansionAsync();
			}

			await SafeStateHasChangedAsync();
		});
	}

	/// <summary>
	/// Decides when a lane change justifies rebuilding the tree rather than just re-rendering it.
	/// </summary>
	private readonly TreeReloadPolicy _treeReloads = new();

	/// <summary>
	/// The ids of every outstanding work item, across every lane.
	/// </summary>
	/// <remarks>
	/// One <see cref="WorkLaneService.Lanes"/> snapshot, which takes a lock and deep-copies: worth
	/// saying because reading it per lane instead would contend with up to twenty runner threads
	/// reporting progress.
	/// </remarks>
	private List<string> OutstandingWorkItemIds()
		=> [.. Lanes.Lanes.SelectMany(lane => lane.Items).Select(item => item.Id)];

	/// <summary>
	/// Refreshes <see cref="_isLoading"/>, <see cref="_isDiscovering"/>, <see cref="_busyOrganization"/>,
	/// <see cref="_isCloningAll"/> and <see cref="_cloningOrganization"/> from a single read of
	/// <see cref="WorkLaneService.Lanes"/>.
	/// </summary>
	/// <remarks>
	/// <see cref="WorkLaneService.Lanes"/> takes a lock and deep-copies every lane and its items on each
	/// access. These five flags used to be properties re-deriving that snapshot independently, which
	/// meant a 500-node tree render — each node reading one or more of them — took 500-odd full lane
	/// snapshots under a lock that up to twenty runner threads are contending on for every progress
	/// report. Called once whenever the lanes actually change, rather than once per node or even once
	/// per render, so the flags are always at most one debounce cycle stale — the same staleness the
	/// tree itself already tolerates.
	/// </remarks>
	private void RefreshLaneFlagsSnapshot()
	{
		var lanes = Lanes.Lanes;

		_isLoading = lanes.Any(lane => lane.IsRunning
			&& lane.Items.Exists(i => i.Descriptor.Kind is
				WorkKind.RediscoverOrganization or WorkKind.DiscoverReassessTargets or WorkKind.RefreshAll));

		_isDiscovering = lanes.Any(lane => lane.IsRunning
			&& lane.Items.Exists(i => i.Descriptor.Kind is WorkKind.RediscoverOrganization or WorkKind.RefreshAll));

		_busyOrganization = lanes
			.Where(lane => lane.IsRunning && lane.Items.Exists(i => i.Descriptor.Kind is
				WorkKind.RediscoverOrganization or WorkKind.DiscoverReassessTargets or WorkKind.RefreshAll))
			.Select(lane => lane.Organization)
			.FirstOrDefault();

		_cloningOrganization = lanes
			.Where(lane => lane.IsRunning && lane.Items.Exists(i => i.Descriptor.Kind is WorkKind.DiscoverCloneTargets or WorkKind.Clone))
			.Select(lane => lane.Organization ?? string.Empty)
			.FirstOrDefault() ?? string.Empty;

		_isCloningAll = _cloningOrganization.Length > 0;

		// Write-only-false since the discovery bodies moved to WorkExecutors: the base set this true in
		// RefreshCoreAsync, and nothing replaced it, so the tree's "Loading repositories..." placeholder
		// and the organisation node's own busy flag were permanently off. Set from the same snapshot as
		// the flags above rather than from a run that now happens somewhere else entirely.
		NavDataProvider.IsLoading = _isLoading;
	}

	/// <summary>
	/// Refreshes the selected repository's row and the tree when any lane item completes, and — for a
	/// step completing on the selected repository — restores the workflow-step badge state that used to
	/// be written inline by the toolbar's own build/test/commit bodies before those moved into
	/// <see cref="WorkExecutors"/>.
	/// </summary>
	/// <remarks>
	/// Keyed off <see cref="WorkItem.Succeeded"/>, not <see cref="WorkItem.State"/>: a failed build or a
	/// refused push completes normally rather than throwing, so <c>State</c> alone reads a failed build
	/// as a success. <c>Succeeded</c> is the executor stating the outcome explicitly.
	/// <para>
	/// Raised from the runner's own thread — never the circuit's — so the whole body, including the
	/// <c>_rows</c> reassignment and every mutation of the step-tracking sets below, is hopped onto the
	/// circuit via <c>InvokeAsync</c> before it touches anything. Mutating a plain
	/// <c>HashSet&lt;WorkflowStep&gt;</c> off-thread, with the renderer possibly enumerating it at the
	/// same moment, is exactly the kind of thing that only breaks once twenty lanes are finishing
	/// concurrently.
	/// </para>
	/// </remarks>
	private void OnItemCompleted(WorkItem item)
		=> _ = InvokeAsync(async () =>
		{
			_rows = Cache.GetCachedRows() ?? _rows;
			RefreshLaneFlagsSnapshot();

			// The work bodies no longer write to the clipboard or open an IDE — they cannot, running
			// without a browser attached — so the prompt they generate arrives here instead, on the
			// item. Routed into the UI state of the node the work's console belongs to, which is
			// exactly where the toolbar's copy button reads it from: without this the prompt would be
			// generated, stored and never seen, and the user would have lost the auto-copy for nothing.
			if (item.GeneratedPrompt is { Length: > 0 } generatedPrompt)
			{
				GetOrCreateNodeUiState(item.ConsoleNodeKey ?? _selectedNodeKey).LastPromptText = generatedPrompt;
			}

			if (item.State is not (WorkItemState.Cancelled or WorkItemState.Cancelling)
				&& item.Step is { } step
				&& item.Succeeded is { } succeeded
				&& _selectedRow?.RepositoryFullName is { Length: > 0 } selected
				&& string.Equals(item.RepositoryFullName, selected, StringComparison.OrdinalIgnoreCase))
			{
				if (succeeded)
				{
					_completedSteps.Add(step);
					_failedSteps.Remove(step);
					if (_lastFailedWorkflowStep == step)
					{
						_lastFailedWorkflowStep = null;
					}
				}
				else
				{
					_failedSteps.Add(step);
					_completedSteps.Remove(step);
					_lastFailedWorkflowStep = step;
				}
			}

			// A stopped step neither succeeded nor failed, and its changes were reverted, so the badge
			// state is left exactly as it was — guarded on State as well as on Succeeded being null,
			// so a badge can never be moved by a cancelled item even if some future executor forgot to
			// leave Succeeded unset on that path. Executors rethrow OperationCanceledException ahead of
			// any catch that states an outcome, precisely so Succeeded stays null here; this guard is
			// the belt to that braces.
			await ReloadTreePreservingExpansionAsync();
		});

	/// <summary>
	/// The number of repositories an issue-hierarchy node covers, or null for nodes where a count
	/// would mean nothing — an organisation, a package, the container nodes.
	/// </summary>
	private static int? AffectedRepoCountFor(NavItem? item)
		=> item?.AffectedRepoCount > 0
			&& item.View is NavView.IssueCategoryDetail or NavView.IssueRuleDetail
				? item.AffectedRepoCount
				: null;

	/// <summary>
	/// Excludes a repository from governance, or brings it back. Persisted immediately, because it is
	/// a decision about the estate rather than a filter for this session — an excluded repository is
	/// not assessed, not listed under any issue class, and not reachable by a bulk action.
	/// </summary>
	private async Task ToggleRepositoryExcludedAsync(string repositoryFullName, bool currentlyExcluded)
	{
		RuntimeSettings.SetRepositoryExcluded(repositoryFullName, !currentlyExcluded);
		AppendConsole(currentlyExcluded
			? $"👁️ {repositoryFullName} is governed again."
			: $"🚫 {repositoryFullName} is excluded from governance.");

		await ReloadTreePreservingExpansionAsync();
	}

	// === Build guard ===

	/// <summary>What the guard last told us about each repository, so only changes are narrated.</summary>
	private readonly Dictionary<string, GuardState> _reportedGuardStates = new(StringComparer.OrdinalIgnoreCase);

	/// <summary>
	/// Narrates guard activity to the console as it happens, and rebuilds the tree when a repository
	/// has been reverted.
	/// </summary>
	/// <remarks>
	/// The guard is an event stream — queued, building, verified — and events belong in the console.
	/// A revert is the exception: it means work the user did has been taken away, which must still be
	/// visible after the console has scrolled, so that one state also marks the repository's node.
	/// </remarks>
	private void OnGuardStatusesChanged() => _ = InvokeAsync(async () =>
	{
		try
		{
			var reverted = false;

			foreach (var status in RegressionGuard.Statuses)
			{
				if (_reportedGuardStates.TryGetValue(status.RepositoryFullName, out var reported)
					&& reported == status.State)
				{
					continue;
				}

				_reportedGuardStates[status.RepositoryFullName] = status.State;
				reverted |= status.State == GuardState.RegressionReverted;

				var line = status.State switch
				{
					GuardState.Verified => $"🛡️ {status.RepositoryFullName}: build verified after our change.",
					GuardState.RegressionReverted => $"↩️ {status.RepositoryFullName}: our change broke the build and has been reverted.",
					GuardState.BuildFailingNotOurs => $"⚠️ {status.RepositoryFullName}: build was already failing before our change.",
					GuardState.Error => $"⚠️ {status.RepositoryFullName}: the guard could not verify the build — {status.Message}",
					_ => null
				};

				if (line is not null)
				{
					AppendConsole(line);
				}
			}

			// Only a revert changes what the tree shows, and rebuilding it is not free.
			if (reverted)
			{
				await ReloadTreePreservingExpansionAsync();
			}
			else
			{
				await SafeStateHasChangedAsync();
			}
		}
		catch (ObjectDisposedException)
		{
			// The circuit has gone; nothing left to render.
		}
	});

	/// <summary>
	/// The icon for a guard state worth showing. Only states needing someone reach here — a verified
	/// repository shows nothing, because a wall of green is what hides the rows that matter.
	/// </summary>
	private static string GuardMarkerIcon(GuardState state) => state switch
	{
		GuardState.RegressionReverted => "fa-rotate-left",
		GuardState.BuildFailingNotOurs => "fa-triangle-exclamation",
		_ => "fa-circle-exclamation"
	};

	private static string GuardMarkerTooltip(GuardState state) => state switch
	{
		GuardState.RegressionReverted => "Our change broke the build and was reverted",
		GuardState.BuildFailingNotOurs => "This repository's build was already failing",
		_ => "The build guard could not verify this repository"
	};

	/// <summary>
	/// Re-renders, tolerating the circuit having gone away. Queued work outlives its component for as
	/// long as it takes to unwind, and must not fail while doing so.
	/// </summary>
	private async Task SafeStateHasChangedAsync()
	{
		try
		{
			await InvokeAsync(StateHasChanged);
		}
		catch (ObjectDisposedException)
		{
			// The circuit has gone; there is nothing left to render.
		}
	}

	/// <summary>
	/// Says something in the console. Logged rather than written straight into the buffer, so the same
	/// words reach stdout as well and there is exactly one path into the console:
	/// <see cref="OnLogLineWritten"/>, which is what actually appends it. The line is passed as an
	/// argument rather than as the template so that braces in a path or a message are not read as
	/// structured-logging placeholders.
	/// </summary>
	private void AppendConsole(string line) => Logger.LogInformation("{ConsoleLine}", line);

	/// <summary>
	/// Empties a console. Most callers are runs clearing the console before they start writing to it,
	/// so it targets the run's own node for the same reason its output does — clearing whatever the
	/// user has since clicked on would wipe an unrelated record. The toolbar's bin button is not in a
	/// run, and so clears what is on screen.
	/// </summary>
	private void ClearConsole()
	{
		var state = GetOrCreateNodeUiState(UiConsoleScope.NodeKey ?? _selectedNodeKey);
		state.ClearConsoleLines();
		state.LastPromptText = null;
		state.CopyFeedback = false;
		state.ConsoleCopyFeedback = false;
	}

	/// <summary>
	/// Appends one log line to the console it belongs to. Called from whichever thread logged it —
	/// which during an assessment is one of ten parallel workers — so the buffer guards itself and the
	/// re-render is only requested here, never performed.
	/// </summary>
	/// <param name="entry">The line, and the console it was scoped to when it was written.</param>
	private void OnLogLineWritten(UiConsoleLogEntry entry)
	{
		// Warnings and errors that were logged rather than narrated arrive without the marker the
		// console colours by, so they get one. Lines that already carry it are left alone.
		var text = entry.Level >= LogLevel.Error && !entry.Message.StartsWith('❌')
			? $"❌ {entry.Message}"
			: entry.Level == LogLevel.Warning && !entry.Message.StartsWith('⚠')
				? $"⚠️ {entry.Message}"
				: entry.Message;

		// An unscoped line was not produced by queued work — a click handler, or a background service —
		// so it belongs to whatever the user is looking at.
		GetOrCreateNodeUiState(entry.NodeKey ?? _selectedNodeKey)
			.AppendConsoleLine(new ConsoleLine(text, GetConsoleLineClass(text)));

		RequestConsoleRender();
	}

	/// <summary>
	/// Asks for a re-render, at most ten times a second. A refresh logs several hundred lines in a
	/// burst, and rendering each one on arrival would spend more of the circuit on the console than on
	/// the work it is reporting.
	/// </summary>
	private void RequestConsoleRender()
	{
		_consoleScrollPending = true;

		if (Interlocked.Exchange(ref _consoleRenderQueued, 1) == 1)
		{
			return;
		}

		_ = Task.Run(async () =>
		{
			await Task.Delay(100);

			// Cleared before rendering, so a line that arrives while this render is in flight queues
			// the next one rather than being held until something else happens to redraw.
			Interlocked.Exchange(ref _consoleRenderQueued, 0);
			await SafeStateHasChangedAsync();
		});
	}

	private async Task CopyConsoleToClipboardAsync()
	{
		if (CurrentConsoleLines.Length == 0)
		{
			return;
		}

		try
		{
			var text = string.Join(Environment.NewLine, CurrentConsoleLines.Select(l => l.Text));
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
			CurrentConsoleCopyFeedback = true;
			StateHasChanged();
			await Task.Delay(2000);
			CurrentConsoleCopyFeedback = false;
			StateHasChanged();
		}
		catch
		{
			AppendConsole("⚠️ Failed to copy to clipboard.");
		}
	}

	private async Task CopyPromptToClipboardAsync()
	{
		if (string.IsNullOrEmpty(CurrentLastPromptText))
		{
			return;
		}

		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentLastPromptText);
			CurrentCopyFeedback = true;
			StateHasChanged();
			await Task.Delay(2000);
			CurrentCopyFeedback = false;
			StateHasChanged();
		}
		catch
		{
			AppendConsole("⚠️ Failed to copy to clipboard.");
		}
	}

	private async Task AutoCopyAiPromptAsync(string prompt, WorkflowStep sourceStep, string reason)
	{
		if (string.IsNullOrWhiteSpace(prompt))
		{
			AppendConsole($"ℹ️ Could not generate an AI prompt for {reason}.");
			return;
		}

		CurrentLastPromptText = prompt;
		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentLastPromptText);
		}
		catch
		{
			AppendConsole("⚠️ Failed to auto-copy AI prompt to clipboard.");
		}
		AppendConsole($"✨ AI prompt for {reason} copied to clipboard. Open IDE and paste into Copilot Chat.");
		_ = TriggerAiClipboardCueAsync(sourceStep);
	}

	private async Task TriggerAiClipboardCueAsync(WorkflowStep sourceStep)
	{
		CurrentAiClipboardCueStep = sourceStep;
		StateHasChanged();

		await Task.Delay(2300);
		if (CurrentAiClipboardCueStep == sourceStep)
		{
			CurrentAiClipboardCueStep = null;
			StateHasChanged();
		}
	}

	// === Utility methods ===

	private static string GetLocalStateSuffix(RepositoryDashboardRow row)
	{
		if (!row.IsClonedLocally)
		{
			return "\n• Not cloned locally";
		}

		var sync = row.IsSyncedWithOrigin switch
		{
			true => "in sync with origin",
			false => "out of sync with origin",
			_ => "sync state unknown"
		};

		var dirty = row.IsWorkingTreeClean == false ? "; uncommitted changes" : string.Empty;
		return $"\n• Local clone, {sync}{dirty}";
	}

	/// <summary>
	/// Explains a branch node's rolled-up colour, so a grey heading above red and green children reads
	/// as "something below has not been assessed" rather than as a rendering glitch.
	/// </summary>
	private static string GetRolledUpHealthSuffix(NavItem item) => item.HealthStatus switch
	{
		PackageHealthStatus.Unknown => "\n• grey = worst below is unknown: something here has not been assessed",
		PackageHealthStatus.Pending => "\n• grey = assessment in progress below",
		PackageHealthStatus.Error => "\n• red = worst below is an error",
		PackageHealthStatus.Warning => "\n• amber = worst below is a warning",
		PackageHealthStatus.Info => "\n• blue = informational findings below",
		PackageHealthStatus.Success => "\n• green = everything below is compliant",
		_ => string.Empty
	};

	private string GetNavItemTooltip(NavItem item)
	{
		switch (item.View)
		{
			case NavView.Home:
				// Only what is governed is counted: the rest are accounted for in their own branch, and
				// counting them here would say the estate holds packages that nothing assesses.
				var governedRows = _rows.Where(r => r.IsGoverned).ToList();
				var assessed = governedRows.Count(r => r.Assessment is not null);
				return $"Dashboard — {governedRows.Count} repositories ({assessed} assessed, {item.IssueCount} issues)"
					+ GetRolledUpHealthSuffix(item);

			case NavView.RepositoryDetail:
			case NavView.PackageDetail:
				var row = RowForNavItem(item);
				if (row is null)
				{
					return item.RepositoryFullName ?? item.Text;
				}

				if (row.Assessment is null)
				{
					return row.Status switch
					{
						PackageStatus.Assessing => $"{row.RepositoryFullName}\n• assessing…{GetLocalStateSuffix(row)}",
						PackageStatus.Error => $"{row.RepositoryFullName}\n• not assessable: {row.StatusMessage}{GetLocalStateSuffix(row)}",
						_ => $"{row.RepositoryFullName}\n• not yet assessed{GetLocalStateSuffix(row)}"
					};
				}

				if (row.TotalFailures == 0)
				{
					return $"{row.RepositoryFullName}\n• all rules pass ✓ (green = compliant){GetLocalStateSuffix(row)}";
				}

				if (row.TotalErrors > 0)
				{
					return $"{row.RepositoryFullName}\n• {row.TotalErrors} error(s), {row.TotalWarnings} warning(s) (red = errors found){GetLocalStateSuffix(row)}";
				}

				return row.TotalWarnings > 0
					? $"{row.RepositoryFullName}\n• {row.TotalWarnings} warning(s) (amber = warnings only){GetLocalStateSuffix(row)}"
					: $"{row.RepositoryFullName}\n• informational only (blue = info){GetLocalStateSuffix(row)}";

			case NavView.CategoryDetail:
				if (item.IssueCount == 0)
				{
					return $"{item.Text} — all rules pass";
				}

				if (item.HasErrors)
				{
					return $"{item.Text} — {item.IssueCount} issue(s) including errors";
				}

				return item.HasWarnings
					? $"{item.Text} — {item.IssueCount} warning(s)"
					: $"{item.Text} — {item.IssueCount} informational";

			case NavView.RuleDetail:
				if (item.HasErrors)
				{
					return $"{item.Text} — error";
				}

				return item.HasWarnings
					? $"{item.Text} — warning"
					: $"{item.Text} — informational";

			case NavView.Repositories:
				// The only container node whose toolbar acts on everything beneath it, which is new
				// enough behaviour to be worth saying rather than leaving to be discovered by pressing
				// Build and watching forty lanes start.
				var buildable = EstateTargets(WorkflowStep.Build).Count;
				return $"Repositories — every toolbar step runs on all {buildable} cloned, governed "
					+ $"{(buildable == 1 ? "repository" : "repositories")} at once, except Publish"
					+ GetRolledUpHealthSuffix(item);

			default:
				return item.Text + GetRolledUpHealthSuffix(item);
		}
	}

