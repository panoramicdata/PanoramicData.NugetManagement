	/// <summary>
	/// Re-reads one organisation's package list from NuGet and assesses it, leaving every other
	/// organisation's rows untouched. This is the org-node counterpart of the dashboard's
	/// "Rediscover Orgs", which does the same for all of them.
	/// </summary>
	private async Task RediscoverOrganizationAsync(string organization)
	{
		if (await BlockIfBulkOperationInFlightAsync("A rediscovery"))
		{
			return;
		}

		var existingForOrg = _rows
			.Where(r => string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))
			.ToList();

		if (!await ConfirmApiBudgetAsync(
			$"Rediscovering and assessing {organization}",
			EstimateRemoteAssessmentCost(existingForOrg)))
		{
			return;
		}

		_isLoading = true;
		_isDiscovering = true;
		_busyOrganization = organization;
		_progressMessage = $"Discovering {organization} packages...";
		StateHasChanged();

		try
		{
			var freshRows = await Dashboard.DiscoverPackagesAsync(organization);

			// Carry over assessments we already have, so rediscovery does not throw away results for
			// packages that have not changed.
			var existingByPackageId = existingForOrg
				.Where(r => r.Assessment is not null)
				.ToDictionary(r => r.PackageId, StringComparer.OrdinalIgnoreCase);

			foreach (var row in freshRows)
			{
				if (existingByPackageId.TryGetValue(row.PackageId, out var existing))
				{
					row.Assessment = existing.Assessment;
					row.CategorySummaries = existing.CategorySummaries;
				}
			}

			// Swap in this organisation's rows only; the others are left exactly as they were.
			_rows =
			[
				.. _rows.Where(r => !string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase)),
				.. freshRows
			];

			Cache.SetRows(_rows);

			var github = CreateGitHubClient();
			var assessable = freshRows.Where(r => r.RepositoryFullName is not null).ToList();

			// Mark them pending before the tree is rebuilt, so the new list appears already showing a
			// spinner per repository.
			foreach (var row in assessable)
			{
				row.IsReassessing = true;
			}

			// Discovery is done: the new list is displayed and the per-repository spinners take over for
			// the assessment phase. This is the one tree rebuild in the middle of the run; the tree then
			// stays still until it finishes.
			//
			// The rebuild happens while still dimmed, and the dim is lifted afterwards — see the note in
			// RefreshAsync: clearing the flag first would rebuild the nodes already undimmed, leaving
			// nothing for the fade to animate from.
			_progressMessage = $"Assessing {organization}...";
			await RefreshTableAsync();

			_isDiscovering = false;
			StateHasChanged();

			AppendConsole($"▶ Rediscovering {organization}: {assessable.Count} repositories...");

			await AssessInParallelAsync(assessable, async row =>
			{
				if (row.IsClonedLocally && row.LocalPath is not null)
				{
					await Dashboard.AssessLocalRepositoryAsync(row);
					await Dashboard.RefreshGitStatusAsync(row);
				}
				else
				{
					await Dashboard.AssessRepositoryAsync(row, github);
				}
			});

			Cache.Update(_rows);
			_lastRefreshUtc = Cache.LastRefreshUtc;
			AppendConsole($"✅ Rediscovered {organization}: {assessable.Count} repositories.");
			_progressMessage += " Done";
			_showDone = true;
			ScheduleDoneClear();
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Failed to rediscover {Organization}", organization);
			AppendConsole($"❌ Rediscover failed: {ex.Message}");
			_progressMessage = $"Error: {ex.Message}";
		}
		finally
		{
			foreach (var row in _rows)
			{
				row.IsReassessing = false;
			}

			_isLoading = false;
			_isDiscovering = false;
			_busyOrganization = null;
			await ReloadTreePreservingExpansionAsync();
			StateHasChanged();
		}
	}

	/// <summary>
	/// Re-assesses every repository, or only one organisation's when <paramref name="organization"/>
	/// is supplied. Scoping matters because assessing every organisation multiplies the GitHub API
	/// cost for no benefit when only one of them is being worked on.
	/// </summary>
	private async Task ReassessOrganizationAsync(string? organization)
	{
		if (await BlockIfBulkOperationInFlightAsync("A re-assessment"))
		{
			return;
		}

		var assessable = _rows
			.Where(r => r.RepositoryFullName is not null)
			.Where(r => organization is null
				|| string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))
			.ToList();

		if (assessable.Count == 0)
		{
			AppendConsole("Nothing to re-assess.");
			return;
		}

		var scope = organization is null ? "repositories" : $"{organization} repositories";
		if (!await ConfirmApiBudgetAsync($"Re-assessing {assessable.Count} {scope}", EstimateRemoteAssessmentCost(assessable)))
		{
			return;
		}

		_isAssessing = true;
		_busyOrganization = organization;
		AppendConsole($"▶ Re-assessing {assessable.Count} {scope}...");

		// Mark all pending rows so the tree shows spinners
		foreach (var r in assessable)
		{
			r.IsReassessing = true;
		}

		await RefreshTableAsync();

		try
		{
			var github = CreateGitHubClient();

			await AssessInParallelAsync(assessable, async row =>
			{
				if (row.IsClonedLocally && row.LocalPath is not null)
				{
					await Dashboard.AssessLocalRepositoryAsync(row);
					await Dashboard.RefreshGitStatusAsync(row);
				}
				else
				{
					await Dashboard.AssessRepositoryAsync(row, github);
				}
			});

			Cache.Update(_rows);
			_lastRefreshUtc = Cache.LastRefreshUtc;
			AppendConsole($"✅ Re-assessed {assessable.Count} repos.");
		}
		catch (Exception ex)
		{
			AppendConsole($"❌ Re-assess all failed: {ex.Message}");
		}
		finally
		{
			// Ensure all rows are cleared in case of early exit
			foreach (var r in assessable)
			{
				r.IsReassessing = false;
			}

			_isAssessing = false;
			_busyOrganization = null;
			_progressMessage = string.Empty;

			// The tree is left untouched during the run so it cannot flicker; rebuild it once here so
			// the new results, icons and issue hierarchy appear.
			await ReloadTreePreservingExpansionAsync();
			StateHasChanged();
		}
	}

