	private RenderFragment RenderNuGetUpdatesView() => __builder =>
	{
		<div class="nuget-updates-view">
			<div class="nuget-updates-header">
				<h2><i class="fas fa-arrow-circle-up"></i> NuGet Package Updates</h2>
				@if (NuGetUpdates.LastCheckedUtc.HasValue)
				{
					<span class="nuget-updates-last-checked">
						Last checked: @NuGetUpdates.LastCheckedUtc.Value.ToLocalTime().ToString("HH:mm dd MMM")
					</span>
				}
			</div>

			@if (NuGetUpdates.IsChecking)
			{
				<div class="nuget-updates-loading">
					<span class="spinner"></span> Scanning repositories for updates...
				</div>
			}
			else if (NuGetUpdates.Groups is null)
			{
				<div class="nuget-updates-empty">
					<i class="fas fa-search fa-2x"></i>
					<p>Click <strong>Check for Updates</strong> in the toolbar to scan all assessed repositories.</p>
				</div>
			}
			else if (NuGetUpdates.Groups.Count == 0)
			{
				<div class="nuget-updates-empty">
					<i class="fas fa-check-circle fa-2x" style="color: var(--success);"></i>
					<p>All packages are up to date.</p>
				</div>
			}
			else
			{
				<div class="summary-strip">
					<div class="summary-card">
						<div class="label">Updates Available</div>
						<div class="value blue">@NuGetUpdates.Groups.Count</div>
					</div>
					<div class="summary-card">
						<div class="label">Repos Affected</div>
						<div class="value amber">@NuGetUpdates.Groups.SelectMany(g => g.AffectedRepoNames).Distinct().Count()</div>
					</div>
				</div>

				<div class="update-groups-list">
					@foreach (var group in NuGetUpdates.Groups.OrderByDescending(g => g.AffectedCount).ThenBy(g => g.PackageId))
					{
						var groupKey = $"{group.PackageId}@{group.CurrentVersion}";
						var isExpanded = _expandedUpdateGroups.Contains(groupKey);
						<div class="update-group-card">
							<div class="update-group-header" @onclick="() => ToggleUpdateGroup(groupKey)">
								<div class="update-group-info">
									<span class="update-package-name">@group.PackageId</span>
									<span class="update-version-arrow">
										<span class="version-from">@group.CurrentVersion</span>
										<i class="fas fa-long-arrow-alt-right"></i>
										<span class="version-to">@group.LatestVersion</span>
									</span>
									<span class="update-repo-count badge">
										@group.AffectedCount @(group.AffectedCount == 1 ? "repo" : "repos")
									</span>
								</div>
								<div class="update-group-actions">
									<button class="btn btn-sm btn-primary"
											disabled="true"
											title="Apply this update to all affected repositories (not yet implemented)"
											@onclick:stopPropagation="true">
										<i class="fas fa-play"></i> Apply All
									</button>
									<i class="fas @(isExpanded ? "fa-chevron-up" : "fa-chevron-down") update-chevron"></i>
								</div>
							</div>
							@if (isExpanded)
							{
								<div class="update-group-repos">
									@foreach (var repoName in group.AffectedRepoNames.OrderBy(r => r))
									{
										<div class="update-repo-row">
											<i class="fas fa-code-branch"></i>
											<span>@repoName</span>
										</div>
									}
								</div>
							}
						</div>
					}
				</div>
			}
		</div>
	};

	private void ToggleUpdateGroup(string key)
	{
		if (!_expandedUpdateGroups.Add(key))
		{
			_expandedUpdateGroups.Remove(key);
		}
	}

	// === Dashboard methods ===

	private void OnIncludeInfoInAiPromptChanged(ChangeEventArgs e)
	{
		_includeInfoInAiPrompt = e.Value is true;
		RuntimeSettings.SetIncludeInfoInAiPrompt(_includeInfoInAiPrompt);
	}

	private void OnAutoRefreshTimer(object? state)
	{
		_ = InvokeAsync(async () =>
		{
			if (!_isLoading && !_isAssessing && !_isRunning)
			{
				await RefreshAsync().ConfigureAwait(false);
			}
		});
	}

	/// <summary>
	/// Clears the lingering "Done" progress message after a short delay so the indicator
	/// doesn't vanish the instant a refresh completes.
	/// </summary>
	private void ScheduleDoneClear()
	{
		_doneClearTimer?.Dispose();
		_cloneAllCts?.Dispose();
		_doneClearTimer = new System.Threading.Timer(
			_ => InvokeAsync(() =>
			{
				_showDone = false;
				_progressMessage = string.Empty;
				StateHasChanged();
			}),
			null,
			2500,
			Timeout.Infinite);
	}

	private string GetProgressIndicatorText()
	{
		if (!string.IsNullOrWhiteSpace(_progressMessage))
		{
			return _progressMessage;
		}

		if (_isAssessing)
