	/// <summary>
	/// The searchable, sortable repository list. Preserved from the original dashboard view, which
	/// was dead code — nothing rendered it once the navigation tree took over. The tree lists the same
	/// repositories but cannot sort or search them, so this earns its place; its old summary cards did
	/// not, being pre-multi-organisation totals that blended every organisation together.
	/// </summary>
	/// <remarks>
	/// Note that @ref="_table" only binds now this is actually rendered. While the fragment was
	/// unreachable _table stayed null, so the table refresh in RefreshTableAsync was a silent no-op.
	/// </remarks>
	private RenderFragment RenderRepositoryTable() => __builder =>
	{
		<PDTable @ref="_table"
				 TItem="RepositoryDashboardRow"
				 DataProvider="DataProvider"
				 KeyField="x => x.RepositoryFullName"
				 SearchText="@_searchText"
				 Click="OnRowClick"
				 DoubleClick="OnRowDoubleClick"
				 TableClass="governance-table">
			<PDToolbar>
				<PDToolbarTextbox Placeholder="Search packages..."
								  Value="@_searchText"
								  ValueChanged="OnSearchChanged"
								  Width="250px" />
			</PDToolbar>
			@* Repository takes all the slack so Version and Issues sit hard right. Sortable defaults to
			   true in PDColumn, so Version opts out explicitly: sorting unrelated packages by version
			   string sorts nothing meaningful. *@
			<PDColumn TItem="RepositoryDashboardRow" Field="x => x.RepositoryFullName" Title="Repository" Sortable="true" Filterable="true" ThClass="home-col-grow" TdClass="text-start home-col-grow">
				<Template>
					@* title carries the full name, since a narrow column truncates it with an ellipsis. *@
					<span class="pkg-name" title="@context.RepositoryFullName">@context.RepositoryName</span>
					@if (context.Packages.Count > 1)
					{
						@* A repository publishing several packages is the case this column used to hide
						   entirely, by showing one row per package as though each were a repository. *@
						<span class="pkg-version" title="@PackageIdList(context)">@context.Packages.Count packages</span>
					}
					@if (context.IsClonedLocally)
					{
						<span class="@(context.IsWorkingTreeClean == true ? "git-clean" : context.IsWorkingTreeClean == false ? "git-dirty" : "")"
							  title="@(context.IsWorkingTreeClean == true ? "Clean" : context.IsWorkingTreeClean == false ? "Dirty" : "")">●</span>
					}
				</Template>
			</PDColumn>
			<PDColumn TItem="RepositoryDashboardRow" Field="x => x.LatestTag" Title="Version" Sortable="false" ThClass="home-col-shrink" TdClass="home-col-shrink">
				<Template><span class="pkg-version">@PackagesSummary(context)</span></Template>
			</PDColumn>
			<PDColumn TItem="RepositoryDashboardRow" Field="x => x.TotalFailures" Id="total" Title="Issues" Sortable="true" ThClass="home-col-shrink" TdClass="home-col-shrink">
				<Template>
					@if (context.Assessment is not null)
					{
						<span class="badge @(context.TotalFailures == 0 ? "badge-pass" : context.TotalErrors > 0 ? "badge-fail" : "badge-warn")">@context.TotalFailures</span>
					}
					else if (context.Status == PackageStatus.Assessing)
					{
						<span class="spinner"></span>
					}
					else
					{
						<span class="badge-none">—</span>
					}
				</Template>
			</PDColumn>
		</PDTable>
	};

	private RenderFragment RenderPackageDetailView() => __builder =>
	{
		if (_selectedRow is null)
		{
			<div class="spa-placeholder">
				<p>Select a package from the navigation tree.</p>
			</div>
			return;
		}

		var row = _selectedRow;
		<div class="detail-issues">
			@if (row.Assessment is null)
			{
				<div class="detail-empty">
					<p>No assessment data available.</p>
					<button class="btn btn-primary" @onclick="ReassessAllAsync" disabled="@(_isAssessing || IsStepQueueBlocked(WorkflowStep.Reassess))"><i class="fas fa-sync-alt"></i> Assess Now</button>
				</div>
			}
			else if (row.TotalFailures == 0)
			{
				<div class="detail-empty detail-pass">
					<p>✅ All @row.Assessment.RuleResults.Count rules pass!</p>
						<button class="btn" @onclick="ReassessAllAsync" disabled="@(_isAssessing || IsStepQueueBlocked(WorkflowStep.Reassess))"><i class="fas fa-sync-alt"></i> Re-assess</button>
				</div>
			}
			else
			{
				<p class="fixes-intro">These are the rules this repository is currently failing. They're grouped by category and ordered by severity, so start with the most serious.</p>
				@foreach (var group in GetGroupedFailures())
				{
					<div class="issue-group">
						<div class="issue-group-header">
							<div class="issue-group-title">
								<span class="badge @GetGroupBadgeClass(group)">@group.Failures.Count</span>
								<span>@group.Category</span>
							</div>
							<div class="issue-group-actions">
								@if (HasAutoRemediableFailures(group.Category))
								{
									<button class="btn btn-sm btn-fix" @onclick="() => FixCategoryAsync(group.Category)"
												disabled="@(!IsFixEnabled())" title="@GetFixCategoryTooltip(group.Category)"><i class="fas fa-wrench"></i> Fix</button>
								}
								<button class="btn btn-sm" @onclick="() => ResolveCategoryAsync(group.Category)"
											title="Generate AI prompt for @group.Category"><i class="fas fa-magic"></i> Prompt</button>
								<button class="btn btn-sm" @onclick="() => ReassessCategoryAsync(group.Category)"
											disabled="@(_isAssessing || IsStepQueueBlocked(WorkflowStep.Reassess))" title="Re-assess this category"><i class="fas fa-sync-alt"></i></button>
							</div>
						</div>
						@foreach (var result in group.Failures)
						{
							<div class="issue-item">
								<div class="issue-item-header">
									<span class="badge @GetSeverityBadgeClass(result)">@result.RuleId</span>
									<span class="issue-rule-name">@result.RuleName</span>
									@if (Dashboard.IsAutoRemediable(result))
									{
										@if (row.IsClonedLocally)
										{
											<button class="btn btn-xs btn-fix" @onclick="() => FixSingleRuleAsync(result)"
														disabled="@(!IsFixEnabled())" title="@GetFixSingleTooltip()"><i class="fas fa-wrench"></i></button>
											}
											else
											{
														<span class="fix-hint" title="Clone the repo to enable auto-fix"><i class="fas fa-wrench"></i></span>
														}
													}
													else
													{
														<button class="btn btn-xs btn-prompt" @onclick="() => ResolveRuleAsync(result)"
																	title="Copy AI prompt for this rule"><i class="fas fa-magic"></i> AI only</button>
													}
												</div>
												<div class="issue-message">@result.Message</div>
												@if (result.Advisory is not null)
												{
													<div class="issue-advisory">
														<span class="advisory-icon"><i class="fas fa-lightbulb"></i></span>
										<span>@result.Advisory.Summary</span>
									</div>
								}
							</div>
						}
					</div>
				}
			}
		</div>
	};

	private RenderFragment RenderCategoryDetailView() => __builder =>
	{
		if (_selectedRow?.Assessment is null || _selectedCategory is null)
		{
			<div class="spa-placeholder"><p>Select a category from the tree.</p></div>
			return;
		}

		var cat = _selectedCategory.Value;
		var failures = _selectedRow.Assessment.RuleResults
			.Where(r => !r.Passed && r.Category == cat)
			.OrderBy(r => SeverityColorRank(r.Severity))
			.ThenBy(r => r.RuleId)
			.ToList();

		<div class="detail-issues">
			<div class="issue-group">
				<div class="issue-group-header">
					<div class="issue-group-title">
						<span class="badge @(failures.Count == 0 ? "badge-pass" : "badge-fail")">@failures.Count</span>
						<span>@cat</span>
					</div>
					<div class="issue-group-actions">
						@if (HasAutoRemediableFailures(cat))
						{
							<button class="btn btn-sm btn-fix" @onclick="() => FixCategoryAsync(cat)"
										disabled="@(!IsFixEnabled())" title="@GetFixCategoryTooltip(cat)"><i class="fas fa-wrench"></i> Fix</button>
						}
						<button class="btn btn-sm" @onclick="() => ReassessCategoryAsync(cat)"
									disabled="@(_isAssessing || IsStepQueueBlocked(WorkflowStep.Reassess))" title="Re-assess"><i class="fas fa-sync-alt"></i></button>
					</div>
				</div>
				@if (failures.Count == 0)
				{
					<div class="detail-empty detail-pass" style="padding: 1rem;">✅ All rules pass for @cat</div>
				}
