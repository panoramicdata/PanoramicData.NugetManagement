				<div class="summary-card">
					<div class="label">Packages</div>
					<div class="value blue">@_rows.Count</div>
				</div>
				<div class="summary-card">
					<div class="label">Passing</div>
					<div class="value green">@_rows.Count(r => r.Assessment is not null && r.TotalFailures == 0)</div>
				</div>
				<div class="summary-card">
					<div class="label">Failing</div>
					<div class="value red">@_rows.Count(r => r.Assessment is not null && r.TotalErrors > 0)</div>
				</div>
				<div class="summary-card">
					<div class="label">Warnings</div>
					<div class="value amber">@_rows.Count(r => r.Assessment is not null && r.TotalWarnings > 0 && r.TotalErrors == 0)</div>
				</div>
			</div>

			<PDTable @ref="_table"
					 TItem="PackageDashboardRow"
					 DataProvider="DataProvider"
					 KeyField="x => x.PackageId"
					 SearchText="@_searchText"
					 Click="OnRowClick"
					 DoubleClick="OnRowDoubleClick"
					 TableClass="governance-table">
				<PDToolbar>
					<PDToolbarTextbox Placeholder="Search packages..."
									  Value="@_searchText"
									  ValueChanged="OnSearchChanged"
									  Width="250px" />
				</PDToolbar>
				<PDColumn TItem="PackageDashboardRow" Field="x => x.PackageId" Title="Package" Sortable="true" Filterable="true" TdClass="text-start">
					<Template>
						<span class="pkg-name">@context.PackageId</span>
						@if (context.IsClonedLocally)
						{
							<span class="@(context.IsWorkingTreeClean == true ? "git-clean" : context.IsWorkingTreeClean == false ? "git-dirty" : "")"
								  title="@(context.IsWorkingTreeClean == true ? "Clean" : context.IsWorkingTreeClean == false ? "Dirty" : "")">●</span>
						}
					</Template>
				</PDColumn>
				<PDColumn TItem="PackageDashboardRow" Field="x => x.LatestVersion" Title="Version" Sortable="true">
					<Template><span class="pkg-version">@context.LatestVersion</span></Template>
				</PDColumn>
				<PDColumn TItem="PackageDashboardRow" Field="x => x.TotalFailures" Id="total" Title="Issues" Sortable="true">
					<Template>
						@if (context.Assessment is not null)
						{
							<span class="badge @(context.TotalFailures == 0 ? "badge-pass" : context.TotalErrors > 0 ? "badge-fail" : "badge-warn")">@context.TotalFailures</span>
						}
						else if (context.Status == PackageStatus.Assessing)
						{
							<span class="spinner"></span>
						}
						else
						{
							<span class="badge-none">—</span>
						}
