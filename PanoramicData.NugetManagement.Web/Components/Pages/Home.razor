	private void OnNavNodeActivated(TreeNode<NavItem> node)
	{
		// Organisations / Repositories / Package Updates are structural grouping nodes — not selectable.
		if (!IsSelectableNavNode(node.Data))
		{
			return;
		}

		// A repository being rediscovered may be about to be replaced, so it is dimmed and inert.
		// CSS blocks the pointer; this guards the keyboard and any programmatic activation. Issue
		// nodes stay selectable while they spin — their existing detail is still worth opening.
		if (IsNodeDimmedByRediscovery(node.Data))
		{
			return;
		}

		// Apply the visual selection ourselves so re-clicking a node whose highlight was
		// cleared in place (Dashboard deselect) re-highlights it — PDTree ignores re-clicks.
		_navTree?.RootNode.Walk(n => { n.IsSelected = false; return true; });
		node.IsSelected = true;
		OnNavSelectionChanged(node);
	}

	// Repositories is a pure grouping node and is not selectable. Organisations *is*: selecting it
	// shows the estate overview, which is the one view whose scope is every organisation. The
	// Repositories keys are namespaced per organisation, so these are prefix tests, not exact matches.
	private static bool IsSelectableNavNode(NavItem? item)
		=> item is not null
			&& !item.Key.StartsWith("repos:", StringComparison.Ordinal)
			&& !item.Key.StartsWith("repos-loading:", StringComparison.Ordinal);

	// True for an organisation's own node — the one that carries the clone and settings actions.
	private static bool IsOrgRootNode(NavItem? item)
		=> item is not null && item.Key.StartsWith("org:", StringComparison.Ordinal);

	// The organisation currently in context: whatever the selection implies, falling back to the
	// single configured organisation before anything has been selected.
	private string CurrentOrganization
		=> string.IsNullOrEmpty(_selectedOrganization) ? _organizationName : _selectedOrganization;

	// The three issue views share breadcrumb behaviour; they differ only in how deep they go.
	private bool IsIssueView
		=> _currentView is NavView.Issues or NavView.IssueCategoryDetail or NavView.IssueRuleDetail;

	/// <summary>
	/// Whether the Rediscover/Re-assess buttons apply here. Shown where the scope is unambiguous — the
	/// Organisations overview, meaning all of them, or a selected organisation, meaning that one — and
	/// hidden on Home, which has no scope of its own and where offering to reassess everything sat oddly
	/// beside a page of instructions.
	/// </summary>
	private bool ShowBulkRunButtons
		=> _currentView == NavView.Dashboard || (_currentView == NavView.Home && _orgSelected);

	/// <summary>
	/// A message awaiting the user's response, rendered as an in-app modal.
	/// </summary>
	private sealed record PendingDialog(string Message, bool IsConfirm, TaskCompletionSource<bool> Completion);

	private PendingDialog? _dialog;

	/// <summary>
	/// Asks the user to confirm, resolving to their answer.
	/// </summary>
	/// <remarks>
	/// Deliberately an in-app modal rather than the browser's <c>confirm()</c>. Native dialogs are not
	/// universally available — Claude's in-app browser suppresses them outright and returns false —
	/// and a suppressed confirm is indistinguishable from the user declining. That made every guarded
	/// action silently do nothing: "Remove organisation" appeared dead, and the API budget warnings
	/// silently cancelled the very actions they were meant to let through.
	/// </remarks>
	private Task<bool> ConfirmAsync(string message)
	{
		var completion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
		_dialog = new PendingDialog(message, IsConfirm: true, completion);
		StateHasChanged();
		return completion.Task;
	}

	/// <summary>
	/// Shows the user a message with a single acknowledgement, replacing <c>alert()</c>.
	/// </summary>
	private Task NotifyAsync(string message)
	{
		var completion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
		_dialog = new PendingDialog(message, IsConfirm: false, completion);
		StateHasChanged();
		return completion.Task;
	}

	/// <summary>
	/// Closes the dialog and hands the answer back to whoever is awaiting it.
	/// </summary>
	private void ResolveDialog(bool result)
	{
		var pending = _dialog;
		_dialog = null;
		pending?.Completion.TrySetResult(result);
	}

	/// <summary>
	/// True while an operation that spans the whole row set is running. Cloning and re-assessing must
	/// not overlap: they compete for the same GitHub budget and the same rows, and a clone completing
	/// mid-assessment flips a repository from remote to local underneath the assessment that is
	/// already reading it.
	/// </summary>
	private bool IsBulkOperationInFlight => _isLoading || _isAssessing || _isCloningAll;

	/// <summary>
	/// Whether this node should be dimmed and made inert because a rediscovery is replacing the
	/// repository list underneath it.
	/// </summary>
	/// <remarks>
	/// Only during the discovery phase — while the package list is being re-read from NuGet and shown
	/// — because that is when the nodes on screen may be about to be replaced. Once the new list is
	/// displayed the dimming lifts and the assessment phase shows a spinner per repository instead.
	/// A re-assessment never dims: the same repositories remain and their existing results stay valid
	/// and worth clicking into while the run proceeds.
	/// <para>
	/// Stable for the whole phase. An earlier version un-dimmed each repository as its own result
	/// arrived, which meant the tree changed on every completion; combined with the per-row tree
	/// rebuild it made the tree flicker and the scrollbar jitter.
	/// </para>
	/// </remarks>
	private bool IsNodeDimmedByRediscovery(NavItem? item)
	{
		if (item is null || !_isDiscovering)
		{
			return false;
		}

		// Only the repositories themselves dim — not the "Repositories" container above them, which
		// stays legible as a heading. Progress is carried by the indicator on the organisation node
		// and the counter in the breadcrumb bar.
		return item.PackageId is not null;
	}

	/// <summary>
	/// True while repositories are actually being assessed: either a re-assessment, or the assessment
	/// phase of a rediscovery (which follows its discovery phase).
	/// </summary>
	private bool IsAssessmentInFlight => _isAssessing || (_isLoading && !_isDiscovering);

	/// <summary>
	/// The icon for a tree node. Package nodes resolve theirs from live row state rather than from the
	/// NavItem, so a repository's spinner is replaced by its result the moment that result arrives.
	/// </summary>
	/// <remarks>
	/// This is why per-repository progress no longer requires rebuilding the tree. PDTree holds NavItem
	/// snapshots from when a branch loaded, so the old approach re-fetched every node on each
	/// completion — which changed the DOM structure and made the tree flicker and the scrollbar jump.
	/// Re-rendering the template only swaps this one element's class attribute, which moves nothing.
	/// </remarks>
	private string GetNodeIconCss(NavItem? item)
	{
		if (item is null)
		{
			return string.Empty;
		}

		// Issue categories and rules spin for the duration of an assessment, since their contents are
		// entirely derived from the results being recomputed.
		if (IsIssueNodeAwaitingAssessment(item))
		{
			return "fas fa-spinner fa-spin text-muted";
		}

		// Package nodes only. Category and rule nodes carry a PackageId too, so match on the key.
		if (item.PackageId is null || !item.Key.StartsWith("pkg:", StringComparison.Ordinal))
		{
			return item.IconCss;
		}

		var row = _rows.FirstOrDefault(r =>
			string.Equals(r.PackageId, item.PackageId, StringComparison.OrdinalIgnoreCase));

		return row is null
			? item.IconCss
			: NavTreeDataProvider.BuildPackageIconCss(row);
	}

	/// <summary>
	/// The scope the toolbar's run buttons act on, which follows the breadcrumb: a package when one is
	/// selected, otherwise the selected organisation, otherwise every organisation.
	/// </summary>
	private string GetReassessButtonText()
		=> _selectedRow is not null ? "Re-assess"
			: _orgSelected ? "Re-assess Org"
			: "Re-assess Orgs";

	private string GetReassessButtonTooltip()
		=> _selectedRow is not null
			? "Re-assess this package"
			: _orgSelected
				? $"Assess every {CurrentOrganization} repository again, without re-reading the package list from NuGet"
				: "Assess every known repository again, without re-reading the package list from NuGet";

	/// <summary>
	/// Whether this node is issue content whose result is currently being recomputed, and so shows a
	/// spinner in place of its usual severity glyph.
	/// </summary>
	/// <remarks>
	/// The whole issue hierarchy is derived from assessment results, so unlike repositories these do
	/// not resolve one at a time — they all spin for the run and are rebuilt together at the end.
	/// The "Issues" container node itself is excluded, so it stays legible as a heading.
	/// </remarks>
	private bool IsIssueNodeAwaitingAssessment(NavItem? item)
	{
		if (item is null || !IsAssessmentInFlight)
		{
			return false;
		}

		return item.Key.StartsWith("icat:", StringComparison.Ordinal)
			|| item.Key.StartsWith("irule:", StringComparison.Ordinal);
	}

	/// <summary>
	/// Whether an organisation node should show a spinner: either its repository list is still being
	/// discovered, or a run that affects it is in flight. Scoped to the organisation actually being
	/// worked on, so with several organisations only the relevant one spins.
	/// </summary>
	private bool ShouldSpinOrgNode(NavItem? item)
	{
		if (item is null || !IsOrgRootNode(item))
		{
			return false;
		}

		if (item.IsBusy)
		{
			return true;
		}

		if (!IsBulkOperationInFlight)
		{
			return false;
		}

		// A null busy organisation means the run covers every organisation.
		return _busyOrganization is null
			|| string.Equals(_busyOrganization, item.Organization, StringComparison.OrdinalIgnoreCase);
	}

	/// <summary>
	/// Refuses to start <paramref name="action"/> while another bulk operation is running, naming what
	/// is in the way. Returns true when the caller should abandon what it was about to do.
	/// </summary>
	private async Task<bool> BlockIfBulkOperationInFlightAsync(string action)
	{
		if (!IsBulkOperationInFlight)
		{
			return false;
		}

		var inProgress = _isCloningAll
			? "a clone"
			: _isAssessing
				? "a re-assessment"
				: "a package refresh";

		await NotifyAsync($"{action} cannot start while {inProgress} is still running. Let it finish, or stop it first.");

		return true;
	}

	/// <summary>
	/// Selects the Organisations node, which shows the estate overview.
	/// </summary>
	private async Task NavigateToOrganisationsAsync()
	{
		_selectedRow = null;
		_selectedPackageId = null;
		_selectedCategory = null;
		_selectedRuleId = null;
		_orgSelected = false;
		_selectedOrganization = string.Empty;

		await SelectNavNodeAsync(NavTreeDataProvider.OrganisationsKey, NavView.Dashboard);
	}

	// Breadcrumb hops back up the issue hierarchy, selecting the tree node so the sidebar follows.
	private async Task NavigateToIssuesAsync()
		=> await SelectNavNodeAsync(NavTreeDataProvider.IssuesKey(CurrentOrganization), NavView.Issues);

	private async Task NavigateToIssueCategoryAsync()
		=> await SelectNavNodeAsync(
			$"icat:{CurrentOrganization}:{_selectedCategory}",
			NavView.IssueCategoryDetail);

	/// <summary>
	/// Selects a node by key so the sidebar highlight follows the breadcrumb. Falls back to setting
	/// the view directly when the node is not currently realised (its branch may be collapsed).
	/// </summary>
	private async Task SelectNavNodeAsync(string key, NavView fallbackView)
	{
		var node = _navTree?.RootNode.Find(key);
		if (node is not null)
		{
			await _navTree!.SelectNode(node);
			return;
		}

		_currentView = fallbackView;
		_selectedNodeKey = key;
		if (fallbackView == NavView.Issues)
		{
			_selectedCategory = null;
			_selectedRuleId = null;
		}
		else if (fallbackView == NavView.IssueCategoryDetail)
		{
			_selectedRuleId = null;
		}

		StateHasChanged();
	}

	private void OnNavBeforeSelect(TreeBeforeSelectionChangeEventArgs<NavItem> args)
	{
		if (!IsSelectableNavNode(args.NewNode?.Data))
		{
			args.Cancel = true;
		}
	}

	// Organisations is always shown expanded (its collapse toggle is hidden in CSS), and any
	// branches the user had open before a reload are re-opened.
	private async Task OnNavTreeReady()
	{
		// Suppress saving for the whole sequence: expanding nodes here fires NodeExpanded, which
		// would otherwise persist a partial set and clobber what we're about to restore.
		_restoringExpansion = true;
		try
		{
			await LoadExpandedNodesAsync();

			var org = _navTree?.RootNode.Find("organisations");
			if (org is not null && !org.IsExpanded)
			{
				await _navTree!.ToggleNodeIsExpandedAsync(org).ConfigureAwait(true);
			}

			_expandedNodeKeys.Add("organisations");

			if (_navTree is not null)
			{
				await ExpandSavedNodesAsync(_navTree.RootNode);
			}
		}
		finally
		{
			_restoringExpansion = false;
		}

		// Land on Home, unless a package was named in the URL. PDTree selects its first node once it is
		// ready, and now that Organisations is selectable that selection takes effect — so the app
		// opened straight onto the overview and Home was never seen, which defeats the point of Home
		// pointing you at the overview in the first place.
		if (string.IsNullOrEmpty(PackageId))
		{
			_navTree?.RootNode.Walk(n => { n.IsSelected = false; return true; });
			_currentView = NavView.Home;
			_selectedNodeKey = string.Empty;
			_orgSelected = false;
			_selectedOrganization = string.Empty;
		}

		StateHasChanged();
	}

	private async Task OnNavNodeExpanded(TreeNode<NavItem> node)
	{
		if (_restoringExpansion || node.Key is null)
		{
			return;
		}

		_expandedNodeKeys.Add(node.Key);
		await SaveExpandedNodesAsync();
	}

	private async Task OnNavNodeCollapsed(TreeNode<NavItem> node)
	{
		if (_restoringExpansion || node.Key is null)
		{
			return;
		}

		_expandedNodeKeys.Remove(node.Key);
		await SaveExpandedNodesAsync();
	}

	private async Task SaveExpandedNodesAsync()
	{
		try
		{
			var state = new ExpandedNodesState(AppInstanceId, [.. _expandedNodeKeys]);
			await JS.InvokeVoidAsync(
				"localStorage.setItem",
				ExpandedNodesStorageKey,
				System.Text.Json.JsonSerializer.Serialize(state));
		}
		catch
		{
			// localStorage may not be available
		}
	}

	/// <summary>
	/// The persisted expansion set, stamped with the run of the application that saved it.
	/// </summary>
	private sealed record ExpandedNodesState(string InstanceId, string[] Keys);

	/// <summary>
	/// Loads the set of previously-expanded branch keys from localStorage.
	/// </summary>
	private async Task LoadExpandedNodesAsync()
	{
		try
		{
			var stored = await JS.InvokeAsync<string?>("localStorage.getItem", ExpandedNodesStorageKey);
			if (string.IsNullOrWhiteSpace(stored))
			{
				return;
			}

			var state = System.Text.Json.JsonSerializer.Deserialize<ExpandedNodesState>(stored);

			// A fresh start of the application opens collapsed: restoring yesterday's open branches
			// makes launching the app feel like resuming a session rather than starting one. An F5
			// within the same run does restore them, because the stamp still matches.
			if (state is null || state.InstanceId != AppInstanceId)
			{
				return;
			}

			var keys = state.Keys;
			if (keys is null)
			{
				return;
			}

			_expandedNodeKeys.Clear();
			foreach (var key in keys)
			{
				_expandedNodeKeys.Add(key);
			}
		}
		catch
		{
			// localStorage unavailable or stored value unreadable — leave the tree as-is
		}
	}

	private async Task ExpandSavedNodesAsync(TreeNode<NavItem> node)
	{
		// Expand this node first so its children are present before recursing into them.
		if (node.Key is not null && !node.Isleaf && !node.IsExpanded && _expandedNodeKeys.Contains(node.Key))
		{
			await _navTree!.ToggleNodeIsExpandedAsync(node).ConfigureAwait(true);
		}

		if (node.Nodes is null)
		{
			return;
		}

		foreach (var child in node.Nodes.ToList())
		{
			await ExpandSavedNodesAsync(child).ConfigureAwait(true);
		}
	}

	/// <summary>
	/// Names a count only once the organisation's repositories have been read from GitHub. Before
	/// that, the only number available is how many package-backed repositories are missing, which is
	/// not the ceiling: the organisation has many repositories that publish no package at all.
	/// </summary>
	private string GetCloneAllTooltip()
	{
		var root = LocalRepo.GetReposRoot();
		if (_cloneCandidates.Count == 0)
		{
			return $"Choose which of the organisation's repositories to clone into {root}";
		}

		var publicCount = _cloneCandidates.Count(c => !c.IsPrivate && !c.IsArchived);
		return $"Clone into {root} — up to {publicCount} public repositories are missing locally";
	}

	/// <summary>
	/// Opens the clone dialog, listing the organisation's repositories as GitHub reports them so
	/// visibility is known. Public, non-archived repositories missing locally start selected.
	/// </summary>
	private async Task OpenCloneDialogAsync() => await OpenCloneDialogAsync(CurrentOrganization);

	private async Task OpenCloneDialogAsync(string organization)
	{
		if (await BlockIfBulkOperationInFlightAsync("Cloning"))
		{
			return;
		}

		_cloneDialogOpen = true;
		_cloneDialogOrganization = organization;
		_isLoadingCloneCandidates = true;
		_cloneCandidatesError = null;
		_cloneCandidates = [];
		await InvokeAsync(StateHasChanged);

		try
		{
			var repositories = await CreateGitHubClient().Repository.GetAllForOrg(organization);

			// Which repositories back a package the dashboard knows about.
			var packageRepositories = _rows
				.Where(r => r.RepositoryFullName is not null)
				.Select(r => r.RepositoryFullName!)
				.ToHashSet(StringComparer.OrdinalIgnoreCase);

			_cloneCandidates = [.. repositories
				.Where(repository => !LocalRepo.IsClonedLocally(repository.Name))
				.Select(repository => new RepositoryCloneCandidate
				{
					Name = repository.Name,
					FullName = repository.FullName,
					CloneUrl = repository.CloneUrl,
					IsPrivate = repository.Private,
					IsArchived = repository.Archived,
					HasPackage = packageRepositories.Contains(repository.FullName),
					Selected = !repository.Private && !repository.Archived
				})
				.OrderBy(candidate => candidate.Name, StringComparer.OrdinalIgnoreCase)];
		}
		catch (Exception ex)
		{
			_cloneCandidatesError = ex.Message;
		}
		finally
		{
			_isLoadingCloneCandidates = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private void CloseCloneDialog() => _cloneDialogOpen = false;

	private void OpenAddOrganizationDialog()
	{
		_addOrgName = string.Empty;
		_addOrgError = null;
		_addOrgDialogOpen = true;
	}

	private void CloseAddOrganizationDialog() => _addOrgDialogOpen = false;

	// Enter submits, Escape cancels — a single-field prompt should not need the mouse.
	private async Task OnAddOrgKeyDown(KeyboardEventArgs args)
	{
		if (args.Key == "Enter" && !_isAddingOrg && !string.IsNullOrWhiteSpace(_addOrgName))
		{
			await ConfirmAddOrganizationAsync();
		}
		else if (args.Key == "Escape")
		{
			CloseAddOrganizationDialog();
		}
	}

	/// <summary>
	/// Adds the organisation, then rediscovers so its packages appear. A wrong name is the likely
	/// mistake here, and it surfaces as an organisation with no packages rather than an error, so
	/// the name is checked against GitHub before being persisted.
	/// </summary>
	private async Task ConfirmAddOrganizationAsync()
	{
		var name = _addOrgName?.Trim();
		if (string.IsNullOrEmpty(name))
		{
			_addOrgError = "Enter an organisation name.";
			return;
		}

		_isAddingOrg = true;
		_addOrgError = null;
		await InvokeAsync(StateHasChanged);

		try
		{
			// Verify it exists and we can see it, so a typo fails loudly here instead of silently
			// producing an empty branch in the tree.
			try
			{
				_ = await CreateGitHubClient().Organization.Get(name);
			}
			catch (Octokit.NotFoundException)
			{
				_addOrgError = $"GitHub has no organisation '{name}', or your token cannot see it.";
				return;
			}

			if (!RuntimeSettings.AddOrganization(name))
			{
				_addOrgError = $"'{name}' is already in the list.";
				return;
			}

			_addOrgDialogOpen = false;

			// Discover only the organisation just added. Rediscovering every organisation would
			// re-read and re-assess the ones already on screen, which is wasted GitHub budget and
			// wasted time when nothing about them has changed.
			await RediscoverOrganizationAsync(name);
		}
		catch (Exception ex)
		{
			_addOrgError = ex.Message;
			Logger.LogError(ex, "Failed to add organisation {Organization}", name);
		}
		finally
		{
			_isAddingOrg = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	/// <summary>
	/// Removes the organisation currently shown in Settings. Deliberately reached only from the
	/// bottom of the Settings screen rather than a tree button, and confirmed before acting.
	/// </summary>
	private async Task RemoveCurrentOrganizationAsync()
	{
		var organization = CurrentOrganization;
		if (string.IsNullOrEmpty(organization))
		{
			return;
		}

		var confirmed = await ConfirmAsync(
			$"Remove '{organization}' from the dashboard? Its repositories stay on GitHub and any local clones are left alone.");

		if (!confirmed)
		{
			return;
		}

		if (!RuntimeSettings.RemoveOrganization(organization))
		{
			await NotifyAsync("That is the last organisation — at least one must remain.");
			return;
		}

		_selectedOrganization = string.Empty;
		NavigateToDashboard();

		// Drop the removed organisation's rows and rebuild the tree. No GitHub calls needed:
		// the remaining organisations' cached assessments are still valid.
		_rows = [.. _rows.Where(r => !string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))];
		Cache.SetRows(_rows);
		await ReloadTreePreservingExpansionAsync();
		StateHasChanged();
	}

	private List<RepositoryCloneCandidate> VisibleCloneCandidates
		=> [.. _cloneCandidates.Where(c => !_hidePrivateRepositories || !c.IsPrivate)];

	private int SelectedCloneCount => _cloneCandidates.Count(c => c.Selected);

	private void SetAllVisibleSelected(bool selected)
	{
		foreach (var candidate in VisibleCloneCandidates)
		{
			candidate.Selected = selected;
		}
	}

	private void ToggleCloneCandidate(RepositoryCloneCandidate candidate)
		=> candidate.Selected = !candidate.Selected;

	private void CancelCloneAll()
	{
		AppendConsole("⏹️ Stopping after the current repository...");
		_cloneAllCts?.Cancel();
	}

	/// <summary>
	/// Clones the selected repositories, one at a time, reporting progress to the console.
	/// </summary>
	private async Task CloneSelectedRepositoriesAsync()
	{
		var targets = _cloneCandidates.Where(c => c.Selected).ToList();
		if (targets.Count == 0)
		{
			return;
		}

		_cloneDialogOpen = false;
		_isCloningAll = true;
		_cloningOrganization = _cloneDialogOrganization;
		_consoleVisible = true;
		_cloneAllCts?.Dispose();
		_cloneAllCts = new CancellationTokenSource();
		var token = _cloneAllCts.Token;

		var reposRoot = LocalRepo.GetReposRoot();
		var cloned = 0;
		var failed = 0;
		AppendConsole($"▶️ Cloning {targets.Count} repositories into {reposRoot}...");
		await InvokeAsync(StateHasChanged);

		try
		{
			foreach (var candidate in targets)
			{
				if (token.IsCancellationRequested)
				{
					break;
				}

				AppendConsole($"⬇️ {candidate.FullName}");
				try
				{
					var (success, output) = await LocalRepo.CloneAsync(
						candidate.CloneUrl,
						candidate.Name,
						line => AppendConsole(line),
						token);

					if (success)
					{
						cloned++;
						await AdoptClonedRepositoryAsync(candidate.FullName, candidate.Name, token);
					}
					else
					{
						failed++;
						AppendConsole($"❌ {candidate.FullName}: {output}");
					}
				}
				catch (OperationCanceledException)
				{
					break;
				}
				catch (Exception ex)
				{
					failed++;
					AppendConsole($"❌ {candidate.FullName}: {ex.Message}");
				}

				await InvokeAsync(StateHasChanged);
			}

			var stopped = token.IsCancellationRequested ? " (stopped early)" : string.Empty;
			AppendConsole($"✅ Cloned {cloned}, failed {failed}{stopped}.");
			await RefreshRateLimitAsync();
			Cache.Update(_rows);
		}
		finally
		{
			_isCloningAll = false;
			_cloningOrganization = string.Empty;
			_cloneAllCts?.Dispose();
			_cloneAllCts = null;
			await ReloadTreePreservingExpansionAsync();
			await InvokeAsync(StateHasChanged);
		}
	}

	/// <summary>
	/// Updates any dashboard rows for a freshly cloned repository so the tree shows it as local
	/// immediately. A repository can host several packages, hence every matching row.
	/// </summary>
	private async Task AdoptClonedRepositoryAsync(string repositoryFullName, string repoName, CancellationToken cancellationToken)
	{
		var rows = _rows
			.Where(r => string.Equals(r.RepositoryFullName, repositoryFullName, StringComparison.OrdinalIgnoreCase))
			.ToList();
		if (rows.Count == 0)
		{
			return;
		}

		var localPath = LocalRepo.GetLocalPath(repoName);
		var branch = await LocalRepo.GetCurrentBranchAsync(repoName, cancellationToken);
		var isClean = await LocalRepo.IsWorkingTreeCleanAsync(repoName, cancellationToken);

		foreach (var row in rows)
		{
			row.IsClonedLocally = true;
			row.LocalPath = localPath;
			row.CurrentBranch = branch;
			row.IsWorkingTreeClean = isClean;
		}
	}

	/// <summary>
	/// GitHub REST calls one repository assessment costs: one to read the repository and one for its
	/// file tree. File contents come from raw.githubusercontent.com, which is a CDN and does not draw
	/// on the API quota, and locally-cloned repositories are assessed from disk and cost nothing.
	/// </summary>
	private const int ApiCallsPerRemoteAssessment = 2;

	/// <summary>
	/// Reads the current rate limit. Asking for the limit does not itself consume quota.
	/// </summary>
	private async Task RefreshRateLimitAsync()
	{
		try
		{
			var limits = await CreateGitHubClient().RateLimit.GetRateLimits();
			_rateLimitRemaining = limits.Resources.Core.Remaining;
			_rateLimitLimit = limits.Resources.Core.Limit;
			_rateLimitResetUtc = limits.Resources.Core.Reset;
		}
		catch
		{
			// Leave it unknown rather than guess; the indicator hides itself.
			_rateLimitRemaining = null;
		}
	}

	private int EstimateRemoteAssessmentCost(IEnumerable<PackageDashboardRow> rows)
		=> rows.Count(r => r.RepositoryFullName is not null && !r.IsClonedLocally) * ApiCallsPerRemoteAssessment;

	/// <summary>
	/// Describes when the API budget resets, e.g. "in about 47 minutes, at 15:20 UTC".
	/// </summary>
	/// <remarks>
	/// Leads with the relative time because that is what answers "should I just wait?", and states the
	/// clock time explicitly as UTC. It is deliberately not converted to local time: this is Blazor
	/// Server, so a conversion would use the *server's* timezone, which is only the viewer's by
	/// coincidence when running locally — hosted in UTC, every user would see UTC labelled as local.
	/// </remarks>
	private string DescribeRateLimitReset()
	{
		if (_rateLimitResetUtc is null)
		{
			return "shortly";
		}

		var resetUtc = _rateLimitResetUtc.Value.ToUniversalTime();
		var minutes = (int)Math.Ceiling((resetUtc - DateTimeOffset.UtcNow).TotalMinutes);
		var clock = $"at {resetUtc:HH:mm} UTC";

		return minutes switch
		{
			<= 0 => $"any moment now, {clock}",
			1 => $"in about a minute, {clock}",
			_ => $"in about {minutes} minutes, {clock}"
		};
	}

	/// <summary>
	/// Warns before an action that will consume a meaningful share of the remaining GitHub API
	/// budget, so running out is a choice rather than a surprise. Stays quiet when there is plenty of
	/// headroom, and never blocks when the budget is unknown.
	/// </summary>
	private async Task<bool> ConfirmApiBudgetAsync(string action, int estimatedCalls)
	{
		if (estimatedCalls <= 0)
		{
			return true;
		}

		await RefreshRateLimitAsync();
		if (_rateLimitRemaining is null)
		{
			return true;
		}

		var remaining = _rateLimitRemaining.Value;
		if (estimatedCalls >= remaining)
		{
			return await ConfirmAsync(
				$"{action} needs about {estimatedCalls} GitHub API calls but only {remaining} remain, so it will not finish. The budget resets {DescribeRateLimitReset()}. Continue anyway?");
		}

		// Only speak up when this would eat a quarter or more of what is left.
		if (estimatedCalls * 4 < remaining)
		{
			return true;
		}

		return await ConfirmAsync(
			$"{action} will use about {estimatedCalls} of your {remaining} remaining GitHub API calls this hour. Continue?");
	}

	// The brand is a div rather than a button, so Enter and Space have to be wired up by hand for it
	// to be usable from the keyboard.
	private void OnBrandKeyDown(KeyboardEventArgs args)
	{
		if (args.Key is "Enter" or " ")
		{
			NavigateToDashboard();
		}
	}

	private void NavigateToDashboard()
	{
		_currentView = NavView.Home;
		_selectedRow = null;
		_selectedPackageId = null;
		_selectedCategory = null;
		_selectedRuleId = null;
		_selectedNodeKey = string.Empty;
		_orgSelected = false;
		_completedSteps.Clear();
		_failedSteps.Clear();
		_lastFailedWorkflowStep = null;
		// Deselect the tree in place — clear the highlight without rebuilding, so
		// expanded nodes stay open. PDTree has no public clear-selection API.
		_navTree?.RootNode.Walk(n => { n.IsSelected = false; return true; });
		StateHasChanged();
	}

	private async Task NavigateToOrgAsync() => await NavigateToOrgAsync(CurrentOrganization);

	private async Task NavigateToOrgAsync(string organization)
	{
		// Focus that organisation's node in the tree; its SelectionChange handler sets the state.
		var orgKey = NavTreeDataProvider.OrgKey(organization);
		var orgNode = _navTree?.RootNode.Find(orgKey);
		if (orgNode is not null)
		{
			await _navTree!.SelectNode(orgNode);
		}
		else
		{
			_currentView = NavView.Home;
			_selectedRow = null;
			_selectedNodeKey = orgKey;
			_selectedOrganization = organization;
			_orgSelected = true;
			StateHasChanged();
		}
	}

	private async Task NavigateToSettingsAsync() => await NavigateToSettingsAsync(CurrentOrganization);

	private async Task NavigateToSettingsAsync(string organization)
	{
		// Settings is org-level ("Org Settings"): focus the org node, then switch to the
		// Settings view so the breadcrumb reads Dashboard › Org › Settings.
		await NavigateToOrgAsync(organization);
		_selectedOrganization = organization;
		_currentView = NavView.Settings;
		_selectedCategory = null;
		_selectedRuleId = null;
		_completedSteps.Clear();
		_failedSteps.Clear();
		_lastFailedWorkflowStep = null;
		StateHasChanged();
	}

	private void NavigateToSelectedPackage()
	{
		if (_selectedRow is null)
		{
			NavigateToDashboard();
			return;
		}

		_currentView = NavView.PackageDetail;
		_selectedCategory = null;
		_selectedRuleId = null;
		StateHasChanged();
	}

	private void NavigateToAppSettings()
	{
		_currentView = NavView.AppSettings;
		_selectedRow = null;
		_selectedPackageId = null;
		_selectedCategory = null;
		_selectedRuleId = null;

		// These settings belong to no organisation, so the breadcrumb must not keep one. Arriving from
		// an organisation's own Settings page previously left it selected, giving
		// "Dashboard > panoramicsystems > Application settings" — which is precisely the impression
		// that splitting the two pages was meant to remove.
		_orgSelected = false;
		_selectedOrganization = string.Empty;
		_selectedNodeKey = NavTreeDataProvider.OrganisationsKey;

		// Move the tree highlight up to Organisations, the level these settings belong to, so the tree
		// agrees with the breadcrumb. Set directly rather than through SelectNode: that container is
		// deliberately not user-selectable, so the selection pipeline would refuse it.
		_navTree?.RootNode.Walk(n =>
		{
			n.IsSelected = n.Key == NavTreeDataProvider.OrganisationsKey;
			return true;
		});

		_userMenuOpen = false;
		StateHasChanged();
	}

	private async Task ToggleConsole()
	{
		_consoleVisible = !_consoleVisible;
		try
		{
			await JS.InvokeVoidAsync("localStorage.setItem", "consoleVisible", _consoleVisible.ToString().ToLowerInvariant());
		}
		catch
		{
			// localStorage may not be available
		}

		StateHasChanged();
	}

	private void OnTreeFilterInput(ChangeEventArgs e)
	{
		_treeFilterText = e.Value?.ToString() ?? string.Empty;
		_treeFilterError = null;

		// Debounce: wait 300ms after the user stops typing before applying the filter
		_treeFilterDebounce?.Dispose();
		_treeFilterDebounce = new System.Threading.Timer(
			_ => InvokeAsync(ApplyTreeFilter),
			null,
			300,
			Timeout.Infinite);
	}

	private async Task ApplyTreeFilter()
	{
		if (string.IsNullOrWhiteSpace(_treeFilterText))
		{
			NavDataProvider.FilterRegex = null;
			_treeFilterError = null;
		}
		else
		{
			try
			{
				NavDataProvider.FilterRegex = new System.Text.RegularExpressions.Regex(
					_treeFilterText,
					System.Text.RegularExpressions.RegexOptions.IgnoreCase,
					TimeSpan.FromMilliseconds(200));
				_treeFilterError = null;
			}
			catch (System.Text.RegularExpressions.RegexParseException)
			{
				_treeFilterError = "Invalid regex";
				return;
			}
		}

		await RefreshTreeStructureAsync();

		StateHasChanged();
	}

	private async Task ClearTreeFilter()
	{
		_treeFilterText = string.Empty;
		_treeFilterError = null;
		NavDataProvider.FilterRegex = null;

		await RefreshTreeStructureAsync();

		StateHasChanged();
	}

	private async Task OnLocalOnlyChanged(ChangeEventArgs e)
	{
		_localOnly = e.Value is true;
		NavDataProvider.LocalOnly = _localOnly;

		await RefreshTreeStructureAsync();

		StateHasChanged();
	}

	/// <summary>
	/// Reloads the tree's top-level node children so filter changes (regex / local-only) are
	/// actually applied. PDTree.RefreshAsync only refreshes the selected node's path and never
	/// reloads the organisation node's children, so on its own it does not prune filtered-out
	/// packages. RefreshNodeAsync clears and re-fetches a node's children from the data provider,
	/// which applies the current filter.
	/// </summary>
	private async Task RefreshTreeStructureAsync()
	{
		if (_navTree is null)
		{
			return;
		}

		var topNodes = _navTree.RootNode.Nodes?.ToList();
		if (topNodes is null)
		{
			return;
		}

		foreach (var node in topNodes)
		{
			await _navTree.RefreshNodeAsync(node).ConfigureAwait(true);
		}

		// Packages now sit three levels down (Organisations > org > Repositories > repo) and are
		// collapsed after a refresh. Expand that path so the (possibly filtered) repository list
		// is visible rather than hidden under collapsed ancestors. With several organisations the
		// path has to be expanded for each of them, not just one hard-coded "root".
		var pathKeys = new List<string> { NavTreeDataProvider.OrganisationsKey };
		foreach (var organization in RuntimeSettings.Organizations)
		{
			pathKeys.Add(NavTreeDataProvider.OrgKey(organization));
			pathKeys.Add(NavTreeDataProvider.ReposKey(organization));
		}

		foreach (var key in pathKeys)
		{
			var pathNode = _navTree.RootNode.Find(key);
			if (pathNode is not null && !pathNode.IsExpanded)
			{
				await _navTree.ToggleNodeIsExpandedAsync(pathNode).ConfigureAwait(true);
			}
		}
	}

	/// <summary>
	/// Rebuilds the tree's nodes from the (now-current) data provider while preserving which
	/// branches the user had expanded — used after a data load so the repo list fills in without
	/// collapsing the view. PDTree.RefreshAsync only refreshes the selected path, so it can't do this.
	/// </summary>
	private async Task ReloadTreePreservingExpansionAsync()
	{
		if (_navTree is null)
		{
			return;
		}

		// Remember which branches are open so the rebuild doesn't collapse the user's view.
		var expandedKeys = new HashSet<string>();
		_navTree.RootNode.Walk(n => { if (n.IsExpanded && n.Key is not null) { expandedKeys.Add(n.Key); } return true; });

		var topNodes = _navTree.RootNode.Nodes?.ToList();
		if (topNodes is null)
		{
			return;
		}

		foreach (var node in topNodes)
		{
			await _navTree.RefreshNodeAsync(node).ConfigureAwait(true);
		}

		// Organisations is always expanded; restore everything else that was open before.
		expandedKeys.Add("organisations");
		foreach (var key in expandedKeys)
		{
			var n = _navTree.RootNode.Find(key);
			if (n is not null && !n.IsExpanded && !(n.Data?.IsLeaf ?? true))
			{
				await _navTree.ToggleNodeIsExpandedAsync(n).ConfigureAwait(true);
			}
		}
	}

	// === Toolbar ===

	private async Task OnToolbarClick(KeyedEventArgs<MouseEventArgs> args)
	{
		switch (args.Key)
		{
			case "refresh":
				// Scope follows the breadcrumb: the selected organisation, or all of them.
				if (_orgSelected)
				{
					await RediscoverOrganizationAsync(CurrentOrganization);
				}
				else
				{
					await RefreshAsync();
				}

				break;
			case "check-for-updates":
				await NuGetUpdates.CheckForUpdatesAsync(StateHasChanged);
				break;
			case "fix":
				await FixAllAsync();
				break;
			case "fix-with-ai":
				await FixWithAiAsync();
				break;
			case "open-ide":
				OpenInIde();
				break;
			case "copy-ai-prompt":
				await CopyPromptToClipboardAsync();
				break;
			case "reassess":
						// Same scoping as the label: package, then organisation, then everything.
						if (_selectedRow is not null)
						{
							await ReassessAllAsync();
						}
						else if (_orgSelected)
						{
							await ReassessOrganizationAsync(CurrentOrganization);
						}
						else
						{
							await ReassessAllReposAsync();
						}

						break;
				case "build":
				await BuildAsync();
				break;
			case "test":
				await RunTestsAsync();
				break;
			case "git-sync":
					await GitSyncAsync();
					break;
			case "commit-and-push":
				await CommitAndPushAsync();
				break;
			case "publish":
				await RunPublishAsync();
				break;
		}
	}

	// === Home overview ===

	/// <summary>
	/// One organisation's headline counts for the overview table.
	/// </summary>
	private sealed record OrgOverview(
		string Organization,
		int Repos,
		int Cloned,
		int ClonedClean,
		int Assessed,
		int Clean,
		int Warnings,
		int Errors,
		int NoRepo,
		int Unassessed);

	private List<OrgOverview> BuildOrgOverviews()
	{
		var organizations = RuntimeSettings.Organizations;
		var fallback = organizations.Count > 0 ? organizations[0] : _organizationName;

		var result = new List<OrgOverview>();
		foreach (var organization in organizations)
		{
			// Same attribution as the navigation tree: rows cached before multi-organisation support
			// carry no organisation and belong to the first one.
			var rows = _rows
				.Where(r => string.IsNullOrEmpty(r.Organization)
					? string.Equals(organization, fallback, StringComparison.OrdinalIgnoreCase)
					: string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))
				.ToList();

			result.Add(new OrgOverview(
				Organization: organization,
				Repos: rows.Count,
				Cloned: rows.Count(r => r.IsClonedLocally),
				ClonedClean: rows.Count(r => r.IsClonedLocally && r.HealthStatus == PackageHealthStatus.Success),
				Assessed: rows.Count(r => r.Assessment is not null),
				Clean: rows.Count(r => r.HealthStatus == PackageHealthStatus.Success),
				Warnings: rows.Count(r => r.HealthStatus == PackageHealthStatus.Warning),
				Errors: rows.Count(r => r.HealthStatus == PackageHealthStatus.Error),

				// Two distinct reasons for having no assessment, previously conflated under one
				// "not assessed" heading which implied we had simply skipped them:
				//   - no repository at all in the package's NuGet metadata, so there is nothing to
				//     identify and assessment is never attempted;
				//   - a repository is known but the assessment has not run, or errored.
				NoRepo: rows.Count(r => r.RepositoryFullName is null),
				Unassessed: rows.Count(r => r.RepositoryFullName is not null && r.Assessment is null)));
		}

		return result;
	}

	// The issue-centric view is rebuilt from every rule result, so it is memoised against the data it
	// was built from rather than recomputed on each render — the home view re-renders on every progress
	// tick during a run.
	private List<IssueClassGroup>? _topIssueClasses;
	private (int Rows, DateTimeOffset Refreshed) _topIssueClassesBuiltFrom;

	private List<IssueClassGroup> TopIssueClasses(int take)
	{
		var stamp = (_rows.Count, Cache.LastRefreshUtc);
		if (_topIssueClasses is not null && _topIssueClassesBuiltFrom == stamp)
		{
			return _topIssueClasses;
		}

		_topIssueClasses =
		[
			.. Dashboard.BuildIssueCentricView(_rows).AllIssueClasses
				.OrderByDescending(i => i.AffectedRepositoryCount)
				.ThenBy(i => i.RuleId, StringComparer.OrdinalIgnoreCase)
				.Take(take)
		];

		_topIssueClassesBuiltFrom = stamp;
		return _topIssueClasses;
	}

	/// <summary>
	/// Opens one of the overview's biggest issue classes in the sidebar's issue hierarchy.
	/// </summary>
	private async Task NavigateToTopIssueAsync(IssueClassGroup issueClass)
	{
		// An issue class can span organisations, so take the organisation of the first affected
		// repository rather than assuming the currently selected one.
		var firstRepository = issueClass.Instances.FirstOrDefault()?.RepositoryFullName;
		var organization = _rows
			.FirstOrDefault(r => string.Equals(r.RepositoryFullName, firstRepository, StringComparison.OrdinalIgnoreCase))
			?.Organization;

		if (string.IsNullOrEmpty(organization))
		{
			organization = CurrentOrganization;
		}

		_selectedOrganization = organization;
		_selectedCategory = issueClass.Category;
		_selectedRuleId = issueClass.RuleId;
		_orgSelected = false;

		await SelectNavNodeAsync(
			$"irule:{organization}:{issueClass.Category}:{issueClass.RuleId}",
			NavView.IssueRuleDetail);
	}

	// === Render Fragments ===

	/// <summary>
	/// The estate overview, shown when Organisations is selected — the one node whose scope is every
	/// organisation. Leads with locally-cloned repositories because that is the definition of done: only
	/// a local clone can be auto-fixed, built, tested or published, so the all-repositories figure is
	/// shown alongside as context rather than as the target.
	/// </summary>
	private RenderFragment RenderDashboardView() => __builder =>
	{
		var overviews = BuildOrgOverviews();
		var totalRepos = overviews.Sum(o => o.Repos);
		var cloned = overviews.Sum(o => o.Cloned);
		var clonedClean = overviews.Sum(o => o.ClonedClean);
		var clean = overviews.Sum(o => o.Clean);
		var assessed = overviews.Sum(o => o.Assessed);
		var clonedPercent = cloned == 0 ? 0 : (int)Math.Round(clonedClean * 100.0 / cloned);
		var topIssues = TopIssueClasses(6);

		<div class="home-view">
			<h2 class="home-title">Organisations</h2>

			@if (totalRepos == 0)
			{
				<p class="home-empty">
					No packages discovered yet. Use <em>Rediscover Orgs</em>, or add an organisation with the
					<i class="fas fa-plus"></i> beside <em>Organisations</em>.
				</p>
			}
			else
			{
				<section class="home-section">
					<h3 class="home-section-title">Progress</h3>
					<div class="home-progress-heading">
						<strong>@clonedClean of @cloned</strong> locally-cloned repositories are clean
						<span class="home-progress-percent">@clonedPercent%</span>
					</div>
					<div class="home-progress-track">
						<div class="home-progress-fill" style="width: @clonedPercent%"></div>
					</div>
					<p class="home-progress-note">
						Only cloned repositories can be fixed, built, tested or published, so this is the number
						that matters. Across everything: <strong>@clean of @totalRepos</strong> clean,
						@assessed assessed.
					</p>
				</section>

				<section class="home-section">
					<h3 class="home-section-title">By organisation</h3>
					<table class="home-table">
						<thead>
							<tr>
								<th>Organisation</th>
								<th class="home-num">Repos</th>
								<th class="home-num">Cloned</th>
								<th class="home-num">Clean</th>
								<th class="home-num">Warnings</th>
								<th class="home-num">Errors</th>
								<th class="home-num" title="The package's NuGet metadata has no GitHub project URL, so there is no repository to identify or assess.">No repo</th>
								<th class="home-num" title="A repository is known, but it has not been assessed yet — or the assessment errored.">Not assessed</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var o in overviews)
							{
								<tr>
									<td>
										<a href="#" class="home-link" @onclick="() => NavigateToOrgAsync(o.Organization)" @onclick:preventDefault>@o.Organization</a>
									</td>
									<td class="home-num">@o.Repos</td>
									<td class="home-num">@o.Cloned</td>
									<td class="home-num @(o.Clean > 0 ? "text-success" : null)">@o.Clean</td>
									<td class="home-num @(o.Warnings > 0 ? "text-warning" : null)">@o.Warnings</td>
									<td class="home-num @(o.Errors > 0 ? "text-danger" : null)">@o.Errors</td>
									<td class="home-num">@o.NoRepo</td>
									<td class="home-num @(o.Unassessed > 0 ? "text-warning" : null)">@o.Unassessed</td>
								</tr>
							}
						</tbody>
					</table>
				</section>

				@if (topIssues.Count > 0)
				{
					<section class="home-section">
						<h3 class="home-section-title">Biggest issue classes</h3>
						<p class="home-section-note">
							The rules affecting the most repositories — fixing one of these moves the most at once.
						</p>
						<ul class="home-issue-list">
							@foreach (var issueClass in topIssues)
							{
								<li>
									<a href="#" class="home-link" @onclick="() => NavigateToTopIssueAsync(issueClass)" @onclick:preventDefault>
										<span class="home-issue-id">@issueClass.RuleId</span>
										<span class="home-issue-name">@issueClass.RuleName</span>
									</a>
									<span class="home-issue-count">@issueClass.AffectedRepositoryCount repos</span>
								</li>
							}
						</ul>
					</section>
				}

				@* The tree lists these same repositories but cannot sort or search them, which is what this
				   adds. Full width, since a table needs more room than the prose above it. *@
				<section class="home-section home-section-wide">
					<h3 class="home-section-title">All repositories</h3>
					@RenderRepositoryTable()
				</section>
			}
		</div>
	};

	/// <summary>
	/// Home: what you can do here. Deliberately guidance rather than figures — the aggregate view is
	/// the Organisations node's, reached by selecting it.
	/// </summary>
	private RenderFragment RenderGettingStarted() => __builder =>
	{
		<div class="spa-placeholder">
			<i class="fas fa-hand-point-left fa-2x"></i>
			<p>Select an item from the navigation tree</p>

			@* Without this the overview is effectively hidden: selecting a container node is not an
			   obvious thing to try, and nothing else hints that Organisations has a view of its own. *@
			<p class="getting-started-lead">
				Start with
				<a href="#" class="home-link" @onclick="NavigateToOrganisationsAsync" @onclick:preventDefault>Organisations</a>
				— it shows how the whole estate is doing: progress toward every locally-cloned repository
				being clean, a breakdown per organisation, and the rules affecting the most repositories.
			</p>

			<ol class="getting-started">
				<li>
					<strong>Add an organisation</strong> with the <i class="fas fa-plus"></i> beside
					<em>Organisations</em>, as needed. Its packages are discovered from NuGet and each
					repository assessed.
				</li>
				<li>
					@* Bold lead-in phrase, then the UI term in accent — matching the other steps. It was
					   nested inside the strong, making it the only bold-and-blue term of the four. *@
					<strong>Pick a repository</strong> from <em>Repositories</em> under an organisation.
					Its icon shows how it fares: green is clean, amber has warnings, red has errors.
				</li>
				<li>
					<strong>Work along the toolbar</strong> left to right — Sync, Re-assess, Fix, Build,
					Test, Commit &amp; Push, Publish.
				</li>
				<li>
					<strong>Or fix one problem everywhere at once.</strong> <em>Issues</em> groups the
					same failures by rule instead of by repository, so a single action can apply a fix
					across every repository it affects.
				</li>
			</ol>

			<p class="getting-started-note">
				Auto-fix, build, test and publish need the repository cloned locally — use the
				<i class="fas fa-cloud-arrow-down"></i> on an organisation to clone. Repositories that
				are not cloned can only be assessed.
			</p>
		</div>
	};

	private RenderFragment RenderCurrentView() => __builder =>
	{
		switch (_currentView)
		{
			case NavView.Home:
			case NavView.None:
				@RenderGettingStarted()
				break;
			case NavView.Dashboard:
				@* Selecting Organisations shows the estate overview, since that node's scope is all of
				   them. Home keeps the guidance it always had. *@
				@RenderDashboardView()
				break;
			case NavView.PackageDetail:
				@RenderPackageDetailView()
				break;
			case NavView.CategoryDetail:
				@RenderCategoryDetailView()
				break;
			case NavView.RuleDetail:
				@RenderRuleDetailView()
				break;
			case NavView.Settings:
				@RenderSettingsView()
				break;
			case NavView.AppSettings:
				@RenderAppSettingsView()
				break;
			case NavView.NuGetUpdates:
				@RenderNuGetUpdatesView()
				break;
			case NavView.Issues:
				@* Embedded so it drops its own page header. Organization is required: without it the
				   component shows nothing rather than every organisation's repositories. *@
				<IssuesView Embedded="true" Organization="@CurrentOrganization" />
				break;
			case NavView.IssueCategoryDetail:
				@* The hierarchy itself now lives in the sidebar; this panel shows the selected
				   category's rules with their affected repositories and bulk actions. *@
				<IssuesView Embedded="true" Organization="@CurrentOrganization" FocusCategory="_selectedCategory" />
				break;
			case NavView.IssueRuleDetail:
				<IssuesView Embedded="true" Organization="@CurrentOrganization" FocusCategory="_selectedCategory" FocusRuleId="@_selectedRuleId" />
				break;
			default:
				@RenderGettingStarted()
				break;
		}
	};

	private RenderFragment RenderConsolePanel() => __builder =>
	{
		<div class="console-panel-header">
			<span><i class="fas fa-terminal"></i> Console</span>
			<div class="console-panel-actions">
				@if (CurrentConsoleLines.Count > 0)
				{
					<button class="btn btn-sm btn-copy @(CurrentConsoleCopyFeedback ? "btn-copied" : "")" @onclick="CopyConsoleToClipboardAsync" title="Copy console output to clipboard">
						@if (CurrentConsoleCopyFeedback)
						{
							<i class="fas fa-check"></i> <span>Copied!</span>
						}
						else
						{
							<i class="fas fa-copy"></i> <span>Copy</span>
						}
					</button>
				}
				@if (!string.IsNullOrEmpty(CurrentLastPromptText))
				{
					<button class="btn btn-sm btn-copy @(CurrentCopyFeedback ? "btn-copied" : "")" @onclick="CopyPromptToClipboardAsync" title="Copy AI prompt to clipboard">
							@if (CurrentCopyFeedback)
							{
								<i class="fas fa-check"></i> <span>Copied!</span>
							}
							else
							{
								<i class="fas fa-copy"></i> <span>Copy Prompt</span>
