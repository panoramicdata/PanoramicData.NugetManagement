		}
	}

	private async Task AppendDirtyWorkingTreePreviewAsync()
	{
		if (_selectedRow is null || _selectedRow.IsWorkingTreeClean != false)
		{
			return;
		}

		var lines = await Dashboard.GetWorkingTreeStatusPreviewAsync(_selectedRow, maxLines: 3);
		if (lines.Count == 0)
		{
			AppendConsole("ℹ️ Working tree is dirty but no git porcelain entries were captured.");
			return;
		}

		AppendConsole("ℹ️ Dirty files (git status --porcelain):");
		foreach (var line in lines)
		{
			AppendConsole($"  {line}");
		}
	}

	private async Task RunPublishAsync()
	{
		if (_selectedRow is null)
		{
			return;
		}

		EnsureSelectedRowIsCurrent();

		_isRunning = true;
		ClearConsole();
		AppendConsole("▶ Publishing...");
		StateHasChanged();

		try
		{
			await Dashboard.RunPublishAsync(_selectedRow, line =>
			{
				AppendConsole(line);
				InvokeAsync(StateHasChanged);
			});

			AppendConsole(_selectedRow.Status == PackageStatus.Published ? "✅ Published" : "❌ Publish failed");
		}
		catch (Exception ex)
		{
			AppendConsole($"❌ Error: {ex.Message}");
		}
		finally
		{
			_isRunning = false;
			StateHasChanged();
		}
	}

