		_selectedPackageId = null;
		_selectedCategory = null;
		_selectedRuleId = null;
		_selectedNodeKey = string.Empty;
		_orgSelected = false;
		_completedSteps.Clear();
		_failedSteps.Clear();
		_lastFailedWorkflowStep = null;
		// Deselect the tree in place — clear the highlight without rebuilding, so
		// expanded nodes stay open. PDTree has no public clear-selection API.
		_navTree?.RootNode.Walk(n => { n.IsSelected = false; return true; });
		StateHasChanged();
