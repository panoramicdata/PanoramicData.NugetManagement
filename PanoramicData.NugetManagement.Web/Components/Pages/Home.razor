	/// <summary>
	/// Re-assesses the selected repository. Queued like every other toolbar step, so that it takes its
	/// turn behind whatever is already in flight and closes the steps downstream of it while it waits.
	/// </summary>
	private Task ReassessAllAsync()
	{
		if (_selectedRow is null)
		{
			return Task.CompletedTask;
		}

		EnsureSelectedRowIsCurrent();

		var capturedRow = _selectedRow;
		EnqueueWork(
			$"Re-assess {_selectedRow.RepositoryName}",
			_selectedRow.Organization,
			$"reassess:{_selectedRow.RepositoryFullName}",
			(_, cancellationToken) => ReassessAllCoreAsync(capturedRow, cancellationToken),
			WorkflowStep.Reassess,
			_selectedRow.RepositoryFullName);

		return Task.CompletedTask;
	}

	private async Task ReassessAllCoreAsync(RepositoryDashboardRow row, CancellationToken cancellationToken)
	{
		_isAssessing = true;
		_progressMessage = $"Checking NuGet listing for {row.RepositoryFullName}...";
		StateHasChanged();

		try
		{
			cancellationToken.ThrowIfCancellationRequested();

			// A repository leaves the estate only when every package it publishes has been retired.
			// Dropping it because one of four was unlisted would take the other three with it.
			var listed = new List<string>();
			foreach (var package in row.Packages)
			{
				if (await Dashboard.IsPackageListedAsync(package.PackageId))
				{
					listed.Add(package.PackageId);
				}
			}

			if (listed.Count == 0)
			{
				AppendConsole($"⚠️ {row.RepositoryFullName} publishes nothing still listed on NuGet — removing from cache.");
				_rows.RemoveAll(r => string.Equals(r.RepositoryFullName, row.RepositoryFullName, StringComparison.OrdinalIgnoreCase));
				Cache.RemoveRow(row.RepositoryFullName);

				// Only clear the selection if it is this row: the user may have moved on while this
				// waited its turn in the queue.
				if (ReferenceEquals(_selectedRow, row))
				{
					_selectedRow = null;
					_selectedPackageId = null;
					_currentView = NavView.Home;
				}

				await RefreshTableAsync();
				return;
			}

			if (listed.Count < row.Packages.Count)
			{
				var retired = row.Packages
					.Select(package => package.PackageId)
					.Except(listed, StringComparer.OrdinalIgnoreCase);

				AppendConsole($"ℹ️ {row.RepositoryFullName}: {string.Join(", ", retired)} no longer listed on NuGet.");
			}

			cancellationToken.ThrowIfCancellationRequested();
			_progressMessage = $"Assessing {row.RepositoryFullName}...";
			StateHasChanged();

			// Hoisted out of the else: the local path wants a client too, to read the repository's
			// inbox. Constructing one is local and free, so both branches can simply have one.
			var github = CreateGitHubClient();

			if (row.IsClonedLocally && row.LocalPath is not null)
			{
				await Dashboard.AssessLocalRepositoryAsync(row, cancellationToken, github);
				await Dashboard.RefreshGitStatusAsync(row, cancellationToken);
				await AppendDirtyWorkingTreePreviewAsync();
			}
			else
			{
				await Dashboard.AssessRepositoryAsync(row, github);
			}

			await PersistRowUpdateAsync(row);
			AppendConsole($"✅ Assessment complete for {row.RepositoryFullName}");
		}
		catch (OperationCanceledException)
		{
			// The pump says so, and says it the same way for every step.
			throw;
		}
		catch (Exception ex)
		{
			AppendConsole($"❌ Assessment failed: {ex.Message}");
		}
		finally
		{
			_isAssessing = false;
			_progressMessage = string.Empty;
			StateHasChanged();
		}
	}

	private async Task ReassessAllReposAsync() => await ReassessOrganizationAsync(null);

	/// <summary>
	/// Re-reads one organisation's package list from NuGet and assesses it, leaving every other
	/// organisation's rows untouched. This is the org-node counterpart of the dashboard's
	/// "Rediscover Orgs", which does the same for all of them.
	/// </summary>
	private async Task RediscoverOrganizationAsync(string organization)
	{
		var existingForOrg = _rows
			.Where(r => string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))
			.ToList();

		if (!await ConfirmApiBudgetAsync(
			$"Rediscovering and assessing {organization}",
			EstimateRemoteAssessmentCost(existingForOrg)))
		{
			return;
		}

		EnqueueWork(
			$"Rediscover {organization}",
			organization,
			$"rediscover:{organization}",
			(progress, cancellationToken) => RediscoverOrganizationCoreAsync(organization, existingForOrg, progress, cancellationToken));
	}

	private async Task RediscoverOrganizationCoreAsync(
		string organization,
		List<RepositoryDashboardRow> existingForOrg,
		IProgress<string> progress,
		CancellationToken cancellationToken)
	{
		_isLoading = true;
		_isDiscovering = true;
		_busyOrganization = organization;
		_progressMessage = $"Discovering {organization} packages...";
		StateHasChanged();

		try
		{
			var freshRows = await Dashboard.DiscoverPackagesAsync(organization, cancellationToken);

			ReportUnreadNuspecs();

			// Carry over assessments we already have, so rediscovery does not throw away results for
			// packages that have not changed.
			var existingByPackageId = existingForOrg
				.Where(r => r.Assessment is not null)
				.ToDictionary(r => r.RepositoryFullName, StringComparer.OrdinalIgnoreCase);

			foreach (var row in freshRows)
			{
				if (existingByPackageId.TryGetValue(row.RepositoryFullName, out var existing))
				{
					row.Assessment = existing.Assessment;
					row.CategorySummaries = existing.CategorySummaries;
				}
			}

			// Swap in this organisation's rows only; the others are left exactly as they were.
			_rows =
			[
				.. _rows.Where(r => !string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase)),
				.. freshRows
			];

			Cache.SetRows(_rows);

			var github = CreateGitHubClient();
			var assessable = freshRows.Where(r => r.IsGoverned && r.RepositoryFullName is not null).ToList();

			// Mark them pending before the tree is rebuilt, so the new list appears already showing a
			// spinner per repository.
			foreach (var row in assessable)
			{
				row.IsReassessing = true;
			}

			// Discovery is done: the new list is displayed and the per-repository spinners take over for
			// the assessment phase. This is the one tree rebuild in the middle of the run; the tree then
			// stays still until it finishes.
			//
			// The rebuild happens while still dimmed, and the dim is lifted afterwards — see the note in
			// RefreshAsync: clearing the flag first would rebuild the nodes already undimmed, leaving
			// nothing for the fade to animate from.
			_progressMessage = $"Assessing {organization}...";
			await RefreshTableAsync();

			_isDiscovering = false;
			StateHasChanged();

			AppendConsole($"▶ Rediscovering {organization}: {assessable.Count} repositories...");

			await AssessInParallelAsync(assessable, async row =>
			{
				if (row.IsClonedLocally && row.LocalPath is not null)
				{
					await Dashboard.AssessLocalRepositoryAsync(row, cancellationToken, github);
					await Dashboard.RefreshGitStatusAsync(row, cancellationToken);
				}
				else
				{
					await Dashboard.AssessRepositoryAsync(row, github, cancellationToken);
				}
			}, progress, cancellationToken);

			Cache.Update(_rows);
			_lastRefreshUtc = Cache.LastRefreshUtc;
			AppendConsole($"✅ Rediscovered {organization}: {assessable.Count} repositories.");
			_progressMessage += " Done";
			_showDone = true;
			ScheduleDoneClear();
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Failed to rediscover {Organization}", organization);
			AppendConsole($"❌ Rediscover failed: {ex.Message}");
			_progressMessage = $"Error: {ex.Message}";
		}
		finally
		{
			foreach (var row in _rows)
			{
				row.IsReassessing = false;
			}

			_isLoading = false;
			_isDiscovering = false;
			_busyOrganization = null;
			await ReloadTreePreservingExpansionAsync();
			StateHasChanged();
		}
	}

	/// <summary>
	/// Re-assesses every repository, or only one organisation's when <paramref name="organization"/>
	/// is supplied. Scoping matters because assessing every organisation multiplies the GitHub API
	/// cost for no benefit when only one of them is being worked on.
	/// </summary>
	private async Task ReassessOrganizationAsync(string? organization)
	{
		var assessable = _rows
			.Where(r => r.IsGoverned)
			.Where(r => r.RepositoryFullName is not null)
			.Where(r => !RuntimeSettings.IsRepositoryExcluded(r.RepositoryFullName))
			.Where(r => organization is null
				|| string.Equals(r.Organization, organization, StringComparison.OrdinalIgnoreCase))
			.ToList();

		if (assessable.Count == 0)
		{
			AppendConsole("Nothing to re-assess.");
			return;
		}

		var scope = organization is null ? "repositories" : $"{organization} repositories";
		if (!await ConfirmApiBudgetAsync($"Re-assessing {assessable.Count} {scope}", EstimateRemoteAssessmentCost(assessable)))
		{
			return;
		}

		// Confirmation happens on the click; the run itself goes on the queue, because a dialog
		// appearing when the item finally starts would block the queue on an answer nobody is
		// waiting to give.
		EnqueueWork(
			$"Re-assess {organization ?? "every organisation"} — {assessable.Count} repos",
			organization,
			$"reassess:{organization ?? "*"}",
			(progress, cancellationToken) => ReassessOrganizationCoreAsync(organization, assessable, scope, progress, cancellationToken));
	}

	private async Task ReassessOrganizationCoreAsync(
		string? organization,
		List<RepositoryDashboardRow> assessable,
		string scope,
		IProgress<string> progress,
		CancellationToken cancellationToken)
	{
		_isAssessing = true;
		_busyOrganization = organization;
		AppendConsole($"▶ Re-assessing {assessable.Count} {scope}...");

		// Mark all pending rows so the tree shows spinners
		foreach (var r in assessable)
		{
			r.IsReassessing = true;
		}

		await RefreshTableAsync();

		try
		{
			var github = CreateGitHubClient();

			await AssessInParallelAsync(assessable, async row =>
			{
				if (row.IsClonedLocally && row.LocalPath is not null)
				{
					await Dashboard.AssessLocalRepositoryAsync(row, cancellationToken, github);
					await Dashboard.RefreshGitStatusAsync(row, cancellationToken);
				}
				else
				{
					await Dashboard.AssessRepositoryAsync(row, github, cancellationToken);
				}
			}, progress, cancellationToken);

			Cache.Update(_rows);
			_lastRefreshUtc = Cache.LastRefreshUtc;
			AppendConsole($"✅ Re-assessed {assessable.Count} repos.");
		}
		catch (OperationCanceledException)
		{
			// Whatever was assessed before the stop stands: the rows are simply as fresh as they got.
			Cache.Update(_rows);
			_lastRefreshUtc = Cache.LastRefreshUtc;
			throw;
		}
		catch (Exception ex)
		{
			AppendConsole($"❌ Re-assess all failed: {ex.Message}");
		}
		finally
		{
			// Ensure all rows are cleared in case of early exit
			foreach (var r in assessable)
			{
				r.IsReassessing = false;
			}

			_isAssessing = false;
			_busyOrganization = null;
			_progressMessage = string.Empty;

			// The tree is left untouched during the run so it cannot flicker; rebuild it once here so
			// the new results, icons and issue hierarchy appear.
			await ReloadTreePreservingExpansionAsync();
			StateHasChanged();
		}
	}

