										title="@($"Delete {stray.Path} and everything in it")">
									<i class="fas fa-trash"></i>&nbsp;Delete
								</button>
							</div>
							<span class="settings-hint">
								@stray.Owner — @string.Join(", ", stray.RepositoryNames)
							</span>
						</div>
					}
				</div>
			}
		</div>
	};

	/// <summary>
	/// Clone folders in the clone root that belong to no organisation under management.
	/// </summary>
	/// <remarks>
	/// Read on render rather than held in a field: the list changes when a clone is deleted, when the
	/// clone root is changed, and when an organisation is added or removed, and a field would have to
	/// be invalidated by each of those. Scanning one directory is cheap enough not to bother.
	/// </remarks>
	private IReadOnlyList<StrayClone> StrayClones
		=> StrayCloneScanner.FindStrayClones(LocalRepo.GetReposRoot(), RuntimeSettings.Organizations);

	/// <summary>
	/// Deletes a stray clone folder, once the user has confirmed it.
	/// </summary>
	private async Task DeleteStrayCloneAsync(StrayClone stray)
	{
		var confirmed = await ConfirmAsync(
			$"Delete {stray.Path} and everything in it? It holds {stray.RepositoryNames.Count} checkout(s) of repositories belonging to {stray.Owner}, and any uncommitted work in them goes too.");

		if (!confirmed)
		{
			return;
		}

		try
		{
			// Git marks objects read-only, and Directory.Delete refuses those, so the attributes are
			// cleared first. Without this, deleting any clone fails on its .git folder alone.
			ClearReadOnlyAttributes(stray.Path);
			Directory.Delete(stray.Path, recursive: true);
			AppendConsole($"Deleted stray clone folder {stray.Path}");
		}
		catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
		{
			AppendConsole($"Could not delete {stray.Path}: {ex.Message}");
			await NotifyAsync($"Could not delete {stray.Path}. {ex.Message}");
		}

		StateHasChanged();
	}

	/// <summary>
	/// Clears the read-only attribute from a directory and everything beneath it.
	/// </summary>
	private static void ClearReadOnlyAttributes(string path)
	{
		foreach (var file in Directory.EnumerateFiles(path, "*", SearchOption.AllDirectories))
		{
			var attributes = File.GetAttributes(file);
			if (attributes.HasFlag(FileAttributes.ReadOnly))
			{
				File.SetAttributes(file, attributes & ~FileAttributes.ReadOnly);
			}
		}
	}

